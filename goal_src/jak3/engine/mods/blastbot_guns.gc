;;-*-Lisp-*-
(in-package goal)

;; name: blastbot_guns.gc
;; name in dgo: blastbot_guns
;; dgos: GAME

;; The Blast Bot's weapons, split out of mod-common-functions.gc. Everything about firing lives here:
;;   - the heat meter shared by every weapon (blast-bot-heat-*)
;;   - the red / yellow / blue arsenals and the D-pad selection (blast-bot-gun-select)
;;   - the actor scanner used to find type names (blast-bot-scan-on, blast-bot-scan-from)
;;   - blast-bot-fire-input: R1 handling, called every frame by the bot's active state
;;
;; Needs the blast-bot-player type, *blast-bot-use-morphgun* and *blast-bot-credit-shots* from mod-common-functions.gc, so it
;; must come AFTER mod-common-functions in game.gp / game.gd. mod-common-functions.gc reaches the functions below through
;; define-extern forward declarations, so it does not need this file to be compiled first.

(defun blast-bot-fire-morphgun ((this blast-bot-player))
  ;; Spawns Jak's red morphgun shot (gun-red-1, see gun-fire-red-1 in gun-red-shot.gc) straight from the bot's muzzle.
  ;; Jak's gun is not involved (it cannot be initialised while he is in grab-ride). The shot ignores its parent
  ;; process (the bot). Who it names as attacker is decided by blast-bot-morphgun-attacker below.
  (let* ((muzzle-matrix (matrix-copy! (new 'stack-no-clear 'matrix)
                                     (-> this node-list data 6 bone transform)))
         (start (matrix->trans muzzle-matrix (new 'stack-no-clear 'vector)))
         (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> muzzle-matrix fvec) 1.0))
         )
    (vector+*! start start dir 8192.0)
    ;; the muzzle burst gun-fire-red-1 launches (part 216); its rotate-y is set to the facing first
    (let ((spec (get-field-spec-by-id (-> *part-id-table* 216) (sp-field-id spt-rotate-y))))
      (if spec
          (set! (-> spec initial-valuef) (quaternion-y-angle (-> this root quat)))
          )
      )
    (launch-particles (-> *part-id-table* 216) start)
    (process-spawn gun-red-shot start dir :name "gun-red-shot" :to this)
    )
  (none)
  )

;; ---- Morphgun shots fired by the bot ----
;; gun-red-shot hardcodes Jak as the attacker. Peaceful wasteland citizens turn on whoever hit them, so they went
;; after Jak (parked in grab-ride, not a usable target) and never fired at the bot. For shots the bot fired, name
;; the bot as the attacker instead. Set *blast-bot-morphgun-credit-jak* to #t to get Jak back (kill counters count,
;; NPCs stop shooting). This replaces the method for every gun-red-shot; shots from Jak's real gun are unchanged.
(define *blast-bot-morphgun-credit-jak* #f)

(defun blast-bot-morphgun-attacker ((shot gun-red-shot))
  (let ((bot (as-type (ppointer->process (-> shot parent)) blast-bot-player)))
    (if (and bot (not *blast-bot-morphgun-credit-jak*))
        (process->handle bot)
        (process->handle *target*)
        )
    )
  )

(defmethod send-attack! ((this gun-red-shot) (arg0 process-drawable) (arg1 touching-shapes-entry))
  (let ((v1-0 (as-type arg0 process-drawable)))
    (when v1-0
      (let* ((s5-2 (vector-! (new 'stack-no-clear 'vector) (-> v1-0 root trans) (-> this start-pos)))
             (f30-0 (* (if (< (vector-length s5-2) 24576.0)
                           3.0
                           2.0
                           )
                       (if (logtest? (game-feature feature22) (-> *game-info* features))
                           2.0
                           1.0
                           )
                       )
                    )
             )
        (if (and (logtest? (process-mask guard) (-> arg0 mask))
                 (not (-> *setting-control* user-current gun-target-guards?))
                 )
            (set! f30-0 0.0)
            )
        (let ((s2-0 (new 'stack-no-clear 'vector)))
          (rot-zxy-from-vector! s2-0 s5-2)
          (let ((f28-0 (deg- (-> s2-0 x) (-> this start-rot x)))
                (f0-6 (deg- (-> s2-0 y) (-> this start-rot y)))
                )
            (when (or (< 2730.6667 (fabs f28-0)) (< 8192.0 (fabs f0-6)))
              (let ((f1-5 (fmax -2730.6667 (fmin 2730.6667 f28-0)))
                    (f0-8 (fmax -8192.0 (fmin 8192.0 f0-6)))
                    )
                (set! (-> s2-0 x) (+ (-> this start-rot x) f1-5))
                (set! (-> s2-0 y) (+ (-> this start-rot y) f0-8))
                )
              (set-vector! s5-2 0.0 0.0 1.0 1.0)
              (vector-rotate-around-x! s5-2 s5-2 (-> s2-0 x))
              (vector-rotate-around-y! s5-2 s5-2 (-> s2-0 y))
              )
            )
          )
        (+! (-> *game-info* shots-hit 1) 1.0)
        (if (as-type (ppointer->process (-> this parent)) blast-bot-player)
            (blast-lifesteal-dealt f30-0 #f)   ;; only the bot's own shots, not Jak's real gun
            )
        (send-event
          arg0
          'attack
          arg1
          (static-attack-info :mask (vehicle-impulse-factor) ((id (-> this attack-id))
                                                              (damage f30-0)
                                                              (vehicle-damage-factor 1.0)
                                                              (vehicle-impulse-factor 1.0)
                                                              (mode 'eco-red)
                                                              (attacker-velocity s5-2)
                                                              (attacker (blast-bot-morphgun-attacker this))
                                                              )
                              )
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-fire-guard-shot ((this blast-bot-player))
  (let* ((muzzle-matrix (matrix-copy! (new 'stack-no-clear 'matrix)
                                     (-> this node-list data 6 bone transform)))
         (start (matrix->trans muzzle-matrix (new 'stack-no-clear 'vector)))
         (direction (vector-normalize-copy! (new 'stack-no-clear 'vector)
                                            (-> muzzle-matrix fvec)
                                            614400.0))
         (end (vector+! (new 'stack-no-clear 'vector) start direction)))
    (vector+*! start start (-> muzzle-matrix fvec) 8192.0)
    (vector+! end start direction)
    (let ((shot (spawn-guard-projectile this start end 819200.0 (the-as vector #f))))
      ;; spawn-guard-projectile leaves owner-handle empty, so the shot's damage is attributed to the shot itself.
      ;; Mission kill counters only credit a target attacker, so make Jak the owner (ignore-handle stays the bot).
      (when (and shot *target* *blast-bot-credit-shots*)
        (set! (-> (the-as guard-shot (ppointer->process shot)) owner-handle) (process->handle *target*))
        )
      (if (and shot (-> this locked))
          (blast-lifesteal-dealt *blast-lifesteal-cannon-damage* #f)   ;; Mass Inverter lifesteal: the cannon shot has a target
          )
      )
    )
  (none)
  )

;; ---- Morphgun type switching (D-pad) ----
;; 0 = red (gun-red-1), 1 = yellow (gun-yellow-1), 2 = blue (gun-blue-1), 3 = purple (gun-dark-1). Jak's dark shot itself is not
;; used (gun-dark-shot's startup state dissipates the shot unless Jak is in gun mode, and it reads node 13 of its parent): the
;; purple weapons are rebuilt, like the others (Peace Maker = Errol's bomb, blastbot-ordnance.gc).
;; D-pad: up = red, down = yellow, left = blue, right = purple. Edit blast-bot-gun-select below to remap.
(define *blast-bot-gun-mode* 0)

;; ---- ownership (same test as want-to-gun? in target-gun.gc) ----

(defun blast-bot-gun-feature ((color int) (level int))
  ;; color: 0 red, 1 yellow, 2 blue, 3 purple.  level: 1..3
  (case color
    ((0)
     (case level
       ((1) (game-feature gun-red-1))
       ((2) (game-feature gun-red-2))
       (else (game-feature gun-red-3))
       )
     )
    ((1)
     (case level
       ((1) (game-feature gun-yellow-1))
       ((2) (game-feature gun-yellow-2))
       (else (game-feature gun-yellow-3))
       )
     )
    ((2)
     (case level
       ((1) (game-feature gun-blue-1))
       ((2) (game-feature gun-blue-2))
       (else (game-feature gun-blue-3))
       )
     )
    (else
      (case level
        ((1) (game-feature gun-dark-1))
        ((2) (game-feature gun-dark-2))
        (else (game-feature gun-dark-3))
        )
      )
    )
  )

(defun blast-bot-gun-level-owned? ((color int) (level int))
  (and *target*
       (nonzero? (-> *target* gun))
       (logtest? (-> *target* game features) (game-feature gun))
       (logtest? (logand (blast-bot-gun-feature color level) (-> *setting-control* user-current features))
                 (-> *target* game features)
                 )
       )
  )

(defun blast-bot-gun-owned? ((color int))
  ;; any level of that colour
  (or (blast-bot-gun-level-owned? color 1)
      (blast-bot-gun-level-owned? color 2)
      (blast-bot-gun-level-owned? color 3)
      )
  )

;; ---- heat system (shared by every weapon) ----
;; Each weapon says how many shots it allows from a cold start ("uses"). One shot adds 1/uses of heat.
;; At full heat the weapons lock until the meter has cooled down to *blast-bot-heat-resume*.

(define *blast-bot-heat* 0.0)             ;; 0..1
(define *blast-bot-overheated* #f)
(define *blast-bot-heat-capacity* 1.0)    ;; 2.0 = "increased ammo capacity" upgrade (heat meter doubled)
(define *blast-bot-heat-cool-rate* 0.2)   ;; meter units per second (0.2 = 5 s from full to empty)
(define *blast-bot-heat-resume* 0.25)     ;; an overheated weapon unlocks below this
(define *blast-bot-heat-cool-delay* 0.6)  ;; seconds after a shot before the meter starts cooling (without this, steady
                                          ;; clicking cooled as fast as it heated and the Blaster never built any heat)
(define *blast-bot-last-use* (the-as time-frame 0))
(define *blast-bot-warn-time* (the-as time-frame 0))    ;; throttles the "overheated" message to once a second
(define *blast-bot-unlimited-ammo* #f)    ;; cheat from the doc: weapons never overheat
(define *blast-bomb-uses* 2.0)            ;; bombs from a cold start before overheating (doc: 4, now 2)

(defun blast-bot-heat-update ((dt float))
  (if (time-elapsed? *blast-bot-last-use* (the int (* 300.0 *blast-bot-heat-cool-delay*)))
      (seek! *blast-bot-heat* 0.0 (* *blast-bot-heat-cool-rate* dt))
      )
  (when (and *blast-bot-overheated* (<= *blast-bot-heat* *blast-bot-heat-resume*))
    (set! *blast-bot-overheated* #f)
    (format 0 "Blast Bot: weapons cooled down~%")
    )
  (when *blast-bot-unlimited-ammo*
    (set! *blast-bot-heat* 0.0)
    (set! *blast-bot-overheated* #f)
    )
  ;; the hud bar (mod-common-functions.gc) reads these two
  (set! *blast-bot-hud-heat* *blast-bot-heat*)
  (set! *blast-bot-hud-overheat* *blast-bot-overheated*)
  (none)
  )

(defun blast-bot-heat-try-use ((uses float))
  ;; #t = the shot may fire (and its heat has been added). #f = overheated, no shot.
  (cond
    (*blast-bot-unlimited-ammo* #t)
    (*blast-bot-overheated*
      (when (time-elapsed? *blast-bot-warn-time* (seconds 1))
        (set-time! *blast-bot-warn-time*)
        (format 0 "Blast Bot: overheated~%")
        )
      #f
      )
    (else
      (+! *blast-bot-heat* (/ 1.0 (* uses *blast-bot-heat-capacity*)))
      (set-time! *blast-bot-last-use*)
      (when (>= *blast-bot-heat* 0.999)
        (set! *blast-bot-heat* 1.0)
        (set! *blast-bot-overheated* #t)
        (format 0 "Blast Bot: OVERHEAT~%")
        )
      #t
      )
    )
  )

(defun blast-bot-heat-text ()
  ;; text meter in the top-left console, same style as the HEALTH / FUEL fallback meters
  (when *blast-bot-weapon-text*
    (let ((n (the int (* 20.0 (fmax 0.0 (fmin 1.0 *blast-bot-heat*))))))
      (if *blast-bot-overheated*
          (format *stdcon* "OVERHEAT [")
          (format *stdcon* "HEAT     [")
          )
      (dotimes (i 20)
        (if (< i n)
            (format *stdcon* "#")
            (format *stdcon* "-")
            )
        )
      (format *stdcon* "]~%")
      )
    )
  (none)
  )

;; ---- enemy / actor scanner (find type names, e.g. the sentinel) ----
;; (blast-bot-scan-from (-> *target* root trans) *target* #t)  REPL: prints EVERY actor around that point once: type, process-mask,
;;                         distance. "ENEMY" = the type passes the same mask test the droids / bot use for targets.
;; (blast-bot-scan-on)     REPL: while the bot lives, scans once a second and prints each NEW type only once, so you can
;;                         just walk around (or into a fight) and read the console. (blast-bot-scan-off) stops it,
;;                         (blast-bot-scan-reset) forgets what was seen so everything prints again.
;; Scratch is global (the bot's state code runs on a 512-byte stack).
(define *blast-bot-scan-box* (new 'global 'vector))
(define *blast-bot-scan-hits* (new 'global 'array 'collide-shape 128))
(define *blast-bot-scan-radius* 163840.0)   ;; 40 m
(define *blast-bot-scan-on* #f)
(define *blast-bot-scan-time* (the-as time-frame 0))
(define *blast-bot-scan-seen* '())

(defun blast-bot-scan-seen? ((sym symbol))
  (let ((l (the-as object *blast-bot-scan-seen*))
        (hit #f)
        )
    (while (and (not (null? l)) (not hit))
      (if (= (car (the-as pair l)) sym)
          (set! hit #t)
          )
      (set! l (cdr (the-as pair l)))
      )
    hit
    )
  )

(defun blast-bot-scan-from ((center vector) (skip process) (print-all symbol))
  (vector-copy! *blast-bot-scan-box* center)
  (set! (-> *blast-bot-scan-box* w) *blast-bot-scan-radius*)
  (countdown (i (fill-actor-list-for-box *actor-hash* *blast-bot-scan-box* *blast-bot-scan-hits* 128))
    (let ((cs (as-type (-> *blast-bot-scan-hits* i) collide-shape)))
      (when (and cs (!= (-> cs process) skip) (!= (-> cs process) *target*))
        (let ((sym (-> cs process type symbol)))
          (when (or print-all (not (blast-bot-scan-seen? sym)))
            (if (not print-all)
                (set! *blast-bot-scan-seen* (cons sym *blast-bot-scan-seen*))
                )
            (format 0 "SCAN ~A mask #x~X dist ~M ~A~%"
                    (-> cs process type)
                    (-> cs process mask)
                    (vector-vector-distance center (-> cs trans))
                    (if (logtest? (process-mask enemy guard metalhead kg-robot) (-> cs process mask)) "ENEMY" "-")
                    )
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-scan-update ((this blast-bot-player))
  ;; called every frame by the bot; does nothing unless (blast-bot-scan-on) was run
  (when (and *blast-bot-scan-on* (time-elapsed? *blast-bot-scan-time* (seconds 1)))
    (set-time! *blast-bot-scan-time*)
    (blast-bot-scan-from (-> this root trans) this #f)
    )
  (none)
  )

(defun blast-bot-scan-on ()
  (set! *blast-bot-scan-on* #t)
  (format 0 "Blast Bot scan: ON (new types print once, radius ~M)~%" *blast-bot-scan-radius*)
  (none)
  )

(defun blast-bot-scan-off ()
  (set! *blast-bot-scan-on* #f)
  (format 0 "Blast Bot scan: off~%")
  (none)
  )

(defun blast-bot-scan-reset ()
  (set! *blast-bot-scan-seen* '())
  (none)
  )

;; ---- red arsenal ----

(define *blast-bot-red-weapon* 1)         ;; 1 Scattergun, 2 Wave Concussor, 3 Plasmite RPG

;; Scattergun grid. Doc: 4 wide x 2 long (8 bombs); the upgrade makes it 7 wide x 4 long.
(define *blast-bot-scatter-cols* 4)
(define *blast-bot-scatter-rows* 2)
(define *blast-bot-scatter-spread* 9.0)   ;; degrees between neighbouring columns
(define *blast-bot-scatter-speed-near* 150000.0)
(define *blast-bot-scatter-speed-far* 250000.0)
;; Wave Concussor: 8 grenades in a ring; the upgrade adds a second, inner ring of 8 placed between the gaps (16 total)
(define *blast-bot-wave-inner-ring* #f)
(define *blast-bot-wave-speed* 90000.0)
(define *blast-bot-wave-inner-speed* 45000.0)

(defun blast-bot-muzzle ((this blast-bot-player) (start vector) (dir vector))
  ;; the same muzzle point / direction the other bot shots use (bone 6), nudged forward out of the barrel
  (let ((m (matrix-copy! (new 'stack-no-clear 'matrix) (-> this node-list data 6 bone transform))))
    (matrix->trans m start)
    (vector-normalize-copy! dir (-> m fvec) 1.0)
    (vector+*! start start dir 8192.0)
    )
  (none)
  )

(defun blast-bot-spawn-grenade ((this blast-bot-player) (start vector) (vel vector))
  ;; Jak's own red level-3 grenade (gun-red-3-grenade), spawned the way gun-fire-red-3 does it, but with the bot as
  ;; parent and ignored process. The grenade's own code decides when it explodes (proximity fuse + timeout) and how
  ;; hard it hits; its damage, blast radius and fuse are fixed inside that type (see the notes at the bottom).
  (let ((params (new 'stack-no-clear 'projectile-init-by-other-params)))
    (set! (-> params ent) (-> this entity))
    (set! (-> params charge) 1.0)
    (set! (-> params options) (projectile-options))
    (logclear! (-> params options) (projectile-options po14 po15 po16))
    (vector-copy! (-> params pos) start)
    (vector-copy! (-> params vel) vel)
    (set! (-> params notify-handle) (the-as handle #f))
    (set! (-> params owner-handle)
          (if (and *target* *blast-bot-morphgun-credit-jak*)
              (process->handle *target*)
              (process->handle this)
              )
          )
    (set! (-> params target-handle) (the-as handle #f))
    (set! (-> params target-pos quad) (the-as uint128 0))
    (set! (-> params ignore-handle) (process->handle this))
    (let* ((v1 *game-info*)
           (id (+ (-> v1 attack-id) 1))
           )
      (set! (-> v1 attack-id) id)
      (set! (-> params attack-id) id)
      )
    (set! (-> params timeout) (seconds 4))
    (spawn-projectile gun-red-3-grenade params this *default-dead-pool*)
    )
  (none)
  )

(defun blast-bot-grenade-vel ((out vector) (flat vector) (speed float))
  ;; lobbed throw: horizontal direction plus a fixed upward loft (gun-fire-red-3 also forces y >= 0.3)
  (vector-copy! out flat)
  (set! (-> out y) 0.0)
  (vector-normalize! out 1.0)
  (set! (-> out y) 0.45)
  (vector-normalize! out speed)
  (none)
  )

(defun blast-bot-fire-scattergun ((this blast-bot-player))
  ;; cols x rows grenades in a cone in front of the bot. Rows are different throw distances.
  (let ((start (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        (flat (new 'stack-no-clear 'vector))
        (vel (new 'stack-no-clear 'vector))
        (cols *blast-bot-scatter-cols*)
        (rows *blast-bot-scatter-rows*)
        )
    (blast-bot-muzzle this start dir)
    (dotimes (r rows)
      (let ((speed (if (< rows 2)
                       *blast-bot-scatter-speed-far*
                       (+ *blast-bot-scatter-speed-near*
                          (* (/ (the float r) (the float (+ rows -1)))
                             (- *blast-bot-scatter-speed-far* *blast-bot-scatter-speed-near*)))
                       )
                   )
            )
        (dotimes (c cols)
          (let ((yaw (* (- (the float c) (* 0.5 (the float (+ cols -1)))) *blast-bot-scatter-spread*)))
            (vector-rotate-y! flat dir (* 182.04445 yaw))
            (blast-bot-grenade-vel vel flat speed)
            (blast-bot-spawn-grenade this start vel)
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-fire-concussor ((this blast-bot-player))
  ;; Launch each grenade outside the bot's body/shield, then throw it radially outward.
  ;; The old code spawned every grenade at the bot centre, so its proximity fuse
  ;; could trigger immediately against the bot's own collision.
  (let ((center (new 'stack-no-clear 'vector))
        (start (new 'stack-no-clear 'vector))
        (flat (new 'stack-no-clear 'vector))
        (vel (new 'stack-no-clear 'vector))
        )
    (vector-copy! center (-> this root trans))
    (+! (-> center y) 24576.0)
    (dotimes (i 8)
      (set! (-> flat x) (sin (* 182.04445 (* 45.0 (the float i)))))
      (set! (-> flat y) 0.0)
      (set! (-> flat z) (cos (* 182.04445 (* 45.0 (the float i)))))
      ;; Start beyond the large circle shield and bot collision, in the same direction as travel.
      (vector-copy! start center)
      (vector+*! start start flat 16384.0)
      (blast-bot-grenade-vel vel flat *blast-bot-wave-speed*)
      (blast-bot-spawn-grenade this start vel)
      )
    (when *blast-bot-wave-inner-ring*
      (dotimes (i 8)
        (set! (-> flat x) (sin (* 182.04445 (+ 22.5 (* 45.0 (the float i))))))
        (set! (-> flat y) 0.0)
        (set! (-> flat z) (cos (* 182.04445 (+ 22.5 (* 45.0 (the float i))))))
        (vector-copy! start center)
        (vector+*! start start flat 32768.0)
        (blast-bot-grenade-vel vel flat *blast-bot-wave-inner-speed*)
        (blast-bot-spawn-grenade this start vel)
        )
      )
    )
  (none)
  )

(defun blast-bot-fire-red-arsenal ((this blast-bot-player))
  (case *blast-bot-red-weapon*
    ((1)
     (if (blast-bot-heat-try-use 1.0)        ;; one shot before overheating
         (blast-bot-fire-scattergun this)
         )
     )
    ((2)
     (if (blast-bot-heat-try-use 1.0)        ;; one shot before overheating
         (blast-bot-fire-concussor this)
         )
     )
    (else
      (if (blast-bot-heat-try-use 1.0)      ;; one use before overheating
          (spydroid-ally-launch this)
          )
     )
    )
  (none)
  )

;; ---- selection ----

(defun blast-bot-red-fix ()
  ;; keep *blast-bot-red-weapon* on a level Jak actually owns
  (when (not (blast-bot-gun-level-owned? 0 *blast-bot-red-weapon*))
    (let ((found #f))
      (dotimes (i 3)
        (when (and (not found) (blast-bot-gun-level-owned? 0 (+ i 1)))
          (set! *blast-bot-red-weapon* (+ i 1))
          (set! found #t)
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-red-cycle ()
  ;; next owned red weapon after the current one (wraps)
  (let ((found #f))
    (dotimes (i 3)
      (let ((lvl (+ 1 (mod (+ *blast-bot-red-weapon* i) 3))))
        (when (and (not found) (blast-bot-gun-level-owned? 0 lvl))
          (set! *blast-bot-red-weapon* lvl)
          (set! found #t)
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-red-name ((level int))
  (case level
    ((1) "Scattergun")
    ((2) "Wave Concussor")
    (else "Plasmite RPG")
    )
  )

;; ---- yellow selection (same idea as red) ----
(define *blast-bot-yellow-weapon* 1)      ;; 1 Blaster, 2 Beam Reflexor, 3 Gyro Burster
(define *blast-bot-burst-left* 0)              ;; Beam Reflexor bullets still to fire in the current burst
(define *blast-bot-burst-time* (the-as time-frame 0))

(defun blast-bot-yellow-fix ()
  ;; keep *blast-bot-yellow-weapon* on a level Jak actually owns
  (when (not (blast-bot-gun-level-owned? 1 *blast-bot-yellow-weapon*))
    (let ((found #f))
      (dotimes (i 3)
        (when (and (not found) (blast-bot-gun-level-owned? 1 (+ i 1)))
          (set! *blast-bot-yellow-weapon* (+ i 1))
          (set! found #t)
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-yellow-cycle ()
  ;; next owned yellow weapon after the current one (wraps)
  (let ((found #f))
    (dotimes (i 3)
      (let ((lvl (+ 1 (mod (+ *blast-bot-yellow-weapon* i) 3))))
        (when (and (not found) (blast-bot-gun-level-owned? 1 lvl))
          (set! *blast-bot-yellow-weapon* lvl)
          (set! found #t)
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-yellow-name ((level int))
  (case level
    ((1) "Blaster")
    ((2) "Beam Reflexor")
    (else "Gyro Burster")
    )
  )

;; ---- blue selection (same idea as red / yellow) ----
(define *blast-bot-blue-weapon* 1)        ;; 1 Vulcan Fury, 2 Arc Wielder, 3 Needle Lazer
(define *blast-bot-blue-max* 3)           ;; highest blue level that is built (3 = Needle Lazer, roboguard-ally.gc)

(defun blast-bot-blue-fix ()
  ;; keep *blast-bot-blue-weapon* on a built level Jak actually owns
  (when (or (< *blast-bot-blue-max* *blast-bot-blue-weapon*)
            (not (blast-bot-gun-level-owned? 2 *blast-bot-blue-weapon*))
            )
    (let ((found #f))
      (dotimes (i *blast-bot-blue-max*)
        (when (and (not found) (blast-bot-gun-level-owned? 2 (+ i 1)))
          (set! *blast-bot-blue-weapon* (+ i 1))
          (set! found #t)
          )
        )
      )
    (if (< *blast-bot-blue-max* *blast-bot-blue-weapon*)
        (set! *blast-bot-blue-weapon* 1)
        )
    )
  (none)
  )

(defun blast-bot-blue-cycle ()
  ;; next owned (and built) blue weapon after the current one (wraps)
  (let ((found #f))
    (dotimes (i *blast-bot-blue-max*)
      (let ((lvl (+ 1 (mod (+ *blast-bot-blue-weapon* i) *blast-bot-blue-max*))))
        (when (and (not found) (blast-bot-gun-level-owned? 2 lvl))
          (set! *blast-bot-blue-weapon* lvl)
          (set! found #t)
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-blue-name ((level int))
  (case level
    ((1) "Vulcan Fury")
    ((2) "Arc Wielder")
    (else "Needle Lazer")
    )
  )

;; ---- purple selection (same idea as red / yellow / blue) ----
(define *blast-bot-purple-weapon* 1)      ;; 1 Peace Maker, 2 Mass Inverter, 3 Super Nova
(define *blast-bot-purple-max* 3)         ;; highest purple level that is built (1 = Peace Maker, blastbot-ordnance.gc; 2 = Mass Inverter, bombbot-ally.gc; 3 = Super Nova, below)

(defun blast-bot-purple-fix ()
  ;; keep *blast-bot-purple-weapon* on a built level Jak actually owns
  (when (or (< *blast-bot-purple-max* *blast-bot-purple-weapon*)
            (not (blast-bot-gun-level-owned? 3 *blast-bot-purple-weapon*))
            )
    (let ((found #f))
      (dotimes (i *blast-bot-purple-max*)
        (when (and (not found) (blast-bot-gun-level-owned? 3 (+ i 1)))
          (set! *blast-bot-purple-weapon* (+ i 1))
          (set! found #t)
          )
        )
      )
    (if (< *blast-bot-purple-max* *blast-bot-purple-weapon*)
        (set! *blast-bot-purple-weapon* 1)
        )
    )
  (none)
  )

(defun blast-bot-purple-cycle ()
  ;; next owned (and built) purple weapon after the current one (wraps)
  (let ((found #f))
    (dotimes (i *blast-bot-purple-max*)
      (let ((lvl (+ 1 (mod (+ *blast-bot-purple-weapon* i) *blast-bot-purple-max*))))
        (when (and (not found) (blast-bot-gun-level-owned? 3 lvl))
          (set! *blast-bot-purple-weapon* lvl)
          (set! found #t)
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-purple-name ((level int))
  (case level
    ((1) "Peace Maker")
    ((2) "Mass Inverter")
    (else "Super Nova")
    )
  )

(defun blast-bot-gun-select ()
  (let ((old *blast-bot-gun-mode*)
        (old-red *blast-bot-red-weapon*)
        (old-yellow *blast-bot-yellow-weapon*)
        (old-blue *blast-bot-blue-weapon*)
        (old-purple *blast-bot-purple-weapon*)
        (want -1)
        )
    (cond
      ((cpad-pressed? 0 up) (set! want 0))      ;; red
      ((cpad-pressed? 0 down) (set! want 1))    ;; yellow
      ((cpad-pressed? 0 left) (set! want 2))    ;; blue
      ((cpad-pressed? 0 right) (set! want 3))   ;; purple
      )
    (when (>= want 0)
      (cond
        ((not (blast-bot-gun-owned? want))
         (format 0 "Blast Bot: you do not own the ~A gun yet~%" (case want ((0) 'red) ((1) 'yellow) ((2) 'blue) (else 'purple)))
         )
        ((and (= want 0) (= *blast-bot-gun-mode* 0))
         ;; pressing red again while on red cycles through the red weapons you own
         (blast-bot-red-cycle)
         )
        ((and (= want 1) (= *blast-bot-gun-mode* 1))
         ;; pressing yellow again while on yellow cycles through the yellow weapons you own
         (blast-bot-yellow-cycle)
         )
        ((and (= want 2) (= *blast-bot-gun-mode* 2))
         ;; pressing blue again while on blue cycles through the blue weapons you own
         (blast-bot-blue-cycle)
         )
        ((and (= want 3) (= *blast-bot-gun-mode* 3))
         ;; pressing purple again while on purple cycles through the purple weapons you own
         (blast-bot-purple-cycle)
         )
        (else
          (set! *blast-bot-gun-mode* want)
          )
        )
      )
    ;; the selected colour is no longer owned (first frame, or features changed): move to the first owned one
    (when (not (blast-bot-gun-owned? *blast-bot-gun-mode*))
      (dotimes (i 4)
        (when (and (not (blast-bot-gun-owned? *blast-bot-gun-mode*)) (blast-bot-gun-owned? i))
          (set! *blast-bot-gun-mode* i)
          )
        )
      )
    (blast-bot-red-fix)
    (blast-bot-yellow-fix)
    (blast-bot-blue-fix)
    (blast-bot-purple-fix)
    (if (!= old *blast-bot-gun-mode*)
        (format 0 "Blast Bot: gun ~A~%" (case *blast-bot-gun-mode* ((0) 'red) ((1) 'yellow) ((2) 'blue) (else 'purple)))
        )
    (if (and (= *blast-bot-gun-mode* 0) (or (!= old *blast-bot-gun-mode*) (!= old-red *blast-bot-red-weapon*)))
        (format 0 "Blast Bot: red weapon ~A~%" (blast-bot-red-name *blast-bot-red-weapon*))
        )
    (if (and (= *blast-bot-gun-mode* 1) (or (!= old *blast-bot-gun-mode*) (!= old-yellow *blast-bot-yellow-weapon*)))
        (format 0 "Blast Bot: yellow weapon ~A~%" (blast-bot-yellow-name *blast-bot-yellow-weapon*))
        )
    (if (and (= *blast-bot-gun-mode* 2) (or (!= old *blast-bot-gun-mode*) (!= old-blue *blast-bot-blue-weapon*)))
        (format 0 "Blast Bot: blue weapon ~A~%" (blast-bot-blue-name *blast-bot-blue-weapon*))
        )
    (if (and (= *blast-bot-gun-mode* 3) (or (!= old *blast-bot-gun-mode*) (!= old-purple *blast-bot-purple-weapon*)))
        (format 0 "Blast Bot: purple weapon ~A~%" (blast-bot-purple-name *blast-bot-purple-weapon*))
        )
    (if (!= old *blast-bot-gun-mode*)
        (set! *blast-bot-burst-left* 0)
        )
    ;; what is selected: feeds the coloured bar above the health bar (mod-common-functions.gc) and prints the name
    (let ((lvl (case *blast-bot-gun-mode*
                 ((0) *blast-bot-red-weapon*)
                 ((1) *blast-bot-yellow-weapon*)
                 ((2) *blast-bot-blue-weapon*)
                 (else *blast-bot-purple-weapon*)
                 )
               )
          )
      (set! *blast-bot-hud-gun-color* *blast-bot-gun-mode*)
      (set! *blast-bot-hud-gun-level* lvl)
      (when *blast-bot-weapon-text*
        (format *stdcon* "WEAPON ~A ~D/3: ~A~%"
                (case *blast-bot-gun-mode* ((0) "RED") ((1) "YELLOW") ((2) "BLUE") (else "PURPLE"))
                lvl
                (case *blast-bot-gun-mode*
                  ((0) (blast-bot-red-name lvl))
                  ((1) (blast-bot-yellow-name lvl))
                  ((2) (blast-bot-blue-name lvl))
                  (else (blast-bot-purple-name lvl))
                  )
                )
        )
      )
    )
  (none)
  )

;; DEBUG for the yellow/blue crash: *blast-bot-proj-debug* prints a line at each step of firing, so the last line before a crash
;; shows where it dies. *blast-bot-proj-po17* #f gives the shot empty projectile-options (the way the working red grenade
;; is spawned) instead of po17 (what Jak's gun uses).
(define *blast-bot-proj-debug* #f)
(define *blast-bot-proj-po17* #t)

;; Fills the projectile params the way gun-fire-yellow-1 / gun-fire-blue-1 do, but for the bot: the bot is the
;; ignored process and (like the red shot) the named attacker, so citizens turn on the bot, not Jak.
;; The params struct MUST be allocated by the caller (pass (new 'stack-no-clear 'projectile-init-by-other-params) as the
;; third argument): allocating it in here and returning it handed back a pointer into this function's own, already
;; released stack frame, which the next call overwrote -> garbage params -> instant crash / self-hit.
(defun blast-bot-projectile-params ((this blast-bot-player) (start vector) (params projectile-init-by-other-params))
  (let ((params params))
    (set! (-> params ent) (-> this entity))
    (set! (-> params charge) 1.0)
    (if *blast-bot-proj-po17*
        (set! (-> params options) (projectile-options po17))
        (set! (-> params options) (projectile-options))
        )
    (logclear! (-> params options) (projectile-options po14 po15 po16))
    (vector-copy! (-> params pos) start)
    (set! (-> params notify-handle) (the-as handle #f))
    (set! (-> params owner-handle)
          (if (and *target* *blast-bot-morphgun-credit-jak*)
              (process->handle *target*)
              (process->handle this)
              )
          )
    (set! (-> params target-handle) (the-as handle #f))
    (set! (-> params target-pos quad) (the-as uint128 0))
    (set! (-> params ignore-handle) (process->handle this))
    (let* ((v1 *game-info*)
           (id (+ (-> v1 attack-id) 1))
           )
      (set! (-> v1 attack-id) id)
      (set! (-> params attack-id) id)
      )
    (set! (-> params timeout) (seconds 4))
    params
    )
  )

;; Homing Attacks cheat. The shot follows the TURRET's lock-on (blast-bot-update-aim): the same target, so the same rules, i.e. the
;; same range (50 m, blast-bot-find-lock), the same on-screen + line-of-sight check, and the same valid-target filter, which
;; includes crimson guards. No lock = the turret has nothing in range = the shot just flies straight, so homing never shoots
;; at something the turret can't see or reach. While locked, the shot goes at the locked target, never at some other enemy.
;; Call it right before a projectile's velocity is built from the unit direction `dir`. Does nothing while *blast-homing* is #f.
(defun blast-homing-aim ((from vector) (dir vector) (owner blast-bot-player))
  (when (and *blast-homing* owner (-> owner locked))
    (let ((v (new 'stack-no-clear 'vector)))
      (vector-! v (-> owner target-pos) from)      ;; target-pos = the locked enemy (set every frame by blast-bot-update-aim)
      (when (< 1.0 (vector-length v))
        (vector-normalize! v 1.0)
        (vector-copy! dir v)
        )
      )
    )
  (none)
  )

(defun blast-bot-fire-yellow ((this blast-bot-player))
  (if *blast-bot-proj-debug* (format 0 "yellow: fire start~%"))
  (let* ((muzzle-matrix (matrix-copy! (new 'stack-no-clear 'matrix)
                                     (-> this node-list data 6 bone transform)))
         (start (matrix->trans muzzle-matrix (new 'stack-no-clear 'vector)))
         (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> muzzle-matrix fvec) 1.0))
         )
    (vector+*! start start dir 8192.0)
    (if *blast-bot-proj-debug* (format 0 "yellow: muzzle ok~%"))
    (let ((params (blast-bot-projectile-params this start (new 'stack-no-clear 'projectile-init-by-other-params))))
      (if *blast-bot-proj-debug* (format 0 "yellow: params ok~%"))
      (blast-homing-aim start dir this)     ;; Homing Attacks cheat
      (vector-float*! (-> params vel) dir 819200.0)
      (let ((shot (spawn-projectile gun-yellow-shot params this *default-dead-pool*)))
        (if *blast-bot-proj-debug* (format 0 "yellow: spawned ~A~%" (if shot #t #f)))
        )
      )
    )
  (none)
  )

;; ---- yellow arsenal ----
;; Blaster        : gun-yellow-shot, 20 shots before overheating (blast-bot-fire-yellow above).
;; Beam Reflexor  : a burst of *blast-bot-reflexor-bullets* (5) bullets, 2 bursts before overheating. The bullets are
;;                  fired one every *blast-bot-reflexor-gap* seconds by blast-bot-yellow-update. The doc's upgrade
;;                  "adds ricochet": *blast-bot-reflexor-ricochet* #t swaps them for gun-yellow-shot-2 (Jak's own
;;                  bouncing beam shot). Untested, so it is off by default.
;; Gyro Burster   : launches two sentinel turrets (sentinel-ally.gc) and a salvo of homing missiles (blastbot-ordnance.gc);
;;                  the hover guard is not in yet.
(define *blast-bot-reflexor-bullets* 5)
(define *blast-bot-reflexor-gap* 0.1)    ;; seconds between the bullets of a burst (0.05 looked like one solid beam)
(define *blast-bot-reflexor-ricochet* #f)

(defun blast-bot-fire-yellow-2 ((this blast-bot-player))
  ;; same as blast-bot-fire-yellow but the ricochet shot (gun-fire-yellow-2)
  (let* ((muzzle-matrix (matrix-copy! (new 'stack-no-clear 'matrix)
                                     (-> this node-list data 6 bone transform)))
         (start (matrix->trans muzzle-matrix (new 'stack-no-clear 'vector)))
         (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> muzzle-matrix fvec) 1.0))
         )
    (vector+*! start start dir 8192.0)
    (let ((params (blast-bot-projectile-params this start (new 'stack-no-clear 'projectile-init-by-other-params))))
      (blast-homing-aim start dir this)     ;; Homing Attacks cheat
      (vector-float*! (-> params vel) dir 819200.0)
      (spawn-projectile gun-yellow-shot-2 params this *default-dead-pool*)
      )
    )
  (none)
  )

(defun blast-bot-fire-reflexor-bullet ((this blast-bot-player))
  (if *blast-bot-reflexor-ricochet*
      (blast-bot-fire-yellow-2 this)
      (blast-bot-fire-yellow this)
      )
  (none)
  )

;; ---- Blaster Auto-Mode (secret shop: gun-upgrade-yellow-1) ----
;; With the Blaster selected, HOLD R1 for *blast-bot-auto-toggle-time* seconds to switch auto-mode on (hold again to switch
;; it off). While it is on the turret shoots Blaster shots at whatever it is locked on to (nearest visible enemy), and it
;; KEEPS doing that whatever weapon / colour is selected afterwards, so the other weapons are free for you to fire by hand.
;; The shots are free by default (no heat); set *blast-bot-auto-uses* to e.g. 40.0 to make each one cost 1/40 of the meter.
(define *blast-bot-auto-unlocked* #f)    ;; set by blast-bot-secrets-apply (REPL: (set! *blast-bot-auto-unlocked* #t) to test)
(define *blast-bot-auto-on* #f)
(define *blast-bot-auto-gap* 0.3)          ;; seconds between auto shots
(define *blast-bot-auto-uses* 0.0)         ;; 0 = auto shots do not heat the guns
(define *blast-bot-auto-aim-dot* 0.985)    ;; the barrel must point this close to the target (cosine, 0.985 = about 10 degrees)
(define *blast-bot-auto-toggle-time* 0.7)  ;; seconds of holding R1 that flip auto-mode
(define *blast-bot-auto-time* (the-as time-frame 0))
(define *blast-bot-auto-hold* (the-as time-frame 0))
(define *blast-bot-auto-flipped* #f)

(defun blast-bot-auto-toggle ()
  ;; every frame from blast-bot-fire-input
  (if (and *blast-bot-auto-unlocked*
           *blast-bot-use-morphgun*
           (= *blast-bot-gun-mode* 1)
           (= *blast-bot-yellow-weapon* 1)
           (cpad-hold? 0 r1)
           )
      (begin
        (if (= *blast-bot-auto-hold* 0)
            (set! *blast-bot-auto-hold* (current-time))
            )
        (when (and (not *blast-bot-auto-flipped*)
                   (>= (- (current-time) *blast-bot-auto-hold*) (the int (* 300.0 *blast-bot-auto-toggle-time*)))
                   )
          (set! *blast-bot-auto-flipped* #t)
          (set! *blast-bot-auto-on* (not *blast-bot-auto-on*))
          (format 0 "Blast Bot: Blaster auto-mode ~A~%" (if *blast-bot-auto-on* "ON" "OFF"))
          )
        )
      (begin
        (set! *blast-bot-auto-hold* 0)
        (set! *blast-bot-auto-flipped* #f)
        )
      )
  (none)
  )

(defun blast-bot-auto-update ((this blast-bot-player))
  ;; every frame from blast-bot-yellow-update, whatever weapon is selected
  (when (and *blast-bot-auto-on* *blast-bot-auto-unlocked*)
    (if *blast-bot-weapon-text*
        (format *stdcon* "AUTO-MODE ON~%")
        )
    (when (and (-> this locked)
               (time-elapsed? *blast-bot-auto-time* (the int (* 300.0 *blast-bot-auto-gap*)))
               )
      (let* ((m (-> this node-list data 6 bone transform))
             (start (matrix->trans m (new 'stack-no-clear 'vector)))
             (fwd (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> m fvec) 1.0))
             (to (vector-! (new 'stack-no-clear 'vector) (-> this target-pos) start))
             )
        (vector-normalize! to 1.0)
        (when (< *blast-bot-auto-aim-dot* (vector-dot to fwd))
          (when (or (>= 0.0 *blast-bot-auto-uses*) (blast-bot-heat-try-use *blast-bot-auto-uses*))
            (set-time! *blast-bot-auto-time*)
            (blast-bot-fire-yellow this)
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-yellow-update ((this blast-bot-player))
  ;; every frame: keeps a Beam Reflexor burst going
  (blast-bot-auto-update this)
  (when (and (< 0 *blast-bot-burst-left*)
             (time-elapsed? *blast-bot-burst-time* (the int (* 300.0 *blast-bot-reflexor-gap*)))
             )
    (set-time! *blast-bot-burst-time*)
    (blast-bot-fire-reflexor-bullet this)
    (+! *blast-bot-burst-left* -1)
    )
  ;; the Arc Wielder's lasers (blastbot-ordnance.gc): turn, draw and hurt until they have done a full 360
  (blast-arc-update this)
  (none)
  )

(defun blast-bot-fire-gyro-burster ((this blast-bot-player))
  ;; Doc: launch missiles and spawn two sentinels that help you (+ a hover guard with the upgrade).
  ;; Missiles: blastbot-ordnance.gc (they only go for enemies, never guards / civilians). The hover guard is not in yet.
  (when (blast-bot-heat-try-use 1.0)      ;; one use before overheating
    (sentinel-ally-launch this)
    (blast-missile-launch this)
    )
  (none)
  )

(defun blast-bot-fire-yellow-arsenal ((this blast-bot-player))
  (case *blast-bot-yellow-weapon*
    ((1)
     (if (blast-bot-heat-try-use 20.0)       ;; Blaster: twenty shots before overheating
         (blast-bot-fire-yellow this)
         )
     )
    ((2)
     (when (blast-bot-heat-try-use 2.0)      ;; Beam Reflexor: two bursts before overheating
       (blast-bot-fire-reflexor-bullet this)
       (set! *blast-bot-burst-left* (+ *blast-bot-reflexor-bullets* -1))
       (set-time! *blast-bot-burst-time*)
       )
     )
    (else
      (blast-bot-fire-gyro-burster this)
      )
    )
  (none)
  )

(defun blast-bot-fire-blue ((this blast-bot-player))
  (let* ((muzzle-matrix (matrix-copy! (new 'stack-no-clear 'matrix)
                                     (-> this node-list data 6 bone transform)))
         (start (matrix->trans muzzle-matrix (new 'stack-no-clear 'vector)))
         (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> muzzle-matrix fvec) 1.0))
         (spread (new 'stack-no-clear 'vector))
         )
    (vector+*! start start dir 8192.0)
    (blast-homing-aim start dir this)       ;; Homing Attacks cheat
    ;; the same random cone gun-fire-blue-1 uses
    (let ((q (new 'stack-no-clear 'quaternion)))
      (quaternion-vector-angle! q dir (* 182.04445 (rand-vu-float-range 0.0 360.0)))
      (vector-rotate-y! spread dir (* 182.04445 (rand-vu-float-range 0.0 1.1)))
      (vector-orient-by-quat! spread spread q)
      )
    (let ((params (blast-bot-projectile-params this start (new 'stack-no-clear 'projectile-init-by-other-params))))
      (vector-copy! (-> params vel) spread)
      (spawn-projectile gun-blue-shot params this *default-dead-pool*)
      )
    )
  (none)
  )

(defun blast-bot-fire-blue-arsenal ((this blast-bot-player))
  (case *blast-bot-blue-weapon*
    ((2)
     ;; Arc Wielder: 4 rotating lasers that last for one full 360 (blastbot-ordnance.gc). One use before overheating.
     ;; Pressing again while they are still turning does nothing (and costs no heat).
     (when (and (not *blast-arc-active*) (blast-bot-heat-try-use 1.0))
       (blast-arc-launch this)
       )
     )
    ((3)
     ;; Needle Lazer: launches an allied roboguard (roboguard-ally.gc). One use before overheating; nothing is spent when
     ;; the maximum number of roboguards is already alive.
     (when (and (< (roboguard-ally-count) *roboguard-ally-max*) (blast-bot-heat-try-use 1.0))
       (roboguard-ally-launch this)
       )
     )
    (else
      (if (blast-bot-heat-try-use 100.0)    ;; Vulcan Fury: a hundred shots before overheating
          (blast-bot-fire-blue this)
          )
      )
    )
  (none)
  )

;; the last spot the turret was aiming at an enemy (kept while the Peace Maker is in hand); a bomb fired just after the lock is lost
;; (target died, stepped out of sight) still goes there
(define *blast-bomb-last-aim* (new 'global 'vector))
(define *blast-bomb-last-aim-time* (the-as time-frame 0))   ;; 0 = none
(define *blast-bomb-last-aim-keep* 1.0)                       ;; seconds the last aim spot stays valid

(defun blast-bot-peacemaker-aim-track ((this blast-bot-player))
  (when (-> this locked)
    (vector-copy! *blast-bomb-last-aim* (-> this target-pos))
    (set-time! *blast-bomb-last-aim-time*)
    )
  (none)
  )

(defun blast-bot-fire-peacemaker ((this blast-bot-player))
  ;; Peace Maker: Errol's bomb, lobbed from the muzzle (blastbot-ordnance.gc). It lands where the turret was aiming when it fired: the
  ;; locked enemy's spot, or the last spot it aimed at if the lock was lost a moment ago, or 30 m ahead with nothing to aim at.
  ;; It only follows the enemy while it flies with the Homing Attacks cheat on (*blast-homing*).
  (let* ((muzzle-matrix (matrix-copy! (new 'stack-no-clear 'matrix)
                                     (-> this node-list data 6 bone transform)))
         (start (matrix->trans muzzle-matrix (new 'stack-no-clear 'vector)))
         (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> muzzle-matrix fvec) 1.0))
         (target (if (-> this locked)
                     (as-type (handle->process (-> this lock-handle)) process-focusable)
                     (the-as process-focusable #f)
                     ))
         )
    (vector+*! start start dir 8192.0)
    (blast-bot-peacemaker-aim-track this)
    (cond
      ((and *blast-homing* target)
       (set! *blast-bomb-has-fixed* #f)
       (blast-bomb-launch this start dir target)
       )
      (else
        (cond
          ((-> this locked)
           (vector-copy! *blast-bomb-fixed-dest* (-> this target-pos))
           (set! *blast-bomb-has-fixed* #t)
           )
          ((and (!= *blast-bomb-last-aim-time* 0)
                (not (time-elapsed? *blast-bomb-last-aim-time* (the int (* 300.0 *blast-bomb-last-aim-keep*)))))
           (vector-copy! *blast-bomb-fixed-dest* *blast-bomb-last-aim*)
           (set! *blast-bomb-has-fixed* #t)
           )
          (else (set! *blast-bomb-has-fixed* #f))
          )
        (blast-bomb-launch this start dir (the-as process-focusable #f))
        (set! *blast-bomb-has-fixed* #f)
        )
      )
    )
  (none)
  )

;; ---- Super Nova (purple 3): kamikaze ----
;; Doc: you explode and kill everything within 100 m, and become a spy-bot for 10 seconds until your blast-bot respawns. One use
;; before overheating. What happens:
;;   0. R1 starts a *blast-nova-fuse-time* countdown (3 s). The bot stays fully controllable; if it dies meanwhile the nova is cancelled.
;;   1. R1: a small director process (blast-nova) is spawned at the bot. When the fuse ends it does the blast: every valid target within
;;      *blast-nova-radius* takes *blast-nova-damage* (same target rule as the Peace Maker: whatever the red / yellow / blue shots
;;      hurt; never Jak, the bot or the allies), plus the explosion effects and a big camera shake.
;;   2. the bot is removed the way L1 + Triangle does it (despawn-my-bombbot: Jak is released, then blast-bot-despawn-update, which
;;      your mod code already calls every frame, deactivates the bot).
;;   3. *blast-nova-respawn-time* seconds later the director calls spawn-my-bombbot (a new bot with full health) and dies.
;; The spy-bot part lives in blastbot-spybot.gc (loaded after this file, hence the define-extern below): blast-nova-spybot-start
;; launches the droid, which you drive until just before step 3. The purple 3 secret (invulnerable 3 s after becoming a
;; spy-bot) is applied there as well.
(define *blast-nova-damage* 1000.0)             ;; "kill everything"
(define *blast-nova-radius* 409600.0)           ;; doc: 100 m
(define *blast-nova-respawn-time* 10.0)         ;; doc: 10 s until the new bot (counted from the blast, not from R1)
(define *blast-nova-fuse-time* 3.0)             ;; seconds between R1 and the explosion
(define *blast-nova-fx-scale* 3.0)              ;; size of the stock huge explosion effect
(define *blast-nova-handle* (the-as handle #f)) ;; the live director: only one kamikaze at a time
(define *blast-nova-hits* (new 'global 'array 'collide-shape 256))
(define *blast-nova-box* (new 'global 'vector))

(deftype blast-nova (process-drawable)
  ((spawn-time   time-frame)
   (bot-handle   handle)
   )
  (:state-methods
    fuse
    active
    die
    )
  )

(defun blast-nova-blast ((owner process-drawable) (pos vector))
  ;; every valid target within the radius takes one hit (one attack id for the whole blast)
  (let ((box *blast-nova-box*)
        (hits *blast-nova-hits*)
        (id (new-attack-id))
        (n 0)
        )
    (vector-copy! box pos)
    (set! (-> box w) (+ *blast-nova-radius* 16384.0))
    (countdown (i (fill-actor-list-for-box *actor-hash* box hits 256))
      (let ((cs (as-type (-> hits i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (and (blast-bomb-valid-target? owner p)
                       (< (vector-vector-distance pos (get-trans p 3)) (+ *blast-nova-radius* 4096.0))
                       )
              (+! n 1)
              (send-event
                p
                'attack
                #f
                (static-attack-info ((id id)
                                     (damage *blast-nova-damage*)
                                     (vehicle-damage-factor 1.0)
                                     (vehicle-impulse-factor 1.0)
                                     (mode 'explode)
                                     (attacker (blast-ord-attacker owner))
                                     )
                                    )
                )
              )
            )
          )
        )
      )
    (format 0 "Super Nova: ~D targets hit~%" n)
    )
  (none)
  )

(define-extern spybot-nova-start (function process-drawable none))
(defun blast-nova-spybot-start ((owner process-drawable))
  ;; "become a spy-bot for 10 seconds": the droid from blastbot-spybot.gc, at the bot's position. It waits until the bot is
  ;; gone, parks Jak, takes the camera and (purple 3 secret) is invulnerable for 3 s.
  (spybot-nova-start owner)
  (none)
  )

(defbehavior blast-nova-detonate blast-nova ((owner process-drawable) (pos vector))
  ;; the explosion itself (fuse over): blast, effects, the bot goes away, the droid starts. The respawn timer starts here.
  (vector-copy! (-> self root trans) pos)
  (set-time! (-> self spawn-time))
  (blast-nova-blast owner pos)
  ;; the explosion: the stock huge explosion effect (visual only, the damage was dealt above) + the dark shot's burst
  (when (and group-kg-huge-explosion (nonzero? group-kg-huge-explosion))
    (let ((gp (new 'stack-no-clear 'explosion-init-params)))
      (vector-copy! (-> gp spawn-point) pos)
      (quaternion-identity! (-> gp spawn-quat))
      (set! (-> gp radius) 61440.0)
      (set! (-> gp scale) *blast-nova-fx-scale*)
      (set! (-> gp group) group-kg-huge-explosion)
      (set! (-> gp collide-with) (collide-spec))
      (set! (-> gp damage) 0.0)
      (set! (-> gp damage-scale) 1.0)
      (set! (-> gp vehicle-damage-factor) 1.0)
      (set! (-> gp vehicle-impulse-factor) 1.0)
      (set! (-> gp ignore-proc) (process->handle #f))
      (explosion-spawn gp self)
      )
    )
  (vector-copy! (-> *launch-matrix* trans) pos)
  (if (logtest? (-> group-gun-dark-shot-hit flags) (sp-group-flag sp13))
      (part-tracker-spawn part-tracker-subsampler :to *entity-pool* :group group-gun-dark-shot-hit)
      (part-tracker-spawn part-tracker :to *entity-pool* :group group-gun-dark-shot-hit)
      )
  (activate! *camera-smush-control* 2048.0 37 300 1.0 0.995 (-> self clock))
  ;; the bot goes away and Jak is released (the L1 + Triangle despawn)
  (despawn-my-bombbot)
  (blast-nova-spybot-start owner)
  0
  )

(defbehavior blast-nova-init-by-other blast-nova ((owner process-drawable) (pos vector))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (set! (-> self bot-handle) (process->handle owner))
  (set-time! (-> self spawn-time))
  (format 0 "Super Nova: fuse lit (~f s)~%" *blast-nova-fuse-time*)
  (go-virtual fuse)
  )

(defstate fuse (blast-nova)
  :virtual #t
  :trans (behavior ()
    (let ((bot (the-as blast-bot-player (handle->process (-> self bot-handle)))))
      (cond
        ((or (not bot) (<= (-> bot health) 0.0))
         (format 0 "Super Nova: cancelled, the bot is gone~%")
         (deactivate self)
         )
        ((time-elapsed? (-> self spawn-time) (the int (* *blast-nova-fuse-time* 300.0)))
         (let ((pos (new 'stack-no-clear 'vector)))
           (vector-copy! pos (-> bot root trans))
           (+! (-> pos y) 12288.0)
           (blast-nova-detonate bot pos)
           )
         (go-virtual active)
         )
        )
      )
    )
  :code sleep-code
  )

(defstate active (blast-nova)
  :virtual #t
  :enter (behavior ()
    (set-time! (-> self state-time))
    )
  :trans (behavior ()
    (if (time-elapsed? (-> self spawn-time) (the int (* *blast-nova-respawn-time* 300.0)))
        (go-virtual die)
        )
    )
  :code sleep-code
  )

(defstate die (blast-nova)
  :virtual #t
  :code (behavior ()
    (format 0 "Super Nova: respawning the bot~%")
    ;; Jak is still riding the spy droid (grab-ride). Same step spawn-my-bombbot takes when an old bot exists: grab first, so the
    ;; new bot's own grab-ride request takes him over. The droid hands him over and goes once the bot is there.
    (when (and *target* (= (blast-bot-jak-state) 'target-grab-ride))
      (send-event *target* 'change-mode 'grab #t)
      )
    (spawn-my-bombbot)
    (deactivate self)
    )
  )

(defun blast-bot-fire-supernova ((this blast-bot-player))
  (let ((pos (new 'stack-no-clear 'vector)))
    (vector-copy! pos (-> this root trans))
    (+! (-> pos y) 12288.0)
    (let ((p (process-spawn blast-nova
                            :init blast-nova-init-by-other this pos
                            :name "blast-nova"
                            :to *entity-pool*
                            )))
      (if p
          (set! *blast-nova-handle* (process->handle (ppointer->process p)))
          )
      )
    )
  (none)
  )

(defun blast-bot-fire-purple-arsenal ((this blast-bot-player))
  (case *blast-bot-purple-weapon*
    ((2)
     ;; Mass Inverter: an allied bombbot (bombbot-ally.gc) drops out of the sky next to you. One use before overheating; nothing is
     ;; spent while one is already alive.
     (when (and (< (bombbot-ally-count) *bombbot-ally-max*) (blast-bot-heat-try-use 1.0))
       (bombbot-ally-launch this)
       )
     )
    ((3)
     ;; Super Nova: the kamikaze. One use before overheating; nothing is spent while one is already going off.
     (when (and (not (handle->process *blast-nova-handle*)) (blast-bot-heat-try-use 1.0))
       (blast-bot-fire-supernova this)
       )
     )
    (else
      (if (blast-bot-heat-try-use *blast-bomb-uses*)   ;; Peace Maker: two bombs before overheating
          (blast-bot-fire-peacemaker this)
          )
      )
    )
  (none)
  )

(defun blast-bot-fire-shot ((this blast-bot-player))
  ;; morphgun only when the toggle is on AND Jak owns the selected colour; otherwise the old guard shot
  (if (and *blast-bot-use-morphgun* *target* (blast-bot-gun-owned? *blast-bot-gun-mode*))
      (case *blast-bot-gun-mode*
        ((1)
         (blast-bot-fire-yellow-arsenal this)
         )
        ((2)
         (blast-bot-fire-blue-arsenal this)
         )
        ((3)
         (blast-bot-fire-purple-arsenal this)
         )
        (else (blast-bot-fire-red-arsenal this))
        )
      (blast-bot-fire-guard-shot this)
      )
  (none)
  )

;; ---- Vulcan Fury (blue): hold R1 and the fire rate ramps up ----
(define *blast-bot-blue-slow* 0.25)       ;; seconds between shots when you first press
(define *blast-bot-blue-fast* 0.05)       ;; seconds between shots at full spin-up
(define *blast-bot-blue-ramp* 2.0)        ;; seconds of holding to get from slow to fast
(define *blast-bot-hold-start* (the-as time-frame 0))   ;; when the current hold began, 0 = not holding

(defun blast-bot-blue-interval ()
  (let* ((held (the float (- (current-time) *blast-bot-hold-start*)))
         (f (fmax 0.0 (fmin 1.0 (/ held (* 300.0 *blast-bot-blue-ramp*)))))
         (secs (+ *blast-bot-blue-slow* (* f (- *blast-bot-blue-fast* *blast-bot-blue-slow*))))
         )
    (the int (* 300.0 secs))
    )
  )

;; ---- R1 handling (called every frame by the bot's active state) ----
;; Blue (Vulcan Fury) fires while R1 is HELD and speeds up the longer you hold; every other weapon (Arc Wielder, Needle Lazer too) is one shot per press.
;; ---- Secret shop upgrades ----
;; The secrets menu (*menu-secrets-array*) only sells bits of (-> *game-info* purchase-secrets). Nothing happens when a
;; bit is bought; whoever checks the bit does the work. These functions are the Blast Bot's checks. The menu entries
;; are the stock ones (same slot, same bit, same cost, same unlock mission), so the doc's upgrades map like this:
;;   gun-upgrade-ammo-red/yellow/blue/dark : heat meter doubled for that colour
;;   gun-upgrade-red-1  Scattergun      : 7 x 4 grenades
;;   gun-upgrade-red-2  Wave Concussor  : second, inner ring (16 total)
;;   gun-upgrade-red-3  Plasmite RPG    : +5 spydroids (10 -> 15 per shot); max alive is *blast-bot-spydroid-max-upgraded* (doc: 30, kept at 20 for now)
;;   gun-upgrade-yellow-2 Beam Reflexor : ricochet
;;   gun-upgrade-yellow-3 Gyro Burster  : +1 sentinel (2 -> 3)
;;   gun-upgrade-blue-1 Vulcan Fury     : ramps to a faster fire rate
;;   gun-upgrade-blue-3 Needle Lazer    : +1 roboguard (1 -> 2)
;;   gun-upgrade-dark-1 Peace Maker     : each bomb splits into 3 smaller bombs, no impact splash (blastbot-ordnance.gc)
;;   gun-upgrade-dark-2 Mass Inverter   : lifesteal both ways between the bot and the allied bombbot (bombbot-ally.gc)
;;   endless-ammo (cheat)               : weapons never overheat
;;   invulnerable (cheat)               : *blast-bot-god-mode* (blastbot-main-mod.gc), the bot ignores all damage
(define *blast-bot-secrets-debug* #f)   ;; #t: print the upgrade set whenever it changes
(define *blast-bot-secrets-last* (the-as int -1))
;; Plasmite RPG upgrade: most spydroids alive at once. The doc says 30, but with more than about 20 droids on screen the
;; shadow renderer overflows (Shadow2.cpp assertion, game exits), so it stays at 20 until their shadows are dealt with.
(define *blast-bot-spydroid-max-upgraded* 20)
(define *blast-bot-blue-fast-upgraded* 0.03)   ;; Vulcan Fury upgrade: seconds between shots at full spin-up (stock 0.05)

(defmacro blast-bot-secret? (name)
  `(logtest? (-> *game-info* purchase-secrets) (game-secrets ,name))
  )

(defun blast-bot-secrets-apply ()
  ;; heat capacity belongs to the colour in hand
  (set! *blast-bot-heat-capacity*
        (case *blast-bot-gun-mode*
          ((0) (if (blast-bot-secret? gun-upgrade-ammo-red) 2.0 1.0))
          ((1) (if (blast-bot-secret? gun-upgrade-ammo-yellow) 2.0 1.0))
          ((2) (if (blast-bot-secret? gun-upgrade-ammo-blue) 2.0 1.0))
          ((3) (if (blast-bot-secret? gun-upgrade-ammo-dark) 2.0 1.0))
          (else 1.0)
          )
        )
  ;; red
  (if (blast-bot-secret? gun-upgrade-red-1)
      (begin (set! *blast-bot-scatter-cols* 7) (set! *blast-bot-scatter-rows* 4))
      (begin (set! *blast-bot-scatter-cols* 4) (set! *blast-bot-scatter-rows* 2))
      )
  (set! *blast-bot-wave-inner-ring* (blast-bot-secret? gun-upgrade-red-2))
  (if (blast-bot-secret? gun-upgrade-red-3)
      (begin (set! *spydroid-ally-count* 15) (set! *spydroid-ally-max* *blast-bot-spydroid-max-upgraded*))
      (begin (set! *spydroid-ally-count* 10) (set! *spydroid-ally-max* 20))
      )
  ;; yellow
  (set! *blast-bot-reflexor-ricochet* (blast-bot-secret? gun-upgrade-yellow-2))
  (set! *sentinel-ally-count* (if (blast-bot-secret? gun-upgrade-yellow-3) 3 2))
  ;; blue
  (set! *blast-bot-blue-fast* (if (blast-bot-secret? gun-upgrade-blue-1) *blast-bot-blue-fast-upgraded* 0.05))
  (set! *roboguard-ally-count* (if (blast-bot-secret? gun-upgrade-blue-3) 2 1))
  ;; purple 2: Mass Inverter lifesteal (gun-upgrade-dark-2). Only ever turns ON, like god mode.
  (when (blast-bot-secret? gun-upgrade-dark-2)
    (set! *blast-lifesteal* #t)
    )
  ;; purple 1: Peace Maker bombs split into 3 smaller ones without splash (blast-bomb-launch)
  (set! *blast-bomb-split* (blast-bot-secret? gun-upgrade-dark-1))
  ;; yellow 1: Blaster auto-mode (the switch itself is blast-bot-auto-toggle). Like god mode these only ever turn ON, so the
  ;; REPL can still force them for testing without buying anything.
  (when (blast-bot-secret? gun-upgrade-yellow-1)
    (set! *blast-bot-auto-unlocked* #t)
    )
  ;; blue 2: Arc Wielder chains between the companions (blastbot-ordnance.gc)
  (when (blast-bot-secret? gun-upgrade-blue-2)
    (set! *blast-arc-chain* #t)
    )
  ;; cheat: Homing Attacks
  (when (blast-bot-secret? darkjak-tracking)
    (set! *blast-homing* #t)
    )
  ;; cheat
  (set! *blast-bot-unlimited-ammo* (blast-bot-secret? endless-ammo))
  ;; invulnerable: only ever turns god mode ON, so (set! *blast-bot-god-mode* #t) from the REPL still works without the purchase
  (when (blast-bot-secret? invulnerable)
    (set! *blast-bot-god-mode* #t)
    )
  (when *blast-bot-secrets-debug*
    (let ((sig (+ (* 1000 *spydroid-ally-count*) (* 100 *sentinel-ally-count*) (* 10 *roboguard-ally-count*)
                  (if *blast-bot-unlimited-ammo* 1 0))))
      (when (!= sig *blast-bot-secrets-last*)
        (set! *blast-bot-secrets-last* sig)
        (format 0 "Blast Bot secrets: spydroids ~D (max ~D), sentinels ~D, roboguards ~D, unlimited ~A, heat x~f~%"
                *spydroid-ally-count* *spydroid-ally-max* *sentinel-ally-count* *roboguard-ally-count*
                *blast-bot-unlimited-ammo* *blast-bot-heat-capacity*)
        )
      )
    )
  (none)
  )

;; ---- Peace Maker charge: hold R1 to charge, release to fire. Up to 2x the size and the damage of the bomb ----
;; The heat builds while you hold: a bomb costs 1/*blast-bomb-uses* of the meter, and that cost is paid gradually over the
;; charge (a quick tap pays the rest when you let go, so every bomb costs the same). No cooling while the button is down.
(define *blast-bomb-charge-time* 1.5)     ;; seconds of holding for a full charge
(define *blast-bomb-charge-start* (the-as time-frame 0))   ;; when the current charge began, 0 = not charging
(define *blast-bomb-charge-heat* 0.0)     ;; heat already added by the current charge

(defun blast-bot-purple-cost ()
  (/ 1.0 (* *blast-bomb-uses* *blast-bot-heat-capacity*))
  )

(define *blast-bomb-charge-dark-parts* #f)   ;; #t: also launch the dark gun's own charge particles (part ids 258..261). Crashed the game, so off.

(defun blast-bot-purple-charge-fx ((this blast-bot-player) (f float))
  ;; the glowing ball at the muzzle, growing with the charge
  (let* ((muzzle-matrix (matrix-copy! (new 'stack-no-clear 'matrix)
                                     (-> this node-list data 6 bone transform)))
         (pos (matrix->trans muzzle-matrix (new 'stack-no-clear 'vector)))
         (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> muzzle-matrix fvec) 1.0))
         )
    (vector+*! pos pos dir 8192.0)
    (blast-bomb-charge-ball pos dir f)
    (when (and *blast-bomb-charge-dark-parts*
               (-> *part-id-table* 258) (-> *part-id-table* 259) (-> *part-id-table* 260) (-> *part-id-table* 261))
      (set! (-> *part-id-table* 260 init-specs 2 initial-valuef) (lerp 409.6 9216.0 f))
      (set! (-> *part-id-table* 260 init-specs 8 initial-valuef) (lerp 0.0 32.0 f))
      (set! (-> *part-id-table* 261 init-specs 2 initial-valuef) (lerp 409.6 32768.0 f))
      (set! (-> *part-id-table* 261 init-specs 8 initial-valuef) (lerp 0.0 16.0 f))
      (set! (-> *part-id-table* 259 init-specs 2 initial-valuef) (lerp 409.6 8192.0 f))
      (set! (-> *part-id-table* 258 init-specs 1 initial-valuef) (lerp 0.1 1.0 f))
      (set! (-> *part-id-table* 258 init-specs 2 initial-valuef) (lerp 409.6 3686.4 f))
      (launch-particles (-> *part-id-table* 258) pos)
      (launch-particles (-> *part-id-table* 259) pos)
      (launch-particles (-> *part-id-table* 260) pos)
      (launch-particles (-> *part-id-table* 261) pos)
      )
    )
  (none)
  )

(defun blast-bot-purple-add-heat ((amount float))
  ;; heat from the charge; reaching 1.0 overheats like any other shot
  (when (and (not *blast-bot-unlimited-ammo*) (< 0.0 amount))
    (+! *blast-bot-heat* amount)
    (set-time! *blast-bot-last-use*)
    (when (>= *blast-bot-heat* 0.999)
      (set! *blast-bot-heat* 1.0)
      (set! *blast-bot-overheated* #t)
      (format 0 "Blast Bot: OVERHEAT~%")
      )
    )
  (none)
  )

(defun blast-bot-purple-release ((this blast-bot-player) (f float))
  ;; let go (or overheated): pay what the charge has not paid yet, then throw the bomb at 1x..2x
  (set! *blast-bomb-charge-start* 0)
  (blast-bot-purple-add-heat (- (blast-bot-purple-cost) *blast-bomb-charge-heat*))
  (set! *blast-bomb-charge-heat* 0.0)
  (set! (-> this next-shot) (+ (current-time) (seconds 0.2)))
  (set! *blast-bomb-charge* (+ 1.0 f))
  (blast-bot-fire-peacemaker this)
  (set! *blast-bomb-charge* 1.0)
  (set! (-> this shield-open-until) (+ (current-time) (seconds 0.15)))
  (none)
  )

(defun blast-bot-purple-charge-update ((this blast-bot-player))
  (blast-bot-peacemaker-aim-track this)
  (let* ((held (the float (- (current-time) *blast-bomb-charge-start*)))
         (f (if (= *blast-bomb-charge-start* 0)
                0.0
                (fmax 0.0 (fmin 1.0 (/ held (* 300.0 *blast-bomb-charge-time*))))
                ))
         )
    (cond
      ((cpad-hold? 0 r1)
       (cond
         ((= *blast-bomb-charge-start* 0)
          ;; start charging, unless the weapon is locked
          (cond
            ((and *blast-bot-overheated* (not *blast-bot-unlimited-ammo*))
             (when (time-elapsed? *blast-bot-warn-time* (seconds 1))
               (set-time! *blast-bot-warn-time*)
               (format 0 "Blast Bot: overheated~%")
               )
             )
            ((>= (+ (current-time) (seconds -0.02)) (-> this next-shot))
             (set! *blast-bomb-charge-start* (current-time))
             (set! *blast-bomb-charge-heat* 0.0)
             )
            )
          )
         (else
           ;; charging: the ball grows and the meter fills
           (blast-bot-purple-charge-fx this f)
           (let ((want (* (blast-bot-purple-cost) f)))
             (blast-bot-purple-add-heat (- want *blast-bomb-charge-heat*))
             (set! *blast-bomb-charge-heat* want)
             )
           (set-time! *blast-bot-last-use*)
           (format *stdcon* "PEACE MAKER CHARGE ~D%~%" (the int (* 100.0 f)))
           (when *blast-bot-overheated*
             (blast-bot-purple-release this f)      ;; the meter is full: it goes off now
             )
           )
         )
       )
      ((!= *blast-bomb-charge-start* 0)
       (blast-bot-purple-release this f)
       )
      )
    )
  (none)
  )

(defun blast-bot-lifesteal-apply ((this blast-bot-player))
  ;; Mass Inverter lifesteal: heal the bot with what the allied bombbot has dealt since last frame
  (when *blast-lifesteal*
    (when (zero? (bombbot-ally-count))
      (set! *blast-lifesteal-to-ally* 0.0)     ;; nothing is banked for an ally that is not there
      )
    (when (and (< 0.0 *blast-lifesteal-to-bot*) (< 0.0 (-> this health)))
      (set! (-> this health) (fmin (-> this max-health) (+ (-> this health) *blast-lifesteal-to-bot*)))
      )
    )
  (set! *blast-lifesteal-to-bot* 0.0)
  (none)
  )

(defun blast-bot-fire-input ((this blast-bot-player))
  (blast-bot-secrets-apply)
  (blast-bot-lifesteal-apply this)
  (blast-bot-auto-toggle)
  (let ((blue (and *blast-bot-use-morphgun* *target* (= *blast-bot-gun-mode* 2) (blast-bot-gun-owned? 2)
                   (!= *blast-bot-blue-weapon* 2) (!= *blast-bot-blue-weapon* 3)))
        (purple (and *blast-bot-use-morphgun* *target* (= *blast-bot-gun-mode* 3) (blast-bot-gun-owned? 3)
                     (= *blast-bot-purple-weapon* 1)))   ;; the charge-and-release path is the Peace Maker's only; Mass Inverter is one press per shot (blast-bot-fire-purple-arsenal)
        )
    (cond
      ((not (cpad-hold? 0 r1))
       (set! *blast-bot-hold-start* 0)
       )
      ((= *blast-bot-hold-start* 0)
       (set! *blast-bot-hold-start* (current-time))
       )
      )
    (set! blue (and blue (cpad-hold? 0 r1)))
    (if purple
        (blast-bot-purple-charge-update this)
        (set! *blast-bomb-charge-start* 0)
        )
    (when (and (not purple)
               (or blue (cpad-pressed? 0 r1))
               (>= (+ (current-time) (seconds -0.02)) (-> this next-shot)))
      (set! (-> this next-shot) (+ (current-time) (if blue (blast-bot-blue-interval) (seconds 0.2))))
      (blast-bot-fire-shot this)
      (set! (-> this shield-open-until) (+ (current-time) (seconds 0.15)))
      )
    )
  (none)
  )