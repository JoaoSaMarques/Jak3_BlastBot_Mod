;;-*-Lisp-*-
(in-package goal)

;; name: blastbot-ordnance.gc
;; name in dgo: blastbot-ordnance
;; dgos: GAME

;; The Blast Bot's two "gunship" weapons, rebuilt so they work in EVERY level.
;;   - Gyro Burster (yellow 3): homing missiles (the KG transport's missile, cty-homing-missile) next to the sentinels.
;;   - Arc Wielder  (blue 2)  : 4 rotating lasers (the KG transport's spinning laser). They last until they have turned
;;                              one full 360 degrees, then they switch off.
;;
;; protect-gunship.gc itself is only loaded inside LCTYPROT, so its missile process, particles and beam do not exist
;; anywhere else. This file does not use any of that code:
;;   - the missile is a small process of its own (same pattern as sentinel-ally.gc) that flies and steers by hand;
;;   - the beams are drawn with part 2059, the laser pointer beam from mod-common-functions.gc;
;;   - the explosion is group-gun-dark-shot-hit, the same group the stock missile uses (gun-dark-shot.gc, in GAME).
;;
;; WHO GETS HIT: both weapons use ONE target rule, blast-ord-valid-target?, the same rule as spydroid-ally and sentinel-ally:
;; enemies / metalheads / KG robots only. Civilians, crates, Jak, the bot, the allies and every type listed in
;; *spydroid-ally-ignore-types* (crimson-guard, the wastelanders, ...) are never aimed at and never damaged, not even by the
;; blast of a missile that explodes next to them. Add a type name to that list and it applies to everything here too.
;; The exception is the Peace Maker bomb (blast-bomb-valid-target?): it hurts the same things the red / yellow / blue shots do.
;;
;; Needs, in game.gd:
;;   "blastbot-ordnance.o"      after sentinel-ally.o, before mod-common-functions.o
;;   "cty-homing-missile-ag.go" in the art group list at the end (next to kg-flying-turret-ag.go)
;; and in jak3_config.jsonc, common_art_groups:  "cty-homing-missile-ag"
;; (if the model is not there the missiles still fly and explode, you just see the red streak and no model: set
;; *blast-missile-model* to #f to leave the model out completely)
;;
;; Called from blastbot_guns.gc: blast-missile-launch (Gyro Burster), blast-arc-launch / blast-arc-update (Arc Wielder).

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Knobs (change from the REPL, no rebuild needed)
;;;;;;;;;;;;;;;;;;;;;;;;;;

;; ---- missiles ----
(define *blast-missile-count* 6)                 ;; missiles per Gyro Burster use
(define *blast-missile-free-count* 3)            ;; missiles when there is no enemy to aim at (they fly straight ahead)
(define *blast-missile-range* 409600.0)          ;; 100 m: how far they look for enemies, measured from the bot
(define *blast-missile-damage* 4.0)              ;; damage of the blast
(define *blast-missile-radius* 24576.0)          ;; 6 m blast radius
(define *blast-missile-hit-dist* 12288.0)        ;; 3 m: closer than this to the target centre and it detonates
(define *blast-missile-speed-start* 61440.0)     ;; 15 m/s at launch
(define *blast-missile-speed* 245760.0)          ;; 60 m/s cruise speed
(define *blast-missile-accel* 307200.0)          ;; how fast it gets there (units/s^2)
(define *blast-missile-climb-time* 0.4)          ;; seconds they fly straight up and out before they start homing
(define *blast-missile-turn-rate* 5.0)           ;; homing sharpness (higher = tighter turns)
(define *blast-missile-life* 5.0)                ;; seconds before a missile detonates on its own
(define *blast-missile-free-life* 1.5)           ;; same, for the ones without a target
(define *blast-missile-fan-side* 0.5)            ;; how far the missiles splay sideways when they leave the bot
(define *blast-missile-spawn-spread* 4096.0)     ;; 1 m: spacing between the launch points
(define *blast-missile-spawn-height* 24576.0)    ;; 6 m above the bot's position
(define *blast-missile-scale* 1.0)               ;; model size (the stock gunship missile is 0.8 / 0.8 / 0.9 at 1.0)
(define *blast-missile-model* #t)                ;; #f = no model, only the streak
(define *blast-missile-streak* #t)               ;; the red streak behind each missile
(define *blast-missile-streak-len* 16384.0)      ;; 4 m
(define *blast-missile-streak-width* 1024.0)     ;; game units (4096 = 1 m), NOT metres: the laser pointer uses 1228.8
(define *blast-ord-credit-jak* #t)               ;; #t: their kills count as Jak's (same idea as *sentinel-ally-credit-jak*)
(define *blast-ord-debug* #f)                    ;; #t: print launch / explode lines (set to #f once it works)

;; ---- rotating lasers ----
(define *blast-arc-beams* 4)                     ;; doc: 4 rotating lasers (the stock ship uses 2 to 4)
(define *blast-arc-speed* 21845.0)               ;; turn speed in internal angle units per second: 21845 = 120 deg/s = 3 s for a full turn
(define *blast-arc-length* 245760.0)             ;; 60 m: longest a beam can get (it stops at walls)
(define *blast-arc-height* 18432.0)              ;; 4.5 m: the lasers leave at "body height" = this far above the bot's position (its hip)
(define *blast-arc-drop-height* 8192.0)          ;; 2 m: how far they arc down from the start (half of a 4 m leg), then run level
(define *blast-arc-level-dist* 8192.0)           ;; 2 m: they run level at body height for this far from the start before the arc begins
(define *blast-arc-drop-dist* 16384.0)           ;; 4 m: how far the arc itself takes to come down (shorter = steeper); flat at the low height after that
(define *blast-arc-damage* 1.0)                  ;; doc: 1
(define *blast-arc-pulse-gap* 0.1)               ;; seconds between damage pulses (without this an enemy takes a hit every frame)
(define *blast-arc-tol-y* 8192.0)                ;; 2 m (+ the enemy's radius): how far above / below the beam an enemy still gets hit
;; the bolt: a jagged chain of short beam segments, redrawn with new random kinks every frame (crackling lightning).
;; Two passes per segment: a wide dim glow, then a thin bright core. Widths are in GAME UNITS (4096 = 1 m), NOT metres.
(define *blast-arc-inner* 6144.0)               ;; 1.5 m: the lasers start this far from the bot's centre, in the direction they point
(define *blast-arc-seg-len* 6144.0)              ;; 1.5 m per kink: shorter = more detailed bolt, more particles
(define *blast-arc-segs* 20)                     ;; most segments one bolt may have (4 bolts x 2 passes x this = particles per frame)
(define *blast-arc-jitter* 3072.0)               ;; 0.75 m: how far the kinks stray sideways (largest mid-bolt, zero at both ends)
(define *blast-arc-glow-width* 1843.2)           ;; 0.45 m
(define *blast-arc-glow-r* 0.0)                  ;; glow colour (0..255)
(define *blast-arc-glow-g* 60.0)
(define *blast-arc-glow-b* 255.0)
(define *blast-arc-glow-a* 90.0)
(define *blast-arc-core-width* 512.0)            ;; 0.125 m
(define *blast-arc-core-r* 220.0)                ;; core colour: near white with a blue tint
(define *blast-arc-core-g* 235.0)
(define *blast-arc-core-b* 255.0)
(define *blast-arc-core-a* 255.0)

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Scratch memory. Global, never on the stack: the bot calls all of this from deep inside its state code.
;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *blast-missile-mat* (new 'global 'matrix))
(define *blast-missile-tmp* (new 'global 'vector))
(define *blast-missile-tmp2* (new 'global 'vector))
(define *blast-missile-tail* (new 'global 'vector))
(define *blast-missile-pos* (new 'global 'vector))
(define *blast-missile-dir* (new 'global 'vector))
(define *blast-missile-hitpos* (new 'global 'vector))
(define *blast-missile-box* (new 'global 'vector))
(define *blast-missile-hits* (new 'global 'array 'collide-shape 128))
(define *blast-missile-query* (new 'global 'collide-query))

(define *blast-arc-active* #f)
(define *blast-arc-angle* 0.0)                   ;; where beam 0 points now (internal angle units, 0..65536)
(define *blast-arc-swept* 0.0)                   ;; how far the lasers have turned so far (65536 = one full turn)
(define *blast-arc-acc* 0.0)                     ;; turned since the last damage pulse
(define *blast-arc-pulse-time* (the-as time-frame 0))
(define *blast-arc-seen-time* (the-as time-frame 0))   ;; last frame blast-arc-update ran (a stale arc switches itself off)
(define *blast-arc-debug-time* (the-as time-frame 0))
(define *blast-arc-start* (new 'global 'vector))
(define *blast-arc-extent* (new 'global 'vector))
(define *blast-arc-end* (new 'global 'vector))
(define *blast-arc-bstart* (new 'global 'vector))
(define *blast-arc-pdrop* (new 'global 'vector))
(define *blast-arc-ground-y* -4096000000.0)     ;; ground under the bot, written by the bot every frame (blast-bot-yellow-update)
(define *blast-arc-y-body* 0.0)                  ;; world height of the lasers at their start (worked out every frame)
(define *blast-arc-y-low* 0.0)                   ;; world height of the lasers once the arc is down
(define *blast-arc-prev* (new 'global 'vector))
(define *blast-arc-cur* (new 'global 'vector))
(define *blast-arc-seg* (new 'global 'vector))
(define *blast-arc-box* (new 'global 'vector))
(define *blast-arc-hits* (new 'global 'array 'collide-shape 128))
(define *blast-arc-lens* (new 'global 'array 'float 8))
(define *blast-arc-query* (new 'global 'collide-query))

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Shared: who may be hit, who gets the credit
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun blast-ord-valid-target? ((owner process) (p process-focusable))
  ;; same rule as spydroid-ally-valid-target? / sentinel-ally-valid-target?
  (and p
       (!= p *target*)
       (!= p owner)
       (not (type? p spydroid-ally))
       (not (type? p sentinel-ally))
       (not (focus-test? p inactive))
       (not (blast-target-dead? p))
       (logtest? (process-mask enemy guard metalhead kg-robot vehicle) (-> p mask))
       (not (logtest? (process-mask crate civilian) (-> p mask)))
       (not (spydroid-ally-ignored-type? p))
       (not (logtest? (-> p focus-status) (focus-status disable dead ignore grabbed)))
       )
  )

(defun blast-ord-attacker ((owner process))
  ;; who the enemies think hit them
  (if (and *target* *blast-ord-credit-jak*)
      (process->handle *target*)
      (process->handle owner)
      )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Missiles
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defskelgroup skel-blast-missile cty-homing-missile cty-homing-missile-lod0-jg cty-homing-missile-idle-ja
              ((cty-homing-missile-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 3)
              :texture-level 10
              :origin-joint-index 3
              )

(deftype blast-missile (process-drawable)
  ((owner-handle   handle)      ;; the bot that launched it
   (target-handle  handle)      ;; the enemy it chases
   (spawn-time     time-frame)
   (fly-dir        vector  :inline)   ;; unit vector, where it is heading
   (dest-pos       vector  :inline)   ;; last known position of the target
   (fly-speed      float)
   (has-target     symbol)
   (climb-time     float)       ;; seconds of straight flight before it starts to home
   (max-life       float)       ;; seconds before it detonates by itself
   )
  (:state-methods
    active
    die
    )
  )

(defun blast-missile-explode ((this blast-missile) (pos vector))
  ;; the blast: the stock missile's own effect, plus damage to every valid enemy inside the radius
  (vector-copy! (-> *launch-matrix* trans) pos)
  (if (logtest? (-> group-gun-dark-shot-hit flags) (sp-group-flag sp13))
      (part-tracker-spawn part-tracker-subsampler :to *entity-pool* :group group-gun-dark-shot-hit)
      (part-tracker-spawn part-tracker :to *entity-pool* :group group-gun-dark-shot-hit)
      )
  (let ((owner (handle->process (-> this owner-handle)))
        (id (new-attack-id))
        (box *blast-missile-box*)
        (hits *blast-missile-hits*)
        (n 0)
        )
    (vector-copy! box pos)
    (set! (-> box w) (* 2.0 *blast-missile-radius*))
    (countdown (i (fill-actor-list-for-box *actor-hash* box hits 128))
      (let ((cs (as-type (-> hits i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (and (blast-ord-valid-target? owner p)
                       (< (vector-vector-distance pos (get-trans p 3)) (+ *blast-missile-radius* 4096.0))
                       )
              (+! n 1)
              (blast-lifesteal-dealt *blast-missile-damage* #f)
              (send-event
                p
                'attack
                #f
                (static-attack-info ((id id)
                                     (damage *blast-missile-damage*)
                                     (vehicle-damage-factor 1.0)
                                     (vehicle-impulse-factor 1.0)
                                     (attacker (blast-ord-attacker owner))
                                     )
                                    )
                )
              )
            )
          )
        )
      )
    (if *blast-ord-debug*
        (format 0 "missile: exploded, ~D enemies in the blast~%" n)
        )
    )
  (go (method-of-object this die))
  (none)
  )

(defun blast-missile-wall-hit ((this blast-missile) (stp float))
  ;; #t (and *blast-missile-hitpos* filled in) when this frame's step would cross level geometry
  (let ((q *blast-missile-query*))
    (vector-copy! (-> q start-pos) (-> this root trans))
    (vector-float*! (-> q move-dist) (-> this fly-dir) (+ stp 2048.0))
    (set! (-> q radius) 409.6)
    (set! (-> q collide-with) (collide-spec backgnd))
    (set! (-> q ignore-process0) (handle->process (-> this owner-handle)))
    (set! (-> q ignore-process1) #f)
    (set! (-> q ignore-pat)
          (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> q action-mask) (collide-action solid))
    (let ((hit (fill-and-probe-using-line-sphere *collide-cache* q)))
      (when (>= hit 0.0)
        (vector+float*! *blast-missile-hitpos* (-> q start-pos) (-> q move-dist) hit)
        )
      (>= hit 0.0)
      )
    )
  )

(defun blast-missile-streak ((this blast-missile))
  ;; a red streak behind the missile: the laser pointer's beam part, short and thick
  (when *blast-missile-streak*
    (vector+float*! *blast-missile-tail* (-> this root trans) (-> this fly-dir) (- *blast-missile-streak-len*))
    (vector-float*! *blast-missile-tmp2* (-> this fly-dir) *blast-missile-streak-len*)
    (set! (-> *part-id-table* 2059 init-specs 5 initial-valuef) 255.0)
    (set! (-> *part-id-table* 2059 init-specs 7 initial-valuef) 0.0)
    (set! (-> *part-id-table* 2059 init-specs 3 initial-valuef) *blast-missile-streak-width*)
    (set! (-> *part-id-table* 2059 init-specs 3 random-rangef) 0.0)
    (draw-beam (-> *part-id-table* 2059) *blast-missile-tail* *blast-missile-tmp2* #t)
    )
  (none)
  )

(defun blast-missile-update ((this blast-missile))
  ;; once per frame from the active state's :trans
  (let* ((dt (seconds-per-frame))
         (age (/ (the float (- (current-time) (-> this spawn-time))) 300.0))
         (pos (-> this root trans))
         (dir (-> this fly-dir))
         (tmp *blast-missile-tmp*)
         )
    ;; follow the target while it is alive; afterwards the missile keeps going to where it died
    (when (-> this has-target)
      (let ((p (as-type (handle->process (-> this target-handle)) process-focusable)))
        (when (and p (not (logtest? (-> p focus-status) (focus-status disable dead))))
          (vector-copy! (-> this dest-pos) (get-trans p 3))
          )
        )
      )
    (seek! (-> this fly-speed) *blast-missile-speed* (* *blast-missile-accel* dt))
    ;; homing: bend the heading towards the target, but only after the climb
    (when (and (-> this has-target) (< (-> this climb-time) age))
      (vector-! tmp (-> this dest-pos) pos)
      (vector-normalize! tmp 1.0)
      (vector-! tmp tmp dir)
      (vector-float*! tmp tmp (fmin 1.0 (* *blast-missile-turn-rate* dt)))
      (vector+! dir dir tmp)
      (vector-normalize! dir 1.0)
      )
    (let ((stp (* (-> this fly-speed) dt)))
      (cond
        ((and (< 0.1 age) (blast-missile-wall-hit this stp))
         (blast-missile-explode this *blast-missile-hitpos*)
         )
        (else
          (vector+float*! pos pos dir stp)
          (matrix-f-compose *blast-missile-mat* dir)
          (matrix->quaternion (-> this root quat) *blast-missile-mat*)
          (blast-missile-streak this)
          (cond
            ((and (-> this has-target)
                  (< (vector-vector-distance pos (-> this dest-pos)) *blast-missile-hit-dist*)
                  )
             (blast-missile-explode this pos)
             )
            ((< (-> this max-life) age)
             (blast-missile-explode this pos)
             )
            )
          )
        )
      )
    )
  (none)
  )

(defstate active (blast-missile)
  :virtual #t
  :enter (behavior ()
    (set-time! (-> self state-time))
    )
  :trans (behavior ()
    (blast-missile-update self)
    )
  :code sleep-code
  :post (behavior ()
    (if (nonzero? (-> self draw))
        (ja-post)
        )
    )
  )

(defstate die (blast-missile)
  :virtual #t
  :code (behavior ()
    (deactivate self)
    )
  )

(defbehavior blast-missile-init-by-other blast-missile ((owner process-drawable) (pos vector) (dir vector) (target process-focusable) (climb float))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (vector-copy! (-> self fly-dir) dir)
  (vector-normalize! (-> self fly-dir) 1.0)
  (matrix-f-compose *blast-missile-mat* (-> self fly-dir))
  (matrix->quaternion (-> self root quat) *blast-missile-mat*)
  (set-vector! (-> self root scale)
               (* 0.8 *blast-missile-scale*)
               (* 0.8 *blast-missile-scale*)
               (* 0.9 *blast-missile-scale*)
               1.0)
  (when *blast-missile-model*
    (initialize-skeleton self skel-blast-missile (the-as pair 0))
    )
  (set! (-> self owner-handle) (process->handle owner))
  (set! (-> self fly-speed) *blast-missile-speed-start*)
  (set! (-> self climb-time) climb)
  (cond
    (target
      (set! (-> self has-target) #t)
      (set! (-> self target-handle) (process->handle target))
      (vector-copy! (-> self dest-pos) (get-trans target 3))
      (set! (-> self max-life) *blast-missile-life*)
      )
    (else
      (set! (-> self has-target) #f)
      (set! (-> self target-handle) (the-as handle #f))
      (set! (-> self max-life) *blast-missile-free-life*)
      )
    )
  (set-time! (-> self spawn-time))
  (go-virtual active)
  )

(defun blast-missile-spawn ((owner process-drawable) (pos vector) (dir vector) (target process-focusable) (climb float))
  (process-spawn blast-missile
                 :init blast-missile-init-by-other owner pos dir target climb
                 :name "blast-missile"
                 :to *entity-pool*
                 )
  (none)
  )

(defun blast-missile-next-target ((owner process-drawable) (min-d float))
  ;; the nearest valid enemy that is farther away than min-d (so repeated calls walk outwards through the enemies), or #f
  (let ((best (the-as process-focusable #f))
        (best-d 0.0)
        (box *blast-missile-box*)
        (hits *blast-missile-hits*)
        )
    (vector-copy! box (-> owner root trans))
    (set! (-> box w) *blast-missile-range*)
    (countdown (i (fill-actor-list-for-box *actor-hash* box hits 128))
      (let ((cs (as-type (-> hits i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (blast-ord-valid-target? owner p)
              (let ((d (vector-vector-distance (-> owner root trans) (-> p root trans))))
                (when (and (< min-d d) (or (not best) (< d best-d)))
                  (set! best p)
                  (set! best-d d)
                  )
                )
              )
            )
          )
        )
      )
    best
    )
  )

(defun blast-missile-fire-one ((owner process-drawable) (face float) (i int) (n int) (target process-focusable))
  ;; one missile leaves the bot's top, splayed sideways by its number; with a target it climbs first, without it flies ahead
  (let ((pos *blast-missile-pos*)
        (dir *blast-missile-dir*)
        (fan (- (the float i) (* 0.5 (the float (+ n -1)))))
        )
    (set-vector! pos (* *blast-missile-spawn-spread* fan) *blast-missile-spawn-height* 0.0 1.0)
    (vector-rotate-around-y! pos pos face)
    (vector+! pos pos (-> owner root trans))
    (if target
        (set-vector! dir (* *blast-missile-fan-side* fan) 1.0 0.35 1.0)
        (set-vector! dir (* *blast-missile-fan-side* fan) 0.25 1.0 1.0)
        )
    (vector-rotate-around-y! dir dir face)
    (blast-missile-spawn owner pos dir target (if target *blast-missile-climb-time* 0.0))
    )
  (none)
  )

(defun blast-missile-launch ((owner process-drawable))
  ;; Gyro Burster: *blast-missile-count* missiles, each on its own enemy (nearest first). With fewer enemies than missiles
  ;; the enemies are used again, nearest first. No enemy at all: a few missiles fly straight ahead.
  (let ((count *blast-missile-count*)
        (spawned 0)
        (rounds 0)
        (face (quaternion-y-angle (-> owner root quat)))
        )
    (while (and (< spawned count) (< rounds 4))
      (+! rounds 1)
      (let ((prev -1.0)
            (more #t)
            )
        (while (and more (< spawned count))
          (let ((p (blast-missile-next-target owner prev)))
            (cond
              (p
               (set! prev (vector-vector-distance (-> owner root trans) (-> p root trans)))
               (blast-missile-fire-one owner face spawned count p)
               (+! spawned 1)
               )
              (else
                (set! more #f)
                )
              )
            )
          )
        )
      (if (zero? spawned)
          (set! rounds 99)
          )
      )
    (when (zero? spawned)
      (dotimes (i *blast-missile-free-count*)
        (blast-missile-fire-one owner face i *blast-missile-free-count* (the-as process-focusable #f))
        )
      )
    (if *blast-ord-debug*
        (format 0 "missile: launched ~D homing~%" spawned)
        )
    )
  (none)
  )

(defun blast-missile-clear ()
  ;; REPL: removes every missile in flight
  (let ((p (-> *entity-pool* child)))
    (while p
      (let ((next (-> p 0 brother))
            (proc (the-as process (-> p 0)))
            )
        (if (type? proc blast-missile)
            (deactivate proc)
            )
        (set! p next)
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Rotating lasers (Arc Wielder)
;;;;;;;;;;;;;;;;;;;;;;;;;;
;; No process: the bot calls blast-arc-update every frame (from blast-bot-yellow-update). The lasers turn at
;; *blast-arc-speed* until the total turn reaches 65536 (one full 360), then they stop. Damage comes in pulses every
;; *blast-arc-pulse-gap* seconds; a pulse hits every valid enemy that the beams swept over since the last pulse (so a fast turn
;; cannot jump over somebody), as long as the enemy is inside the beam's length (walls shorten it).

;; The beam part 2059 is shared with the laser pointer, which only ever sets its colour (r, b) and width. Everything else
;; changed here is put back by blast-arc-style-restore at the end of the frame.
(defun blast-arc-style ((r float) (g float) (b float) (w float) (a float) (seg-len float))
  (set! (-> *part-id-table* 2059 init-specs 5 initial-valuef) r)
  (set! (-> *part-id-table* 2059 init-specs 6 initial-valuef) g)
  (set! (-> *part-id-table* 2059 init-specs 7 initial-valuef) b)
  (set! (-> *part-id-table* 2059 init-specs 3 initial-valuef) w)
  (set! (-> *part-id-table* 2059 init-specs 3 random-rangef) 0.0)
  (set! (-> *part-id-table* 2059 init-specs 4 initial-valuef) seg-len)
  (set! (-> *part-id-table* 2059 init-specs 8 initial-valuef) a)
  (set! (-> *part-id-table* 2059 init-specs 8 random-rangef) 0.0)
  (none)
  )

(defun blast-arc-style-restore ()
  (set! (-> *part-id-table* 2059 init-specs 6 initial-valuef) 0.0)
  (set! (-> *part-id-table* 2059 init-specs 4 initial-valuef) 163840.0)
  (set! (-> *part-id-table* 2059 init-specs 8 initial-valuef) 64.0)
  (set! (-> *part-id-table* 2059 init-specs 8 random-rangef) 32.0)
  (none)
  )

(defun blast-arc-y-at ((d float))
  ;; height of the lasers at horizontal distance d past their start: level at body height for *blast-arc-level-dist*, then a
  ;; smooth arc (level at both ends) down to the low height over *blast-arc-drop-dist*, level at the low height from there to the end
  (let ((frac (fmax 0.0 (fmin 1.0 (/ (- d *blast-arc-level-dist*) (fmax 1.0 *blast-arc-drop-dist*))))))
    (- *blast-arc-y-body* (* (- *blast-arc-y-body* *blast-arc-y-low*) 0.5 (- 1.0 (cos (* 32768.0 frac)))))
    )
  )

(defun blast-arc-probe ((this process-drawable) (from vector) (move vector))
  ;; how far along move (0..1) a line from `from` gets before it hits level geometry, negative if it never does
  (let ((q *blast-arc-query*))
    (vector-copy! (-> q start-pos) from)
    (vector-copy! (-> q move-dist) move)
    (set! (-> q radius) 40.96)
    (set! (-> q collide-with) (collide-spec backgnd obstacle pusher))
    (set! (-> q ignore-process0) this)
    (set! (-> q ignore-process1) #f)
    (set! (-> q ignore-pat)
          (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> q action-mask) (collide-action solid))
    (fill-and-probe-using-line-sphere *collide-cache* q)
    )
  )

(defun blast-arc-draw-bolt ((start vector) (sx float) (cz float) (blen float))
  ;; one lightning bolt: from start, horizontally along (sx, cz) for blen, following the height profile of blast-arc-y-at.
  ;; Short segments with random sideways / vertical kinks that are strongest in the middle and zero at both ends, so the
  ;; bolt stays attached to its two end points.
  (let* ((n (max 3 (min *blast-arc-segs* (the int (/ blen *blast-arc-seg-len*)))))
         (prev *blast-arc-prev*)
         (cur *blast-arc-cur*)
         (seg *blast-arc-seg*)
         )
    (vector-copy! prev start)
    (dotimes (i n)
      (let* ((t1 (/ (the float (+ i 1)) (the float n)))
             (d (* blen t1))
             (env (sin (* 32768.0 t1)))
             (side (* *blast-arc-jitter* env (rand-vu-float-range -1.0 1.0)))
             (lift (* 0.6 *blast-arc-jitter* env (rand-vu-float-range -1.0 1.0)))
             )
        (set-vector! cur
                     (+ (-> start x) (* sx d) (* cz side))
                     (+ (blast-arc-y-at d) lift)
                     (+ (-> start z) (* cz d) (* (- sx) side))
                     1.0)
        (vector-! seg cur prev)
        (let ((seg-len (vector-length seg)))
          (blast-arc-style *blast-arc-glow-r* *blast-arc-glow-g* *blast-arc-glow-b* *blast-arc-glow-width* *blast-arc-glow-a* seg-len)
          (draw-beam (-> *part-id-table* 2059) prev seg #t)
          (blast-arc-style *blast-arc-core-r* *blast-arc-core-g* *blast-arc-core-b* *blast-arc-core-width* *blast-arc-core-a* seg-len)
          (draw-beam (-> *part-id-table* 2059) prev seg #t)
          )
        (vector-copy! prev cur)
        )
      )
    )
  (none)
  )

(defun blast-arc-launch ((this process-drawable))
  (set! *blast-arc-active* #t)
  (set! *blast-arc-angle* (quaternion-y-angle (-> this root quat)))
  (while (< *blast-arc-angle* 0.0)
    (set! *blast-arc-angle* (+ *blast-arc-angle* 65536.0))
    )
  (while (>= *blast-arc-angle* 65536.0)
    (set! *blast-arc-angle* (- *blast-arc-angle* 65536.0))
    )
  (set! *blast-arc-swept* 0.0)
  (set! *blast-arc-acc* 0.0)
  (set-time! *blast-arc-pulse-time*)
  (set-time! *blast-arc-seen-time*)
  (set-time! *blast-arc-debug-time*)
  (if *blast-ord-debug*
      (format 0 "arc: lasers on~%")
      )
  (none)
  )

(defun blast-arc-covers-pos? ((c vector) (rad float) (a0 float) (stp float))
  ;; #t if one of the beams passed over a sphere (centre c, radius rad) while the lasers turned from a0 by stp.
  ;; (the geometry part of the old blast-arc-hit-test, split out so the allies can be tested the same way)
  (let* ((rx (- (-> c x) (-> *blast-arc-start* x)))
         (rz (- (-> c z) (-> *blast-arc-start* z)))
         (dist (sqrtf (+ (* rx rx) (* rz rz))))
         (dy (fabs (- (-> c y) (blast-arc-y-at (- dist *blast-arc-inner*)))))
         (hit #f)
         )
    (when (and (< dy (+ *blast-arc-tol-y* rad)) (< 1.0 dist) (< *blast-arc-inner* (+ dist rad)))
      (let ((bearing (atan rx rz))
            (halfw (atan rad dist))
            (spacing (/ 65536.0 (the float *blast-arc-beams*)))
            )
        (dotimes (k *blast-arc-beams*)
          (when (and (not hit) (< (- dist rad) (-> *blast-arc-lens* k)))
            (let ((ak (+ a0 (* spacing (the float k)))))
              (while (>= ak 65536.0)
                (set! ak (- ak 65536.0))
                )
              (let ((rel (deg- bearing ak)))
                (when (and (>= rel (- halfw)) (<= rel (+ stp halfw)))
                  (set! hit #t)
                  )
                )
              )
            )
          )
        )
      )
    hit
    )
  )

(defun blast-arc-hit-test ((this process-drawable) (p process-focusable) (a0 float) (stp float))
  ;; a0 = where beam 0 pointed at the last pulse, stp = how far it has turned since. Hits p once if any beam passed over it.
  (let* ((c (get-trans p 3))
         (rad (if (-> p root root-prim)
                  (fmax 2048.0 (fmin 16384.0 (-> p root root-prim prim-core world-sphere w)))
                  4096.0
                  )
              )
         )
    (when (blast-arc-covers-pos? c rad a0 stp)
      (blast-lifesteal-dealt *blast-arc-damage* #f)
      (send-event
        p
        'attack
        #f
        (static-attack-info ((id (new-attack-id))
                             (damage *blast-arc-damage*)
                             (vehicle-damage-factor 1.0)
                             (vehicle-impulse-factor 1.0)
                             (mode 'shock)
                             (attacker (blast-ord-attacker this))
                             )
                            )
        )
      )
    )
  (none)
  )

;; ---------------------------------------------------------------------------------------------------------------
;; Arc Wielder upgrade (gun-upgrade-blue-2, "Chain Companions"): while the lasers are on, a lightning chain links the bot
;; and EVERY companion it spawned (spydroids, sentinels, roboguards): bot -> nearest companion -> the next nearest one -> ...
;; The links are redrawn every frame; once per damage pulse every valid enemy within *blast-chain-reach* of a link is shocked
;; (damage *blast-arc-damage*). Switched on by blast-bot-secrets-apply (blastbot_guns.gc); (set! *blast-arc-chain* #t) from
;; the REPL also works.
;; ---------------------------------------------------------------------------------------------------------------
(define *blast-arc-chain* #f)
(define *blast-chain-reach* 8192.0)          ;; 2 m (+ the enemy's radius): how close to a link an enemy gets shocked
(define *blast-chain-max-link* 245760.0)     ;; 60 m: longer links are neither drawn nor damaging
(define *blast-chain-height* 6144.0)         ;; 1.5 m: links of ground companions attach this far above their feet
(define *blast-chain-pos* (new 'global 'inline-array 'vector 24))   ;; index 0 = the bot, 1.. = companions
(define *blast-chain-used* (new 'global 'array 'int32 24))
(define *blast-chain-pulse-time* (the-as time-frame 0))
(define *blast-chain-prev* (new 'global 'vector))
(define *blast-chain-cur* (new 'global 'vector))
(define *blast-chain-seg* (new 'global 'vector))
(define *blast-chain-box* (new 'global 'vector))
(define *blast-chain-hits* (new 'global 'array 'collide-shape 128))

(defun blast-chain-collect ((this process-drawable))
  ;; fills *blast-chain-pos*: [0] = the bot at laser height, then every living companion. Returns how many points.
  (let ((n 1)
        (p (-> *entity-pool* child))
        )
    (set-vector! (-> *blast-chain-pos* 0)
                 (-> this root trans x)
                 (+ (-> this root trans y) *blast-arc-height*)
                 (-> this root trans z)
                 1.0)
    (while (and p (< n 24))
      (let ((proc (the-as process (-> p 0))))
        (when (or (type? proc spydroid-ally) (type? proc roboguard-ally) (type? proc sentinel-ally) (type? proc bombbot-ally))
          (let ((ok #t)
                (sentinel? (type? proc sentinel-ally))
                )
            (when (not sentinel?)
              (when (blast-target-dead? (the-as process-focusable proc))
                (set! ok #f)
                )
              )
            (when ok
              (let ((rt (-> (the-as process-drawable proc) root trans)))
                (set-vector! (-> *blast-chain-pos* n)
                             (-> rt x)
                             (+ (-> rt y) (if sentinel? 0.0 *blast-chain-height*))
                             (-> rt z)
                             1.0)
                (+! n 1)
                )
              )
            )
          )
        (set! p (-> p 0 brother))
        )
      )
    n
    )
  )

(defun blast-chain-draw-link ((a vector) (b vector))
  ;; one crackling bolt from a to b (same look as the lasers); the kinks are zero at both ends so it stays attached
  (let* ((prev *blast-chain-prev*)
         (cur *blast-chain-cur*)
         (seg *blast-chain-seg*)
         (len (vector-vector-distance a b))
         (n (max 3 (min *blast-arc-segs* (the int (/ len *blast-arc-seg-len*)))))
         )
    (vector-copy! prev a)
    (dotimes (i n)
      (let* ((t1 (/ (the float (+ i 1)) (the float n)))
             (j (* *blast-arc-jitter* (sin (* 32768.0 t1))))
             )
        (set-vector! cur
                     (+ (-> a x) (* (- (-> b x) (-> a x)) t1) (* j (rand-vu-float-range -1.0 1.0)))
                     (+ (-> a y) (* (- (-> b y) (-> a y)) t1) (* j (rand-vu-float-range -1.0 1.0)))
                     (+ (-> a z) (* (- (-> b z) (-> a z)) t1) (* j (rand-vu-float-range -1.0 1.0)))
                     1.0)
        (vector-! seg cur prev)
        (let ((seg-len (vector-length seg)))
          (blast-arc-style *blast-arc-glow-r* *blast-arc-glow-g* *blast-arc-glow-b* *blast-arc-glow-width* *blast-arc-glow-a* seg-len)
          (draw-beam (-> *part-id-table* 2059) prev seg #t)
          (blast-arc-style *blast-arc-core-r* *blast-arc-core-g* *blast-arc-core-b* *blast-arc-core-width* *blast-arc-core-a* seg-len)
          (draw-beam (-> *part-id-table* 2059) prev seg #t)
          )
        (vector-copy! prev cur)
        )
      )
    )
  (none)
  )

(defun blast-chain-seg-dist ((c vector) (a vector) (b vector))
  ;; distance from point c to the segment a-b
  (let* ((abx (- (-> b x) (-> a x)))
         (aby (- (-> b y) (-> a y)))
         (abz (- (-> b z) (-> a z)))
         (l2 (+ (* abx abx) (* aby aby) (* abz abz)))
         (tt (if (< l2 1.0)
                 0.0
                 (fmax 0.0 (fmin 1.0 (/ (+ (* (- (-> c x) (-> a x)) abx)
                                           (* (- (-> c y) (-> a y)) aby)
                                           (* (- (-> c z) (-> a z)) abz))
                                        l2)))
                 )
             )
         (dx (- (-> c x) (+ (-> a x) (* tt abx))))
         (dy (- (-> c y) (+ (-> a y) (* tt aby))))
         (dz (- (-> c z) (+ (-> a z) (* tt abz))))
         )
    (sqrtf (+ (* dx dx) (* dy dy) (* dz dz)))
    )
  )

(defun blast-chain-hurt-link ((this process-drawable) (a vector) (b vector))
  ;; shocks every valid enemy close to the link a-b
  (let ((box *blast-chain-box*)
        (len (vector-vector-distance a b))
        )
    (set-vector! box
                 (* 0.5 (+ (-> a x) (-> b x)))
                 (* 0.5 (+ (-> a y) (-> b y)))
                 (* 0.5 (+ (-> a z) (-> b z)))
                 1.0)
    (set! (-> box w) (+ (* 0.5 len) 24576.0))
    (countdown (i (fill-actor-list-for-box *actor-hash* box *blast-chain-hits* 128))
      (let ((cs (as-type (-> *blast-chain-hits* i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (blast-ord-valid-target? this p)
              (let ((rad (if (-> p root root-prim)
                             (fmax 2048.0 (fmin 16384.0 (-> p root root-prim prim-core world-sphere w)))
                             4096.0
                             )
                         )
                    )
                (when (< (blast-chain-seg-dist (get-trans p 3) a b) (+ *blast-chain-reach* rad))
                  (blast-lifesteal-dealt *blast-arc-damage* #f)
                  (send-event
                    p
                    'attack
                    #f
                    (static-attack-info ((id (new-attack-id))
                                         (damage *blast-arc-damage*)
                                         (vehicle-damage-factor 1.0)
                                         (vehicle-impulse-factor 1.0)
                                         (mode 'shock)
                                         (attacker (blast-ord-attacker this))
                                         )
                                        )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-chain-update ((this process-drawable))
  ;; every frame while the lasers are on (called from blast-arc-update)
  (when *blast-arc-chain*
    (let ((n (blast-chain-collect this)))
      (when (< 1 n)
        (let ((pulse (time-elapsed? *blast-chain-pulse-time* (the int (* 300.0 *blast-arc-pulse-gap*))))
              (cur 0)
              )
          (if pulse
              (set-time! *blast-chain-pulse-time*)
              )
          (dotimes (i n)
            (set! (-> *blast-chain-used* i) 0)
            )
          (set! (-> *blast-chain-used* 0) 1)
          (dotimes (s (+ n -1))
            (let ((best -1)
                  (best-d 0.0)
                  )
              (dotimes (j n)
                (when (zero? (-> *blast-chain-used* j))
                  (let ((d (vector-vector-distance (-> *blast-chain-pos* cur) (-> *blast-chain-pos* j))))
                    (when (or (< best 0) (< d best-d))
                      (set! best j)
                      (set! best-d d)
                      )
                    )
                  )
                )
              (when (>= best 0)
                (set! (-> *blast-chain-used* best) 1)
                (when (< best-d *blast-chain-max-link*)
                  (blast-chain-draw-link (-> *blast-chain-pos* cur) (-> *blast-chain-pos* best))
                  (if pulse
                      (blast-chain-hurt-link this (-> *blast-chain-pos* cur) (-> *blast-chain-pos* best))
                      )
                  )
                (set! cur best)
                )
              )
            )
          )
        (blast-arc-style-restore)
        )
      )
    )
  (none)
  )

(defun blast-arc-update ((this process-drawable))
  ;; every frame from the bot; does nothing while the lasers are off
  (when *blast-arc-active*
    (cond
      ((time-elapsed? *blast-arc-seen-time* (seconds 0.5))
       ;; the bot stopped calling us (it died / was replaced): do not resume the old lasers on the next bot
       (set! *blast-arc-active* #f)
       (format 0 "arc: not updated for 0.5 s, lasers off~%")
       )
      (else
        (set-time! *blast-arc-seen-time*)
        (let* ((dt (seconds-per-frame))
               (stp (fmin (* *blast-arc-speed* dt) (- 65536.0 *blast-arc-swept*)))
               (a0 *blast-arc-angle*)
               (a1 (+ a0 stp))
               (n *blast-arc-beams*)
               (spacing (/ 65536.0 (the float n)))
               (start *blast-arc-start*)
               (extent *blast-arc-extent*)
               (q *blast-arc-query*)
               )
          (vector-copy! start (-> this root trans))
          ;; heights: body height at the start, and *blast-arc-drop-height* (2 m) below that for the arc's end.
          ;; Never lower than 0.5 m above the ground under the bot (when the bot knows where the ground is).
          (let ((ry (-> start y)))
            (set! *blast-arc-y-body* (+ ry *blast-arc-height*))
            (set! *blast-arc-y-low* (- *blast-arc-y-body* *blast-arc-drop-height*))
            (when (< (- ry 61440.0) *blast-arc-ground-y*)
              (set! *blast-arc-y-low* (fmax *blast-arc-y-low* (+ *blast-arc-ground-y* 2048.0)))
              )
            )
          (set! (-> start y) *blast-arc-y-body*)
          ;; the lasers: each one starts *blast-arc-inner* (4 m) away from the centre at body height, runs level for
          ;; *blast-arc-level-dist*, arcs down over *blast-arc-drop-dist*, then runs level to its end. Walls shorten it: the
          ;; level + arc part is probed as one straight chord, the final level part as a second line.
          (dotimes (k n)
            (let ((ak (+ a1 (* spacing (the float k)))))
              (while (>= ak 65536.0)
                (set! ak (- ak 65536.0))
                )
              (let* ((sx (sin ak))
                     (cz (cos ak))
                     (drop (+ *blast-arc-level-dist* *blast-arc-drop-dist*))   ;; where the low level part begins
                     (bstart *blast-arc-bstart*)
                     (pdrop *blast-arc-pdrop*)
                     (blen *blast-arc-length*)
                     (hit-wall #f)
                     )
                (set-vector! bstart
                             (+ (-> start x) (* *blast-arc-inner* sx))
                             *blast-arc-y-body*
                             (+ (-> start z) (* *blast-arc-inner* cz))
                             1.0)
                (set-vector! pdrop (+ (-> bstart x) (* drop sx)) *blast-arc-y-low* (+ (-> bstart z) (* drop cz)) 1.0)
                (vector-! extent pdrop bstart)
                (let ((ha (blast-arc-probe this bstart extent)))
                  (cond
                    ((>= ha 0.0)
                     (set! blen (* drop ha))
                     (set! hit-wall #t)
                     )
                    (else
                      (set-vector! extent (* (- *blast-arc-length* drop) sx) 0.0 (* (- *blast-arc-length* drop) cz) 1.0)
                      (let ((hb (blast-arc-probe this pdrop extent)))
                        (when (>= hb 0.0)
                          (set! blen (+ drop (* (- *blast-arc-length* drop) hb)))
                          (set! hit-wall #t)
                          )
                        )
                      )
                    )
                  )
                (when hit-wall
                  ;; spark where it hits a wall
                  (set-vector! *blast-arc-end*
                               (+ (-> bstart x) (* sx blen))
                               (blast-arc-y-at blen)
                               (+ (-> bstart z) (* cz blen))
                               1.0)
                  (launch-particles (-> *part-id-table* 2060) *blast-arc-end*)
                  )
                ;; (distance from the bot's centre, used by the damage test)
                (set! (-> *blast-arc-lens* k) (+ *blast-arc-inner* blen))
                (blast-arc-draw-bolt bstart sx cz blen)
                (when (and (zero? k) *blast-ord-debug* (time-elapsed? *blast-arc-debug-time* (seconds 0.5)))
                  (set-time! *blast-arc-debug-time*)
                  (format 0 "arc: beam 0 angle ~D, length ~M, turned ~D of 360, body y ~M low y ~M~%"
                          (the int (* 0.0054931640625 ak))
                          (-> *blast-arc-lens* 0)
                          (the int (* 0.0054931640625 *blast-arc-swept*))
                          *blast-arc-y-body* *blast-arc-y-low*)
                  )
                )
              )
            )
          (blast-arc-style-restore)
          (blast-chain-update this)
          ;; turn
          (set! *blast-arc-angle* a1)
          (while (>= *blast-arc-angle* 65536.0)
            (set! *blast-arc-angle* (- *blast-arc-angle* 65536.0))
            )
          (set! *blast-arc-swept* (+ *blast-arc-swept* stp))
          (set! *blast-arc-acc* (+ *blast-arc-acc* stp))
          ;; damage pulse (always one more on the very last frame, so the end of the turn is not skipped)
          (let ((done (>= *blast-arc-swept* 65535.0)))
            (when (or done (time-elapsed? *blast-arc-pulse-time* (the int (* 300.0 *blast-arc-pulse-gap*))))
              (set-time! *blast-arc-pulse-time*)
              (let ((pulse-a0 (- a1 *blast-arc-acc*)))
                (while (< pulse-a0 0.0)
                  (set! pulse-a0 (+ pulse-a0 65536.0))
                  )
                (vector-copy! *blast-arc-box* start)
                (set! (-> *blast-arc-box* w) *blast-arc-length*)
                (countdown (i (fill-actor-list-for-box *actor-hash* *blast-arc-box* *blast-arc-hits* 128))
                  (let ((cs (as-type (-> *blast-arc-hits* i) collide-shape)))
                    (when cs
                      (let ((p (as-type (-> cs process) process-focusable)))
                        (when (blast-ord-valid-target? this p)
                          (blast-arc-hit-test this p pulse-a0 *blast-arc-acc*)
                          )
                        )
                      )
                    )
                  )
                (set! *blast-arc-acc* 0.0)
                )
              )
            (when done
              (set! *blast-arc-active* #f)
              (if *blast-ord-debug*
                  (format 0 "arc: full turn done, lasers off~%")
                  )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-arc-stop ()
  ;; REPL: switches the lasers off
  (set! *blast-arc-active* #f)
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Peace Maker (purple 1): Errol's shockwave bomb
;;;;;;;;;;;;;;;;;;;;;;;;;;
;; factory-boss-setup.gc is only loaded in Errol's level, so the bomb is rebuilt here (same pattern as the missile):
;;   - blast-peace-bomb : lobbed in an arc from the bot's muzzle to the enemy the turret is locked on to (it keeps tracking that
;;                        enemy while it flies). Nothing locked: it lands *blast-bomb-free-dist* ahead on the ground.
;;                        Explodes when it lands, or earlier if it hits a wall.
;;   - blast-peace-wave : the big shockwave. Errol's own numbers: a ring that grows as 2048 * frames^0.85 (about 40 m after 0.6 s)
;;                        and hurts everything it passes over close to the ground, so a jump clears it. It is drawn as a purple
;;                        lightning ring with the beam part (2059), like the Arc Wielder. The impact itself also hurts everything
;;                        within *blast-bomb-radius*. Every enemy is hurt at most once per bomb.
;; Targets: the same things the red / yellow / blue shots hurt (blast-bomb-valid-target?). Fired by blast-bot-fire-peacemaker (blastbot_guns.gc).

(define *blast-bomb-damage* 3.0)                 ;; doc: 3
;; Peace Maker upgrade (gun-upgrade-dark-1, set by blast-bot-secrets-apply): 3 smaller bombs, no impact splash, only their shockwave
(define *blast-bomb-split* #f)
(define *blast-bomb-fixed-dest* (new 'global 'vector))   ;; where an untracked bomb lands (set by blast-bot-fire-peacemaker)
(define *blast-bomb-has-fixed* #f)                        ;; #t: use *blast-bomb-fixed-dest*; #f: land *blast-bomb-free-dist* ahead
(define *blast-bomb-charge* 1.0)                 ;; 1.0 uncharged .. 2.0 fully charged: multiplies the size and the damage (set by blast-bot-purple-charge-update)
(define *blast-bomb-offset* (new 'global 'vector))   ;; scratch: landing offset handed to the bomb being spawned
(define *blast-bomb-split-spread* 16384.0)       ;; 4 m between the three landing points
(define *blast-bomb-split-scale* 0.5)            ;; shockwave radius (and bomb size) of each small bomb
(define *blast-bomb-split-damage* 1.0)           ;; damage per small bomb (3 of them: 3 in total, like the single bomb)
(define *blast-bomb-vehicle-factor* 1.3333)      ;; doc: 4 against vehicles
(define *blast-bomb-speed* 102400.0)             ;; 25 m/s: sets the flight time (distance / speed)
(define *blast-bomb-min-time* 0.5)               ;; seconds, shortest flight
(define *blast-bomb-max-time* 2.0)               ;; seconds, longest flight
(define *blast-bomb-arc-min* 8192.0)             ;; 2 m: height of the lob at its top, for a short throw
(define *blast-bomb-arc-per-dist* 0.12)          ;; plus this much per unit of distance
(define *blast-bomb-arc-max* 32768.0)            ;; 8 m: highest lob
(define *blast-bomb-free-dist* 122880.0)         ;; 30 m: where it lands when nothing is locked
(define *blast-bomb-radius* 8192.0)              ;; 2 m (+ the enemy's size): the impact blast
(define *blast-bomb-wave-max* 163840.0)          ;; 40 m: the shockwave dies at this radius
(define *blast-bomb-wave-k* 2048.0)              ;; Errol's growth: radius = k * frames^pow
(define *blast-bomb-wave-pow* 0.85)
(define *blast-bomb-wave-up* 12288.0)            ;; 3 m: enemies higher than this above the impact are not hit by the ring
(define *blast-bomb-wave-down* 8192.0)           ;; 2 m: ... or lower than this below it
(define *blast-bomb-ring-segs* 36)               ;; segments of the drawn ring
(define *blast-bomb-ring-jitter* 1536.0)         ;; 0.375 m: how far the ring crackles
(define *blast-bomb-glow-width* 3072.0)          ;; game units (4096 = 1 m)
(define *blast-bomb-core-width* 768.0)
(define *blast-bomb-ball-len* 8192.0)            ;; 2 m: the glowing ball of the bomb
(define *blast-bomb-ball-width* 4096.0)
(define *blast-bomb-streak-len* 24576.0)         ;; 6 m: the trail behind it
(define *blast-bomb-streak-width* 1228.8)
;; purple (0..255)
(define *blast-bomb-glow-r* 150.0)
(define *blast-bomb-glow-g* 20.0)
(define *blast-bomb-glow-b* 255.0)
(define *blast-bomb-glow-a* 110.0)
(define *blast-bomb-core-r* 235.0)
(define *blast-bomb-core-g* 200.0)
(define *blast-bomb-core-b* 255.0)
(define *blast-bomb-core-a* 255.0)

(define *blast-bomb-from* (new 'global 'vector))
(define *blast-bomb-dest* (new 'global 'vector))
(define *blast-bomb-new* (new 'global 'vector))
(define *blast-bomb-move* (new 'global 'vector))
(define *blast-bomb-hitpos* (new 'global 'vector))
(define *blast-bomb-btail* (new 'global 'vector))
(define *blast-bomb-bvec* (new 'global 'vector))
(define *blast-bomb-prev* (new 'global 'vector))
(define *blast-bomb-cur* (new 'global 'vector))
(define *blast-bomb-seg* (new 'global 'vector))
(define *blast-bomb-box* (new 'global 'vector))
(define *blast-bomb-hits* (new 'global 'array 'collide-shape 128))

;; ---- the shockwave ----

(deftype blast-peace-wave (process-drawable)
  ((owner-handle   handle)
   (spawn-time     time-frame)
   (center         vector  :inline)   ;; where the bomb landed
   (last-r         float)             ;; ring radius last frame
   (wave-id        uint32)            ;; one attack id for the whole bomb
   (hit-count      int32)
   (hits           uint64  24)        ;; handles of the enemies already hurt by this bomb
   (scale          float)             ;; 1.0 normal, smaller for the split bombs (shockwave max radius)
   (damage         float)
   )
  (:state-methods
    active
    die
    )
  )

;; Who the Peace Maker hurts: the same things the red, yellow and blue shots hurt. Those are stock projectiles that damage whatever they
;; touch, so unlike the missiles / Arc Wielder (blast-ord-valid-target?: enemies only, minus *spydroid-ally-ignore-types*) this one
;; has no mask or type filter: enemies, guards, crimson guards, wastelanders, crates, civilians... Only Jak, the bot, the allies and
;; things that are already dead or switched off are left out.
(define *blast-bomb-hit-civilians* #t)    ;; #f: civilians are spared

(defun blast-bomb-valid-target? ((owner process) (p process-focusable))
  (and p
       (!= p *target*)
       (!= p owner)
       (not (type? p spydroid-ally))
       (not (type? p sentinel-ally))
       (not (type? p bombbot-ally))
       (not (focus-test? p inactive))
       (not (blast-target-dead? p))
       (or *blast-bomb-hit-civilians* (not (logtest? (process-mask civilian) (-> p mask))))
       )
  )

(defun blast-bomb-hurt ((this blast-peace-wave) (p process-focusable))
  ;; damages p, once per bomb
  (let ((key (the-as uint64 (process->handle p)))
        (seen #f)
        )
    (dotimes (i (-> this hit-count))
      (if (= (-> this hits i) key)
          (set! seen #t)
          )
      )
    (when (and (not seen) (< (-> this hit-count) 24))
      (set! (-> this hits (-> this hit-count)) key)
      (+! (-> this hit-count) 1)
      (blast-lifesteal-dealt (-> this damage) #f)
      (send-event
        p
        'attack
        #f
        (static-attack-info ((id (-> this wave-id))
                             (damage (-> this damage))
                             (vehicle-damage-factor *blast-bomb-vehicle-factor*)
                             (vehicle-impulse-factor 1.0)
                             (mode 'explode)
                             (attacker (blast-ord-attacker (handle->process (-> this owner-handle))))
                             )
                            )
        )
      )
    )
  (none)
  )

(defun blast-bomb-blast ((this blast-peace-wave))
  ;; the impact: every valid enemy within *blast-bomb-radius* (+ its own size)
  (let ((box *blast-bomb-box*)
        (hits *blast-bomb-hits*)
        (owner (handle->process (-> this owner-handle)))
        )
    (vector-copy! box (-> this center))
    (set! (-> box w) (* 2.0 *blast-bomb-radius* (-> this scale)))
    (countdown (i (fill-actor-list-for-box *actor-hash* box hits 128))
      (let ((cs (as-type (-> hits i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (and (blast-bomb-valid-target? owner p)
                       (< (vector-vector-distance (-> this center) (get-trans p 3)) (+ (* *blast-bomb-radius* (-> this scale)) 4096.0))
                       )
              (blast-bomb-hurt this p)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-bomb-wave-scan ((this blast-peace-wave) (r0 float) (r1 float))
  ;; hurts every valid enemy the ring passed over while it grew from r0 to r1 (flat distance from the centre, near the ground)
  (let ((box *blast-bomb-box*)
        (hits *blast-bomb-hits*)
        (owner (handle->process (-> this owner-handle)))
        )
    (vector-copy! box (-> this center))
    (set! (-> box w) (+ r1 16384.0))
    (countdown (i (fill-actor-list-for-box *actor-hash* box hits 128))
      (let ((cs (as-type (-> hits i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (blast-bomb-valid-target? owner p)
              (let* ((pt (-> p root trans))
                     (dx (- (-> pt x) (-> this center x)))
                     (dz (- (-> pt z) (-> this center z)))
                     (d (sqrtf (+ (* dx dx) (* dz dz))))
                     (dy (- (-> pt y) (-> this center y)))
                     (rad (fmax 2048.0 (fmin 16384.0 (if (-> p root root-prim)
                                                         (-> p root root-prim prim-core world-sphere w)
                                                         4096.0
                                                         ))))
                     )
                (if (and (< (- r0 rad) d) (< d (+ r1 rad)) (< dy *blast-bomb-wave-up*) (< (- *blast-bomb-wave-down*) dy))
                    (blast-bomb-hurt this p)
                    )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

;; Every wave redraws its whole ring EVERY frame (2 rows x segments x 2 beams = 144 draw-beam calls for one wave), and each
;; call spends a particle. When a second bomb landed while the first wave was still growing (the split upgrade lands three
;; at once) the ring particles plus the explosion's burst ran the particle pool dry and the rings vanished. Nothing in
;; the code removes a wave early; this budget is the fix: all live waves share *blast-bomb-ring-budget* beams per frame,
;; so one wave looks exactly as before and each extra wave gets fewer, longer segments instead of disappearing.
(define *blast-bomb-ring-budget* 144)            ;; draw-beam calls per frame for ALL shockwaves together. 9999 = the old behaviour
(define *blast-bomb-wave-stamp* (the-as time-frame -1))
(define *blast-bomb-wave-now* 0)                 ;; waves that drew this frame so far
(define *blast-bomb-wave-last* 1)                ;; waves that drew last frame

(defun blast-bomb-ring-segs-now ()
  (when (!= *blast-bomb-wave-stamp* (current-time))
    (set! *blast-bomb-wave-last* (max 1 *blast-bomb-wave-now*))
    (set! *blast-bomb-wave-now* 0)
    (set! *blast-bomb-wave-stamp* (current-time))
    )
  (+! *blast-bomb-wave-now* 1)
  (max 8 (min *blast-bomb-ring-segs* (/ *blast-bomb-ring-budget* (* 4 *blast-bomb-wave-last*))))
  )

(defun blast-bomb-draw-ring ((this blast-peace-wave) (r float))
  ;; two crackling rings (low and a little higher) of short beam segments, glow + core
  (let ((prev *blast-bomb-prev*)
        (cur *blast-bomb-cur*)
        (seg *blast-bomb-seg*)
        (n (blast-bomb-ring-segs-now))
        )
    (dotimes (row 2)
      (let ((y (+ (-> this center y) 2048.0 (* 6144.0 (the float row)))))
        (dotimes (i (+ n 1))
          (let* ((a (* (/ 65536.0 (the float n)) (the float i)))
                 (rr (+ r (* *blast-bomb-ring-jitter* (rand-vu-float-range -1.0 1.0))))
                 )
            (set-vector! cur
                         (+ (-> this center x) (* rr (sin a)))
                         (+ y (* 0.5 *blast-bomb-ring-jitter* (rand-vu-float-range -1.0 1.0)))
                         (+ (-> this center z) (* rr (cos a)))
                         1.0)
            (when (> i 0)
              (vector-! seg cur prev)
              (let ((sl (vector-length seg)))
                (blast-arc-style *blast-bomb-glow-r* *blast-bomb-glow-g* *blast-bomb-glow-b* *blast-bomb-glow-width* *blast-bomb-glow-a* sl)
                (draw-beam (-> *part-id-table* 2059) prev seg #t)
                (blast-arc-style *blast-bomb-core-r* *blast-bomb-core-g* *blast-bomb-core-b* *blast-bomb-core-width* *blast-bomb-core-a* sl)
                (draw-beam (-> *part-id-table* 2059) prev seg #t)
                )
              )
            (vector-copy! prev cur)
            )
          )
        )
      )
    (blast-arc-style-restore)
    )
  (none)
  )

(defun blast-bomb-wave-update ((this blast-peace-wave))
  ;; once per frame from the active state's :trans
  (let* ((f (fmax 1.0 (the float (- (current-time) (-> this spawn-time)))))
         (r (* *blast-bomb-wave-k* (pow f *blast-bomb-wave-pow*)))
         )
    (cond
      ((< (* *blast-bomb-wave-max* (-> this scale)) r)
       (go (method-of-object this die))
       )
      (else
        (blast-bomb-wave-scan this (-> this last-r) r)
        (set! (-> this last-r) r)
        (blast-bomb-draw-ring this r)
        )
      )
    )
  (none)
  )

(defstate active (blast-peace-wave)
  :virtual #t
  :enter (behavior ()
    (set-time! (-> self state-time))
    )
  :trans (behavior ()
    (blast-bomb-wave-update self)
    )
  :code sleep-code
  )

(defstate die (blast-peace-wave)
  :virtual #t
  :code (behavior ()
    (deactivate self)
    )
  )

(defbehavior blast-peace-wave-init-by-other blast-peace-wave ((owner process-drawable) (pos vector) (scale float) (dmg float) (splash symbol))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (vector-copy! (-> self center) pos)
  (set! (-> self owner-handle) (process->handle owner))
  (set-time! (-> self spawn-time))
  (set! (-> self last-r) 0.0)
  (set! (-> self wave-id) (new-attack-id))
  (set! (-> self hit-count) 0)
  (set! (-> self scale) scale)
  (set! (-> self damage) dmg)
  (if splash
      (blast-bomb-blast self)
      )
  (go-virtual active)
  )

(defun blast-peace-wave-spawn ((owner process-drawable) (pos vector) (scale float) (dmg float) (splash symbol))
  (process-spawn blast-peace-wave
                 :init blast-peace-wave-init-by-other owner pos scale dmg splash
                 :name "blast-peace-wave"
                 :to *entity-pool*
                 )
  (none)
  )

;; ---- the bomb ----

(deftype blast-peace-bomb (process-drawable)
  ((owner-handle   handle)      ;; the bot that threw it
   (target-handle  handle)      ;; the enemy it is thrown at
   (spawn-time     time-frame)
   (from-pos       vector  :inline)
   (dest-pos       vector  :inline)   ;; where it lands (follows the target)
   (last-pos       vector  :inline)
   (flight-time    float)       ;; seconds
   (arc-height     float)
   (has-target     symbol)
   (offset         vector  :inline)   ;; split bombs: landing point offset from the target
   (scale          float)
   (damage         float)
   (splash         symbol)            ;; #t: the impact also hurts everything near it
   )
  (:state-methods
    active
    die
    )
  )

(defun blast-bomb-explode ((this blast-peace-bomb) (pos vector))
  ;; the dark shot's own burst (same group the missiles use) + the shockwave
  (vector-copy! (-> *launch-matrix* trans) pos)
  (if (logtest? (-> group-gun-dark-shot-hit flags) (sp-group-flag sp13))
      (part-tracker-spawn part-tracker-subsampler :to *entity-pool* :group group-gun-dark-shot-hit)
      (part-tracker-spawn part-tracker :to *entity-pool* :group group-gun-dark-shot-hit)
      )
  (blast-peace-wave-spawn (as-type (handle->process (-> this owner-handle)) process-drawable) pos (-> this scale) (-> this damage) (-> this splash))
  (if *blast-ord-debug*
      (format 0 "peace maker: bomb landed~%")
      )
  (go (method-of-object this die))
  (none)
  )

(defun blast-bomb-draw ((this blast-peace-bomb))
  ;; the glowing ball + a trail behind it
  (let ((tail *blast-bomb-btail*)
        (vec *blast-bomb-bvec*)
        (seg *blast-bomb-seg*)
        (pos (-> this root trans))
        ;; drawn size = the charge (1..2), the same as the charge ball. The split bombs' scale also has the smaller shockwave in it.
        (sc (if (-> this splash) (-> this scale) (/ (-> this scale) *blast-bomb-split-scale*)))
        )
    (vector-! seg pos (-> this last-pos))
    (when (< 1.0 (vector-length seg))
      (vector-normalize! seg 1.0)
      ;; trail
      (vector+float*! tail pos seg (- *blast-bomb-streak-len*))
      (vector-float*! vec seg *blast-bomb-streak-len*)
      (blast-arc-style *blast-bomb-glow-r* *blast-bomb-glow-g* *blast-bomb-glow-b* *blast-bomb-streak-width* *blast-bomb-glow-a* *blast-bomb-streak-len*)
      (draw-beam (-> *part-id-table* 2059) tail vec #t)
      ;; ball: a short, fat glow with a bright core
      (vector+float*! tail pos seg (- (* sc *blast-bomb-ball-len*)))
      (vector-float*! vec seg (* sc *blast-bomb-ball-len*))
      (blast-arc-style *blast-bomb-glow-r* *blast-bomb-glow-g* *blast-bomb-glow-b* (* sc *blast-bomb-ball-width*) *blast-bomb-glow-a* (* sc *blast-bomb-ball-len*))
      (draw-beam (-> *part-id-table* 2059) tail vec #t)
      (blast-arc-style *blast-bomb-core-r* *blast-bomb-core-g* *blast-bomb-core-b* (* 0.4 (* sc *blast-bomb-ball-width*)) *blast-bomb-core-a* (* sc *blast-bomb-ball-len*))
      (draw-beam (-> *part-id-table* 2059) tail vec #t)
      )
    (blast-arc-style-restore)
    )
  (none)
  )

;; the Peace Maker's charge ball at the muzzle: the bomb's own glowing ball (same beams and colours), x1..x2 with the charge
;; (f = 0..1). The bombs you throw (split ones too) are drawn at exactly this size; only the split bombs' shockwave is smaller.
(defun blast-bomb-charge-ball ((pos vector) (dir vector) (f float))
  (let ((tail *blast-bomb-btail*)
        (vec *blast-bomb-bvec*)
        (sc (* (+ 1.0 f) (rand-vu-float-range 0.95 1.05)))
        )
    (vector+float*! tail pos dir (- (* sc *blast-bomb-ball-len*)))
    (vector-float*! vec dir (* sc *blast-bomb-ball-len*))
    (blast-arc-style *blast-bomb-glow-r* *blast-bomb-glow-g* *blast-bomb-glow-b* (* sc *blast-bomb-ball-width*) *blast-bomb-glow-a* (* sc *blast-bomb-ball-len*))
    (draw-beam (-> *part-id-table* 2059) tail vec #t)
    (blast-arc-style *blast-bomb-core-r* *blast-bomb-core-g* *blast-bomb-core-b* (* 0.4 (* sc *blast-bomb-ball-width*)) *blast-bomb-core-a* (* sc *blast-bomb-ball-len*))
    (draw-beam (-> *part-id-table* 2059) tail vec #t)
    (blast-arc-style-restore)
    )
  (none)
  )

(defun blast-bomb-update ((this blast-peace-bomb))
  ;; once per frame from the active state's :trans: moves the bomb along its arc, follows the target, explodes
  (let* ((age (/ (the float (- (current-time) (-> this spawn-time))) 300.0))
         (u (fmin 1.0 (/ age (fmax 0.1 (-> this flight-time)))))
         (pos (-> this root trans))
         (np *blast-bomb-new*)
         (mv *blast-bomb-move*)
         )
    (when (-> this has-target)
      (let ((p (as-type (handle->process (-> this target-handle)) process-focusable)))
        (when (and p (not (logtest? (-> p focus-status) (focus-status disable dead))))
          (vector+! (-> this dest-pos) (-> p root trans) (-> this offset))
          )
        )
      )
    (vector-copy! (-> this last-pos) pos)
    (set-vector! np
                 (+ (-> this from-pos x) (* u (- (-> this dest-pos x) (-> this from-pos x))))
                 (+ (-> this from-pos y) (* u (- (-> this dest-pos y) (-> this from-pos y))) (* 4.0 (-> this arc-height) u (- 1.0 u)))
                 (+ (-> this from-pos z) (* u (- (-> this dest-pos z) (-> this from-pos z))))
                 1.0)
    (vector-! mv np pos)
    (let ((hit (if (< 0.12 age)
                   (blast-arc-probe this pos mv)
                   -1.0
                   )
               )
          )
      (cond
        ((>= hit 0.0)
         ;; flew into a wall / the ground early
         (vector+float*! *blast-bomb-hitpos* pos mv hit)
         (blast-bomb-explode this *blast-bomb-hitpos*)
         )
        (else
          (vector-copy! pos np)
          (blast-bomb-draw this)
          (if (>= u 1.0)
              (blast-bomb-explode this pos)
              )
          )
        )
      )
    )
  (none)
  )

(defstate active (blast-peace-bomb)
  :virtual #t
  :enter (behavior ()
    (set-time! (-> self state-time))
    )
  :trans (behavior ()
    (blast-bomb-update self)
    )
  :code sleep-code
  )

(defstate die (blast-peace-bomb)
  :virtual #t
  :code (behavior ()
    (deactivate self)
    )
  )

(defbehavior blast-peace-bomb-init-by-other blast-peace-bomb ((owner process-drawable) (from vector) (dest vector) (target process-focusable) (tm float) (h float))
  ;; spawn args are limited (process-spawn adds 2): the landing offset (xyz) and the bomb scale (w) come in through *blast-bomb-offset*
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) from)
  (vector-copy! (-> self from-pos) from)
  (vector-copy! (-> self last-pos) from)
  (vector-copy! (-> self dest-pos) dest)
  (set! (-> self owner-handle) (process->handle owner))
  (set! (-> self flight-time) tm)
  (set! (-> self arc-height) h)
  (vector-copy! (-> self offset) *blast-bomb-offset*)
  (set! (-> self scale) (-> *blast-bomb-offset* w))
  ;; y = 1 for the normal bomb (impact splash), 0 for a Peace Maker split bomb; a charged bomb (up to x2) is bigger and hits harder
  (set! (-> self splash) (< 0.5 (-> *blast-bomb-offset* y)))
  (set! (-> self damage) (* *blast-bomb-charge* (if (-> self splash) *blast-bomb-damage* *blast-bomb-split-damage*)))
  (cond
    (target
      (set! (-> self has-target) #t)
      (set! (-> self target-handle) (process->handle target))
      )
    (else
      (set! (-> self has-target) #f)
      (set! (-> self target-handle) (the-as handle #f))
      )
    )
  (set-time! (-> self spawn-time))
  (go-virtual active)
  )

(defun blast-bomb-launch-one ((owner process-drawable) (start vector) (dir vector) (target process-focusable) (ox float) (oz float) (scale float) (splash symbol))
  ;; one bomb. ox / oz = where it lands relative to the target (or to the free landing point)
  (let ((from *blast-bomb-from*)
        (dest *blast-bomb-dest*)
        (tmp *blast-bomb-move*)
        )
    (vector-copy! from start)
    (cond
      (target
        (vector-copy! dest (-> target root trans))
        )
      (*blast-bomb-has-fixed*
        ;; no homing: it lands where the turret was aiming when it fired and does not follow anything
        (vector-copy! dest *blast-bomb-fixed-dest*)
        )
      (else
        ;; nothing locked: land ahead of the barrel, on the ground under the bot
        (vector-copy! tmp dir)
        (set! (-> tmp y) 0.0)
        (if (< (vector-length tmp) 0.01)
            (set-vector! tmp 0.0 0.0 1.0 1.0)
            (vector-normalize! tmp 1.0)
            )
        (vector+float*! dest start tmp *blast-bomb-free-dist*)
        (set! (-> dest y) (if (< *blast-arc-ground-y* (- (-> start y) 409600.0))
                              (- (-> start y) 8192.0)
                              *blast-arc-ground-y*
                              ))
        )
      )
    (+! (-> dest x) ox)
    (+! (-> dest z) oz)
    (set-vector! *blast-bomb-offset* ox (if splash 1.0 0.0) oz scale)
    (let* ((dx (- (-> dest x) (-> from x)))
           (dz (- (-> dest z) (-> from z)))
           (dist (sqrtf (+ (* dx dx) (* dz dz))))
           (tm (fmax *blast-bomb-min-time* (fmin *blast-bomb-max-time* (/ dist *blast-bomb-speed*))))
           (h (fmin *blast-bomb-arc-max* (+ *blast-bomb-arc-min* (* dist *blast-bomb-arc-per-dist*))))
           )
      (process-spawn blast-peace-bomb
                     :init blast-peace-bomb-init-by-other owner from dest target tm h
                     :name "blast-peace-bomb"
                     :to *entity-pool*
                     )
      (if *blast-ord-debug*
          (format 0 "peace maker: bomb thrown, ~A, flight ~f s~%" (if target "at a target" "free") tm)
          )
      )
    )
  (none)
  )

;; Peace Maker. Normal: one bomb with impact splash + shockwave. Upgrade (gun-upgrade-dark-1): three smaller bombs side by side,
;; no impact splash, each with its own (smaller) shockwave.
(defun blast-bomb-launch ((owner process-drawable) (start vector) (dir vector) (target process-focusable))
  (cond
    (*blast-bomb-split*
      (let* ((fx (-> dir x))
             (fz (-> dir z))
             (fl (sqrtf (+ (* fx fx) (* fz fz))))
             (px (if (< fl 0.01) 1.0 (/ (- fz) fl)))   ;; sideways, flat
             (pz (if (< fl 0.01) 0.0 (/ fx fl)))
             (sp *blast-bomb-split-spread*)
             )
        (dotimes (i 3)
          (let ((k (the float (+ i -1))))
            (blast-bomb-launch-one owner start dir target (* k sp px) (* k sp pz) (* *blast-bomb-split-scale* *blast-bomb-charge*) #f)
            )
          )
        )
      )
    (else
      (blast-bomb-launch-one owner start dir target 0.0 0.0 *blast-bomb-charge* #t)
      )
    )
  (none)
  )

(defun blast-bomb-clear ()
  ;; REPL: removes every bomb and shockwave
  (let ((p (-> *entity-pool* child)))
    (while p
      (let ((next (-> p 0 brother))
            (proc (the-as process (-> p 0)))
            )
        (if (or (type? proc blast-peace-bomb) (type? proc blast-peace-wave))
            (deactivate proc)
            )
        (set! p next)
        )
      )
    )
  (none)
  )