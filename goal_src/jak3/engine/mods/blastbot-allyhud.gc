;;-*-Lisp-*-
(in-package goal)

;; name: blastbot-allyhud.gc
;; name in dgo: blastbot-allyhud
;; dgos: GAME

;; The minion part of the Blast Bot's HUD (spydroid-ally, sentinel-ally, roboguard-ally).
;;
;; COMPACT VERSION. The old version gave every minion a numbered slot (handle array), a floating label and an icon with a
;; bar under it. That is gone. Now:
;;   - once a frame the entity pool is walked and the living minions of each kind are COUNTED (no slots, no handles);
;;   - the top-left of the screen shows one square box per kind that has at least one minion alive:
;;         [red square]  10     [yellow triangle]  2     [blue X]  4
;;     the boxes sit next to each other and close up when a kind is empty; the number is centred under its box.
;;   - the boxes are drawn by their OWN small hud process (blast-ally-hud, below), a child of the bot, so they have all 30 hud
;;     sprites and 4 text strings to themselves. blast-ally-hud-update spawns it. blast-bot-hud still calls ahud-draw-boxes
;;     with its own sprites 15..29, which is now a no-op (it only draws on a blast-ally-hud), so blastbot-main-mod.gc needs NO change.
;;
;; Needs, in game.gd:  "blastbot-allyhud.o"  after spydroid-ally.o, sentinel-ally.o, roboguard-ally.o, bombbot-ally.o
;; and before blastbot-main-mod.o (which calls blast-ally-hud-update and ahud-draw-boxes).

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Knobs (set from the REPL)
;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ahud-enabled* #t)              ;; #f = no counting and no boxes
(define *ahud-debug* #f)                ;; #t: log the counts whenever they change
;; layout (hud pixels, 512 x 416)
(define *ahud-x* 15)                    ;; left edge of the first box
(define *ahud-y* 20)                    ;; top edge of the boxes
(define *ahud-box* 40)                  ;; outer size of a box (square); the border is 4 pixels, so the inside is box - 8
(define *ahud-gap* 35)                   ;; gap between two boxes (Doesn't work?)
(define *ahud-text-gap* 2)              ;; gap between a box and its number
(define *ahud-text-scale* 0.5)          ;; size of the number (large font)
(define *ahud-char-w* 22.0)              ;; width of one digit at scale 1.0, in hud pixels; only used to centre the number. Tune if it sits off-centre

;; green "v" over every living minion (two thin 3D lines in the world, no font, no format string)
(define *ahud-tags* #t)                 ;; #f = no markers
(define *ahud-tag-size* 2048.0)         ;; size of the v (1.2 m)
(define *ahud-tag-strokes* 1)           ;; 1 = a single line "v"; 2 = drawn twice, 10 cm apart (looks like a doubled v)
(define *ahud-tag-range* 327680.0)      ;; markers only within this distance of the bot (80 m)
(define *ahud-tag-h-sd* 10240.0)         ;; height of the v's tip above a spydroid's origin (2.5 m)
(define *ahud-tag-h-st* 4096.0)        ;; ... a sentinel (1.0 m)
(define *ahud-tag-h-rg* 20480.0)        ;; ... a roboguard (5.0 m)
(define *ahud-tag-h-bb* 32768.0)        ;; ... the allied bombbot (8 m)
(define *ahud-tag-color* (new 'static 'rgba :g #xff :a #x80))
(define *ahud-tag-tip* (new 'global 'vector))
(define *ahud-tag-a* (new 'global 'vector))
(define *ahud-tag-b* (new 'global 'vector))

;; living minions per kind, written by ahud-count-allies every frame
(define *ahud-n-sd* 0)                  ;; spydroids
(define *ahud-n-st* 0)                  ;; sentinels
(define *ahud-n-rg* 0)                  ;; roboguards
(define *ahud-n-bb* 0)                  ;; allied bombbots

;; the hud process that draws the boxes (spawned by blast-ally-hud-update)
(deftype blast-ally-hud (hud)
  ()
  )
(define *ahud-hud-handle* (the-as handle #f))
(define *ahud-hud-retry* (the-as time-frame 0))
(define *ahud-hud-fails* 0)                   ;; spawns in a row that did not leave a living hud (the retry delay doubles each time)
(define *ahud-kill-strays* #t)                ;; #t: remove every blast-ally-hud except the current one (see ahud-remove-strays)
(define *ahud-stray-next* (the-as time-frame 0))

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; One coloured rectangle on a hud sprite
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmacro ahud-rect! (spr px py pw ph cr cg cb)
  ;; top-left (px, py), size pw x ph in hud pixels (all ints), colour 0..255. A width or height of 0 hides the sprite.
  ;; The hud draws sprites with the usual PS2 modulate (128 = texture colour), so the colour is halved.
  `(let ((rect-s ,spr))
     (set-hud-piece-position! rect-s ,px ,py)
     (set! (-> rect-s pos z) #xfffff0)
     (set! (-> rect-s scale-x) (* 0.25 (the float ,pw)))
     (set! (-> rect-s scale-y) (* 0.25 (the float ,ph)))
     (set! (-> rect-s color x) (/ ,cr 2))
     (set! (-> rect-s color y) (/ ,cg 2))
     (set! (-> rect-s color z) (/ ,cb 2))
     0
     )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Counting
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ahud-alive? ((p process))
  ;; #f for an ally that is already dying / dead (enemies carry a focus-status, the sentinel is a plain drawable)
  (let ((f (as-type p process-focusable)))
    (if f
        (not (logtest? (-> f focus-status) (focus-status dead inactive)))
        #t
        )
    )
  )

(defun ahud-tag! ((p process) (height float) (owner process))
  ;; a green "v" (pointing down) above minion P, facing the camera. One stroke by default (*ahud-tag-strokes*).
  (when *ahud-tags*
    (let ((pd (the-as process-drawable p))
          (bot (the-as process-drawable owner))
          )
      (when (and pd bot (< (vector-vector-distance (-> pd root trans) (-> bot root trans)) *ahud-tag-range*))
        (let ((tip *ahud-tag-tip*)
              (a *ahud-tag-a*)
              (b *ahud-tag-b*)
              (r (-> (camera-matrix) rvec))
              (s *ahud-tag-size*)
              )
          (dotimes (i *ahud-tag-strokes*)
            (let ((o (* (the float i) 409.6)))
              (vector-copy! tip (-> pd root trans))
              (+! (-> tip y) height)
              (vector+*! tip tip r o)
              (vector-copy! a tip)
              (+! (-> a y) s)
              (vector+*! a a r (* -0.6 s))
              (vector-copy! b tip)
              (+! (-> b y) s)
              (vector+*! b b r (* 0.6 s))
              (add-debug-line #t (bucket-id debug-no-zbuf1) a tip *ahud-tag-color* #f (the-as rgba -1))
              (add-debug-line #t (bucket-id debug-no-zbuf1) b tip *ahud-tag-color* #f (the-as rgba -1))
              )
            )
          )
        )
      )
    )
  0
  )

(defun ahud-count-allies ((owner process))
  ;; all allies are spawned under *entity-pool*: walk it and count (no handles, no arrays)
  (let ((sd 0)
        (st 0)
        (rg 0)
        (bb 0)
        (c (-> *entity-pool* child))
        )
    (while c
      (let ((proc (the-as process (-> c 0))))
        (cond
          ((type? proc bombbot-ally)
           (when (ahud-alive? proc)
             (+! bb 1)
             (ahud-tag! proc *ahud-tag-h-bb* owner)
             )
           )
          ((type? proc roboguard-ally)
           (when (ahud-alive? proc)
             (+! rg 1)
             (ahud-tag! proc *ahud-tag-h-rg* owner)
             )
           )
          ((type? proc sentinel-ally)
           (when (ahud-alive? proc)
             (+! st 1)
             (ahud-tag! proc *ahud-tag-h-st* owner)
             )
           )
          ((type? proc spydroid-ally)
           (when (ahud-alive? proc)
             (+! sd 1)
             (ahud-tag! proc *ahud-tag-h-sd* owner)
             )
           )
          )
        )
      (set! c (-> c 0 brother))
      )
    (when (and *ahud-debug*
               (or (!= sd *ahud-n-sd*) (!= st *ahud-n-st*) (!= rg *ahud-n-rg*) (!= bb *ahud-n-bb*))
               )
      (format 0 "Ally HUD: spydroids ~D, sentinels ~D, roboguards ~D, bombbots ~D~%" sd st rg bb)
      )
    (set! *ahud-n-sd* sd)
    (set! *ahud-n-st* st)
    (set! *ahud-n-rg* rg)
    (set! *ahud-n-bb* bb)
    )
  0
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Drawing (called from blast-bot-hud's draw method)
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ahud-box! ((this hud) (first int) (kind int) (n int) (cell int))
  ;; Box of one kind. Sprites used (relative to FIRST): spydroid 0-6, sentinel 7-11, roboguard 12-14, bombbot 15-21.
  ;; Every box: light border, dark inside, the icon in the middle (drawn for a 32 x 32 inside, the default box size),
  ;; the number centred right under the box.
  (let* ((s (case kind ((0) 0) ((1) 7) ((2) 12) (else 15)))
         (count (case kind ((0) 7) ((1) 5) ((2) 3) (else 7)))
         (x (+ *ahud-x* (* cell (+ *ahud-gap*))))
         (y *ahud-y*)
         (ix (+ x 4))
         (iy (+ y 4))
         (inner (- *ahud-box* 9))
         (show (and (> n 0) (>= cell 0)))
         )
    ;; hide everything of this kind first, then draw it when it is shown
    (dotimes (i count)
      (set! (-> this sprites (+ first s i) scale-x) 0.0)
      (set! (-> this sprites (+ first s i) scale-y) 0.0)
      )
    (cond
      (show
        (ahud-rect! (-> this sprites (+ first s)) x y *ahud-box* *ahud-box* 170 170 170)
        (ahud-rect! (-> this sprites (+ first s 1)) ix iy inner inner 20 20 24)
        (case kind
          ((0)
           ;; red circle: 7 x 7 cells of 3 hud pixels (21 x 21, centred in the 31 x 31 inside), rows 3 / 5 / 7 / 7 / 7 / 5 / 3 cells wide
           (ahud-rect! (-> this sprites (+ first s 2)) (+ ix 10) (+ iy 5)  8 3 255 40 40)
           (ahud-rect! (-> this sprites (+ first s 3)) (+ ix 7)  (+ iy 8)  15 3 255 40 40)
           (ahud-rect! (-> this sprites (+ first s 4)) (+ ix 4)  (+ iy 11) 22 9 255 40 40)
           (ahud-rect! (-> this sprites (+ first s 5)) (+ ix 7)  (+ iy 20) 15 3 255 40 40)
           (ahud-rect! (-> this sprites (+ first s 6)) (+ ix 10) (+ iy 23) 8 3 255 40 40)
           )
          ((1)
           ;; yellow triangle: three rows, 5 / 12 / 20 wide
           (ahud-rect! (-> this sprites (+ first s 2)) (+ ix 11) (+ iy 6)  5 6 255 220 0)
           (ahud-rect! (-> this sprites (+ first s 3)) (+ ix 8)  (+ iy 12) 12 6 255 220 0)
           (ahud-rect! (-> this sprites (+ first s 4)) (+ ix 5) (+ iy 18) 20 8 255 220 0)
           )
          ((2)
           ;; blue square
           (ahud-rect! (-> this sprites (+ first s 2)) (+ ix 6) (+ iy 8) 16 16 60 120 255)
           )
          (else
            ;; purple X: four corner blocks and a centre block
           (ahud-rect! (-> this sprites (+ first s 2)) (+ ix 3)  (+ iy 6)  6 6 170 60 255)
           (ahud-rect! (-> this sprites (+ first s 3)) (+ ix 17) (+ iy 6)  6 6 170 60 255)
           (ahud-rect! (-> this sprites (+ first s 4)) (+ ix 3)  (+ iy 20) 6 6 170 60 255)
           (ahud-rect! (-> this sprites (+ first s 5)) (+ ix 17) (+ iy 20) 6 6 170 60 255)
           (ahud-rect! (-> this sprites (+ first s 6)) (+ ix 9) (+ iy 12) 9 8 170 60 255)
            )
          )
        ;; the number: string KIND, centred under the box (x = 0 hides it)
        (let* ((digits (cond ((< n 10) 1) ((< n 100) 2) (else 3)))
               (tw (* (the float digits) *ahud-char-w* *ahud-text-scale*))
               (cx (+ x (/ *ahud-box* 2)))
               )
          (format (clear (-> this strings kind text)) "~D" n)
          (set! (-> this strings kind scale) *ahud-text-scale*)
          (set! (-> this strings kind pos x) (the int (- (the float cx) (* 0.5 tw))))
          (set! (-> this strings kind pos y) (+ y *ahud-box* *ahud-text-gap*))
          )
        )
      (else
        (set! (-> this strings kind pos x) 0)
        )
      )
    )
  0
  )

(defun ahud-draw-boxes ((this hud) (first int))
  ;; FIRST = the first sprite the boxes may use (strings 0-3 are used for the numbers). Only the blast-ally-hud draws them:
  ;; blast-bot-hud still calls this with 15, which does nothing.
  (let ((cell 0))
    (when (not (type? this blast-ally-hud))
      (return 0)
      )
    (when (not *ahud-enabled*)
      (set! cell -1)   ;; hides everything
      )
    (ahud-box! this first 0 *ahud-n-sd* cell)
    (when (and (>= cell 0) (> *ahud-n-sd* 0))
      (+! cell 1)
      )
    (ahud-box! this first 1 *ahud-n-st* cell)
    (when (and (>= cell 0) (> *ahud-n-st* 0))
      (+! cell 1)
      )
    (ahud-box! this first 2 *ahud-n-rg* cell)
    (when (and (>= cell 0) (> *ahud-n-rg* 0))
      (+! cell 1)
      )
    (ahud-box! this first 3 *ahud-n-bb* cell)
    )
  0
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The hud process that draws the boxes
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmethod draw ((this blast-ally-hud))
  (ahud-draw-boxes this 0)
  ((method-of-type hud draw) this)
  0
  (none)
  )

(defmethod update-values! ((this blast-ally-hud))
  (logclear! (-> this flags) (hud-flags disable))
  ((method-of-type hud update-values!) this)
  0
  (none)
  )

(defmethod init-callback ((this blast-ally-hud))
  ;; same setup as blast-bot-hud, but on the stock health hud's gui channel (hud-lower-left-1): that hud is hidden while you sit in the bot,
  ;; and two huds on one channel can't both show (the second one stays 'pending'), so it must not share the bot hud's channel.
  ;; white sprites hidden (scale 0), strings 0-3 = the counts (pos x 0 = hidden)
  (set! (-> this level) (level-get-target-inside *level*))
  (set! (-> this gui-id)
        (add-process *gui-control* this (gui-channel hud-lower-left-1) (gui-action hidden) (-> this name) 81920.0 0)
        )
  (logior! (-> this flags) (hud-flags show))
  (dotimes (i 30)
    (set! (-> this sprites i tid) (the-as texture-id (get-texture common-white common)))
    (set! (-> this sprites i flags) (hud-sprite-flags))
    (set! (-> this sprites i scale-x) 0.0)
    (set! (-> this sprites i scale-y) 0.0)
    )
  (dotimes (i 4)
    (alloc-string-if-needed this i)
    (set! (-> this strings i scale) *ahud-text-scale*)
    (set! (-> this strings i color) (font-color white))
    (set! (-> this strings i flags) (font-flags shadow kerning large))
    (set! (-> this strings i pos x) 0)
    )
  0
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Stray cleanup
;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Every blast-ally-hud holds a gui-engine connection (add-process in init-callback). The engine has a fixed number of them: when
;; huds of earlier bots stay alive ("rogue level entity ... blast-ally-hud ... still alive" in the console) the engine fills up and
;; then the RACE HUD (laps), the win cutscene's scene-player and Jak himself fail with "could not connection ... to gui engine".
;; So every 2 seconds every blast-ally-hud that is not the current one is deactivated (which frees its connection).
(define-extern ahud-remove-strays (function process-tree process int))
(defun ahud-remove-strays ((tree process-tree) (keep process))
  (let ((n 0)
        (p (-> tree child))
        )
    (while p
      (let ((next (-> p 0 brother))
            (is-stray (and (= (-> p 0 type symbol) 'blast-ally-hud)
                           (!= (the-as process (-> p 0)) keep)
                           )
                      )
            )
        (+! n (ahud-remove-strays (-> p 0) keep))
        (when is-stray
          (deactivate (the-as process (-> p 0)))
          (+! n 1)
          )
        (set! p next)
        )
      )
    n
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Called every frame by blast-bot-update-hud (blastbot-main-mod.gc)
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun blast-ally-hud-update ((owner process))
  (when *ahud-enabled*
    (ahud-count-allies owner)
    ;; throw away every blast-ally-hud that is not the current one (leaked huds fill the gui engine)
    (when (and *ahud-kill-strays* (>= (current-time) *ahud-stray-next*))
      (set! *ahud-stray-next* (+ (current-time) (seconds 2)))
      (let ((n (+ (ahud-remove-strays *active-pool* (handle->process *ahud-hud-handle*))
                  (ahud-remove-strays *entity-pool* (handle->process *ahud-hud-handle*))
                  )
               )
            )
        (if (> n 0)
            (format 0 "Ally HUD: removed ~D stray ally huds~%" n)
            )
        )
      )
    (cond
      ((handle->process *ahud-hud-handle*)
       (set! *ahud-hud-fails* 0)
       )
      ((>= (current-time) *ahud-hud-retry*)
       ;; spawn the box hud as a child of the bot (it goes away with the bot). When a spawn does not stick (for example the gui
       ;; engine is full) the next try waits twice as long, up to 32 s, so this can never turn into a flood of failing spawns
       (set! *ahud-hud-retry* (+ (current-time) (* (seconds 1) (ash 1 (min 5 *ahud-hud-fails*)))))
       (+! *ahud-hud-fails* 1)
       (set! *ahud-hud-handle*
             (ppointer->handle (process-spawn blast-ally-hud :init hud-init-by-other :name "blast-ally-hud" :to owner))
             )
       )
      )
    )
  0
  )

;; load check
(format 0 "blastbot-allyhud.gc loaded~%")