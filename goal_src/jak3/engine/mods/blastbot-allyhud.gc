;;-*-Lisp-*-
(in-package goal)

;; name: blastbot-allyhud.gc
;; name in dgo: blastbot-allyhud
;; dgos: GAME

;; The minion part of the Blast Bot's HUD (spydroid-ally, sentinel-ally, roboguard-ally).
;;
;; COMPACT VERSION. The old version gave every minion a numbered slot (handle array), a floating label and an icon with a
;; bar under it. That is gone. Now:
;;   - once a frame the entity pool is walked and the living minions of each kind are COUNTED (no slots, no handles);
;;   - the top-left of the screen shows one square box per kind that has at least one minion alive:
;;         [red square]  10     [yellow triangle]  2     [blue X]  4
;;     the boxes sit next to each other and close up when a kind is empty; the number is centred under its box.
;;   - there is NO second hud process: the boxes are drawn by the bot's own hud (blast-bot-hud in blastbot-main-mod.gc),
;;     which hands itself to ahud-draw-boxes below. They use its sprites 15..29 and its text strings 0..2.
;;
;; Needs, in game.gd:  "blastbot-allyhud.o"  after spydroid-ally.o, sentinel-ally.o, roboguard-ally.o
;; and before blastbot-main-mod.o (which calls blast-ally-hud-update and ahud-draw-boxes).

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Knobs (set from the REPL)
;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ahud-enabled* #t)              ;; #f = no counting and no boxes
(define *ahud-debug* #f)                ;; #t: log the counts whenever they change
;; layout (hud pixels, 512 x 416)
(define *ahud-x* 15)                    ;; left edge of the first box
(define *ahud-y* 20)                    ;; top edge of the boxes
(define *ahud-box* 40)                  ;; outer size of a box (square); the border is 4 pixels, so the inside is box - 8
(define *ahud-gap* 35)                   ;; gap between two boxes (Doesn't work?)
(define *ahud-text-gap* 2)              ;; gap between a box and its number
(define *ahud-text-scale* 0.5)          ;; size of the number (large font)
(define *ahud-char-w* 22.0)              ;; width of one digit at scale 1.0, in hud pixels; only used to centre the number. Tune if it sits off-centre

;; living minions per kind, written by ahud-count-allies every frame
(define *ahud-n-sd* 0)                  ;; spydroids
(define *ahud-n-st* 0)                  ;; sentinels
(define *ahud-n-rg* 0)                  ;; roboguards

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; One coloured rectangle on a hud sprite
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmacro ahud-rect! (spr px py pw ph cr cg cb)
  ;; top-left (px, py), size pw x ph in hud pixels (all ints), colour 0..255. A width or height of 0 hides the sprite.
  ;; The hud draws sprites with the usual PS2 modulate (128 = texture colour), so the colour is halved.
  `(let ((rect-s ,spr))
     (set-hud-piece-position! rect-s ,px ,py)
     (set! (-> rect-s pos z) #xfffff0)
     (set! (-> rect-s scale-x) (* 0.25 (the float ,pw)))
     (set! (-> rect-s scale-y) (* 0.25 (the float ,ph)))
     (set! (-> rect-s color x) (/ ,cr 2))
     (set! (-> rect-s color y) (/ ,cg 2))
     (set! (-> rect-s color z) (/ ,cb 2))
     0
     )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Counting
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ahud-alive? ((p process))
  ;; #f for an ally that is already dying / dead (enemies carry a focus-status, the sentinel is a plain drawable)
  (let ((f (as-type p process-focusable)))
    (if f
        (not (logtest? (-> f focus-status) (focus-status dead inactive)))
        #t
        )
    )
  )

(defun ahud-count-allies ()
  ;; all allies are spawned under *entity-pool*: walk it and count (no handles, no arrays)
  (let ((sd 0)
        (st 0)
        (rg 0)
        (c (-> *entity-pool* child))
        )
    (while c
      (let ((proc (the-as process (-> c 0))))
        (cond
          ((type? proc roboguard-ally)
           (if (ahud-alive? proc) (+! rg 1))
           )
          ((type? proc sentinel-ally)
           (if (ahud-alive? proc) (+! st 1))
           )
          ((type? proc spydroid-ally)
           (if (ahud-alive? proc) (+! sd 1))
           )
          )
        )
      (set! c (-> c 0 brother))
      )
    (when (and *ahud-debug*
               (or (!= sd *ahud-n-sd*) (!= st *ahud-n-st*) (!= rg *ahud-n-rg*))
               )
      (format 0 "Ally HUD: spydroids ~D, sentinels ~D, roboguards ~D~%" sd st rg)
      )
    (set! *ahud-n-sd* sd)
    (set! *ahud-n-st* st)
    (set! *ahud-n-rg* rg)
    )
  0
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Drawing (called from blast-bot-hud's draw method)
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ahud-box! ((this hud) (first int) (kind int) (n int) (cell int))
  ;; Box of one kind. Sprites used (relative to FIRST): spydroid 0-2, sentinel 3-7, roboguard 8-14.
  ;; Every box: light border, dark inside, the icon in the middle (drawn for a 32 x 32 inside, the default box size),
  ;; the number centred right under the box.
  (let* ((s (case kind ((0) 0) ((1) 3) (else 8)))
         (count (case kind ((0) 3) ((1) 5) (else 7)))
         (x (+ *ahud-x* (* cell (+ *ahud-gap*))))
         (y *ahud-y*)
         (ix (+ x 4))
         (iy (+ y 4))
         (inner (- *ahud-box* 8))
         (show (and (> n 0) (>= cell 0)))
         )
    ;; hide everything of this kind first, then draw it when it is shown
    (dotimes (i count)
      (set! (-> this sprites (+ first s i) scale-x) 0.0)
      (set! (-> this sprites (+ first s i) scale-y) 0.0)
      )
    (cond
      (show
        (ahud-rect! (-> this sprites (+ first s)) x y *ahud-box* *ahud-box* 170 170 170)
        (ahud-rect! (-> this sprites (+ first s 1)) ix iy inner inner 20 20 24)
        (case kind
          ((0)
           ;; red square
           (ahud-rect! (-> this sprites (+ first s 2)) (+ ix 7) (+ iy 8) 16 16 255 40 40)
           )
          ((1)
           ;; yellow triangle: three rows, 5 / 12 / 20 wide
           (ahud-rect! (-> this sprites (+ first s 2)) (+ ix 11) (+ iy 6)  5 6 255 220 0)
           (ahud-rect! (-> this sprites (+ first s 3)) (+ ix 8)  (+ iy 12) 12 6 255 220 0)
           (ahud-rect! (-> this sprites (+ first s 4)) (+ ix 5) (+ iy 18) 20 8 255 220 0)
           )
          (else
            ;; blue X: four corner blocks and a centre block
           (ahud-rect! (-> this sprites (+ first s 2)) (+ ix 4)  (+ iy 6)  6 6 60 120 255)
           (ahud-rect! (-> this sprites (+ first s 3)) (+ ix 18) (+ iy 6)  6 6 60 120 255)
           (ahud-rect! (-> this sprites (+ first s 4)) (+ ix 4)  (+ iy 20) 6 6 60 120 255)
           (ahud-rect! (-> this sprites (+ first s 5)) (+ ix 18) (+ iy 20) 6 6 60 120 255)
           (ahud-rect! (-> this sprites (+ first s 6)) (+ ix 10) (+ iy 12) 9 8 60 120 255)
            )
          )
        ;; the number: string KIND, centred under the box (x = 0 hides it)
        (let* ((digits (cond ((< n 10) 1) ((< n 100) 2) (else 3)))
               (tw (* (the float digits) *ahud-char-w* *ahud-text-scale*))
               (cx (+ x (/ *ahud-box* 2)))
               )
          (format (clear (-> this strings kind text)) "~D" n)
          (set! (-> this strings kind scale) *ahud-text-scale*)
          (set! (-> this strings kind pos x) (the int (- (the float cx) (* 0.5 tw))))
          (set! (-> this strings kind pos y) (+ y *ahud-box* *ahud-text-gap*))
          )
        )
      (else
        (set! (-> this strings kind pos x) 0)
        )
      )
    )
  0
  )

(defun ahud-draw-boxes ((this hud) (first int))
  ;; FIRST = the first of the 15 sprites the boxes may use (strings 0, 1, 2 are used for the numbers)
  (let ((cell 0))
    (when (not *ahud-enabled*)
      (set! cell -1)   ;; hides everything
      )
    (ahud-box! this first 0 *ahud-n-sd* cell)
    (when (and (>= cell 0) (> *ahud-n-sd* 0))
      (+! cell 1)
      )
    (ahud-box! this first 1 *ahud-n-st* cell)
    (when (and (>= cell 0) (> *ahud-n-st* 0))
      (+! cell 1)
      )
    (ahud-box! this first 2 *ahud-n-rg* cell)
    )
  0
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Called every frame by blast-bot-update-hud (blastbot-main-mod.gc)
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun blast-ally-hud-update ((owner process))
  (if *ahud-enabled*
      (ahud-count-allies)
      )
  0
  )

;; load check
(format 0 "blastbot-allyhud.gc loaded~%")