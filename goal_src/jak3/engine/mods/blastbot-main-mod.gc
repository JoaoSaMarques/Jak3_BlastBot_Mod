;;-*-Lisp-*-
(in-package goal)

;; name: blastbot-main-mod.gc
;; name in dgo: blastbot-main-mod
;; dgos: GAME

;; Everything about the player's Blast Bot (the bombbot mech) that used to sit in mod-common-functions.gc:
;; the blast-bot-player process (legs, body, turret, jump, hover, dash, shield, health, death), its HUD, the spawn /
;; despawn functions (spawn-my-bombbot, despawn-my-bombbot, blast-bot-pad-check) and the touch / attack handling.
;; mod-common-functions.gc is back to the stock mod template.
;;
;; Needs, in game.gd, in this order:
;;   spydroid-ally.o, sentinel-ally.o, roboguard-ally.o, blastbot-ordnance.o, blastbot-allyhud.o   (all before)
;;   mod-common-functions.o
;;   blastbot-main-mod.o        <- this file
;;   blastbot_guns.o            (needs the blast-bot-player type from here)
;; and anything that calls spawn-my-bombbot / blast-bot-pad-check (your mod-custom-code.gc) after this file.
;; The weapons are in blastbot_guns.gc; this file reaches them through the define-extern lines below.

(deftype blast-bot-player (process-focusable)
  ((speed            float)
   (next-shot        time-frame)
   (debug-frame-count int32)
   ;; leg system (copied in simplified form from bombbot.gc)
   (joint-ik         joint-mod-ik 4)
   (foot-pos         vector       4 :inline) ;; where each foot is planted
   (foot-next        vector       4 :inline) ;; where each foot is stepping to
   (foot-speed       vector       4 :inline) ;; smoothed foot lead velocity
   (foot-moving      symbol       4)
   (last-trans       vector       :inline)
   (linear-speed     vector       :inline)
   (last-yaw         float)
   (yaw-velocity     float)
   ;; turret / gun aiming (copied in simplified form from bombbot.gc)
   (target-pos       vector       :inline) ;; world point the turret aims at (where the camera looks)
   (top-quat         quaternion   :inline)
   (angle-turret     float)
   (angle-gun        float)
   (extra-angle-gun  float)
   (gun-rotation-speed float)
   ;; v3 additions
   (foot-cool        time-frame   4)   ;; per-foot stomp cooldown
   (tilt-x           float)            ;; head tilt (opposite the lifted leg), body frame
   (tilt-z           float)
   (input-yaw        float)            ;; world yaw of the stick direction
   (input-active     symbol)
   (lock-handle      handle)           ;; enemy the turret is locked on to
   (locked           symbol)
   ;; v4 additions: head heading + jump
   (head-yaw         float)            ;; world yaw the head faces (only changes with stick input)
   (jump-mode        int32)            ;; 0 ground, 1 crouch, 2 airborne, 3 landing recovery
   (jump-timer       time-frame)
   (jump-vy          float)
   (jump-vx          float)
   (jump-vz          float)
   (jump-fuel        float)            ;; 0..1 thruster fuel
   (jump-x-released  symbol)           ;; X must be let go after take-off before the thruster arms
   (thrusting        symbol)
   (crouch-depth     float)
   (ground-y         float)
   ;; v5 additions
   (ramp             float)            ;; board-style speed multiplier, 1.0 .. *blast-bot-ramp-max*
   (gait-phase       float)            ;; 0..1 gait clock (runs faster as the ramp builds)
   (hover-blend      float)            ;; 0..1, R2 hover pose
   (hover-lift       float)            ;; how far the body is raised while hovering
   (hover-on         symbol)           ;; hover is a toggle (R2 press)
   (dash-until       time-frame)       ;; Square charge
   (dash-ready       time-frame)
   (dash-yaw         float)
   (dash-id          uint32)            ;; one attack id per charge, so every enemy is only hit once
   (leg-id           uint32)            ;; attack id for leg touches, refreshed every 0.4s
   (leg-id-time      time-frame)
   (shield-handle    handle)           ;; the mech-shield process (target-mech.gc)
   (shield-on        symbol)
   (shield-open-until time-frame)      ;; shield hit sphere is switched off until then so our own shots can leave it
   (laser-end        vector       :inline)
   ;; v6 additions
   (hover-vx         float)            ;; hover glide velocity (units/sec), the bot keeps drifting after the stick is released
   (hover-vz         float)
   (shield-live      symbol)           ;; a shield process was spawned, so "gone" afterwards means it broke
   (shield-broken-until time-frame)    ;; 0 = shield intact, otherwise the time the broken shield is rebuilt
   (cam-zoom         float)            ;; camera pull-back factor while moving fast
   (cam-zoom-set     float)            ;; factor the camera settings were last set to
   (ride-retry       time-frame)       ;; next time we may try to put Jak back into the bot
   (ext-pos          vector       :inline) ;; root position at the end of our own last update; any difference later = moved by a platform (rider pull)
   ;; v7 additions: health + hud
   (health           float)            ;; 0 .. max-health, the bot is destroyed at 0
   (max-health       float)
   (hit-until        time-frame)       ;; short invulnerability window after every hit
   (last-hit-id      uint32)           ;; attack id of the last hit that landed (the same id is never counted twice)
   (hit-flash        float)            ;; 1.0 right after a hit, fades out; makes the health bar flash
   (hud-handle       handle)           ;; the blast-bot-hud process (health bar + fuel bar)
   (hud-retry        time-frame)       ;; next time we may try to (re)spawn the hud
   (aggro-shape      collide-shape-moving) ;; second collider in the player list so enemies find the bot
   )
  (:state-methods
    active
    die
    )
  )

(defskelgroup skel-blast-bot bombbot bombbot-lod0-jg bombbot-idle-ja
              ((bombbot-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 12)
              :shadow bombbot-shadow-mg
              :texture-level 10
              )

;; ---- Blast Bot legs ----------------------------------------------------
;; The bombbot has no walk animation. Its legs are 4 IK limbs whose targets are
;; moved by a time based gait; the skeleton just plays the 1 frame idle.

;; debug switches, flip from the REPL (after (lt)): (set! *blast-bot-legs-on* #f)
(define *blast-bot-legs-on* #t)
(define *blast-bot-ground-follow* #t)
;; on-screen platform / rider debug text (top-left console); set to #f from the REPL to hide it
(define *blast-bot-debug-ride* #f)
(define *blast-bot-ride-seen* (the-as string #t))

;; #t = everything the bot kills counts as Jak's kill (mission kill counters). Side effect: enemies see Jak as their
;; attacker. #f = the bot is its own attacker, which is the old behaviour where enemies fought back at the bot.
(define *blast-bot-credit-jak* #t) ;; ATTACK TEST
;; #t = the bot's guard-shot is also credited to Jak. Kept separate because crediting shots made the NPCs' own guard shots stop firing.
;; not crediting morphgun for kills in arena
;; when this is #t and blast-bot-use-morphgun is #f, npcs stop firing. If both are #t, npcs are able to fire again but morphgun still doesn't give credit
(define *blast-bot-credit-shots* #f)
;; #t = the turret fires Jak's red morphgun shot (gun-red-1) instead of the guard shot. #f = old guard shot.
(define *blast-bot-use-morphgun* #t)
;; Weapons live in blastbot_guns.gc, which is compiled AFTER this file (it needs the blast-bot-player type), so the
;; bot's own code reaches them through these forward declarations.
(define-extern blast-bot-gun-select (function none))
(define-extern blast-bot-heat-update (function float none))
(define-extern blast-bot-heat-text (function none))
(define-extern blast-bot-yellow-update (function blast-bot-player none))
(define-extern blast-bot-scan-update (function blast-bot-player none))
(define-extern blast-bot-fire-input (function blast-bot-player none))
;; L2 spy-bot (blastbot-spybot.gc). While *blast-bot-spy-active* the bot stands idle: no steering, jumping, dash, hover,
;; shield or shooting, and the camera zooms in (*blast-bot-spy-cam-zoom*, 1.0 = the normal distance) on the droid.
(define *blast-bot-spy-active* #f)
(define *blast-bot-spy-cam-zoom* 0.4)
(define *blast-bot-spy-turret-speed* 5461.33)   ;; while spying, the turret spins this fast, in angle units per second (65536 = 360 degrees: 5461 = 30 degrees/s, one turn in 12 s)
(define *blast-bot-spy-turret-angle* 0.0)
(define-extern spybot-toggle (function none))


(defun blast-bot-credit-jak! ((info attack-info))
  ;; Name Jak as the attacker. Mission kill counters (e.g. the marauder arena fights) only count a kill when the
  ;; last attacker is a process of type target; the bot is its own process type, so without this nothing it kills counts.
  (when (and *target* *blast-bot-credit-jak*)
    (set! (-> info attacker) (process->handle *target*))
    (logior! (-> info mask) (attack-mask attacker))
    )
  info
  )
;; seconds between the two legs of a diagonal pair (front leg first, then the back one)
(define *blast-bot-leg-delay* 0.1)
;; how fast the body turns toward the stick direction (rotation units/sec, 21845 = 120 deg/s)
(define *blast-bot-body-turn-rate* 21845.0)
;; wall blocking: radius of the sweep sphere, and how high above the ground it is centred
(define *blast-bot-wall-radius* 14336.0)
(define *blast-bot-wall-height* 20480.0)
;; how much of the leg-lift tilt goes into the body the legs hang from. The head gets the rest,
;; so the head's total tilt is unchanged and the body tilts too (it also carries the head).
(define *blast-bot-body-tilt-share* 0.5)
;; board-style speed ramp: 1x -> max over ramp-time seconds of holding the stick, reset by hitting a wall
(define *blast-bot-ramp-max* 3.0)
(define *blast-bot-ramp-time* 4.0)
;; R2 hover: how high (in game units, 4096 = 1m) the body floats
(define *blast-bot-hover-height* 12288.0)
;; Circle shield size (the stock shield's hit sphere radius is 1m x this).
;; Raise it until the shield fully covers the legs, otherwise shots can hit the bot's own colliders first.
(define *blast-bot-shield-size* 6.5)
;; Square charge speed (units/sec, 196608 = 48 m/s)
(define *blast-bot-dash-speed* 196608.0)
;; Jak is parked in target-grab-ride, which sets the 'grabbed' focus flag. Some doors / level borders refuse to
;; work while it is set, so it is cleared every frame. If this causes trouble: (set! *blast-bot-clear-grabbed* #f)
(define *blast-bot-clear-grabbed* #t)
(define *blast-bot-laser-on* #t)
;; hover inertia (units/sec^2, 4096 = 1m): how fast the hover velocity follows the stick, and how fast it bleeds off
;; once the stick is released. Lower decel = longer glide (49152 = about 4 s to stop from full speed).
(define *blast-bot-hover-accel* 163840.0)
(define *blast-bot-hover-decel* 49152.0)
;; laser pointer beam width in game units (bombbot's own is 0.15m + up to 0.1m random)
(define *blast-bot-laser-width* 1228.8)
;; extra camera distance at full hover speed (0.8 = camera ends up 80% further away)
(define *blast-bot-cam-pullback* 0.8)
(define *blast-bot-laser-width-rand* 819.2)
;; shield: seconds until a completely broken shield is rebuilt
(define *blast-bot-shield-recharge* 10.0)
;; health: the bot has max-health points. An attack that would cost Jak 1.0 damage costs the bot damage-scale points
;; (2.0 damage = 16 points with the defaults, so about 7 normal hits). Hits are ignored for invuln-time seconds after
;; each one, and while the Circle shield is up. God mode: (set! *blast-bot-god-mode* #t)
(define *blast-bot-max-health* 100.0)
(define *blast-bot-damage-scale* 1.0)
(define *blast-bot-invuln-time* 0.3)
;; damage per lava tick; ticks are paced by *blast-bot-invuln-time*
(define *blast-bot-lava-damage* 2.0)
(define *blast-bot-god-mode* #f)
;; prints every attack event that reaches the bot and what was done with it
;; BISECT SWITCHES for the junk-format crash (both came in with ShieldUpdate). #f = old behaviour (MarauderFix).
(define *blast-bot-touch-attack* #t) ;; ATTACK TEST   ;; enemy melee via 'touch + prims-touching-action? (logs "Bogus cshape value!")
(define *blast-bot-hud-shield-bar* #t)  ;; HUD sprites 6-8 + 'heat-ratio poll (came in with ShieldUpdate)
(defglobalconstant BLAST_BOT_SHIELD_OWNER_ATTACK #t) ;; ATTACK TEST ;; #t = send-shield-attack override below (ShieldUpdate); #f = stock method
(define *blast-bot-aggro-on* #t)     ;; MINIMAL TEST: #f = no aggro collider (enemies will ignore the bot)
(define *blast-bot-shield-spawn* #t) ;; MINIMAL TEST: #f = the shield process is never spawned
(define *blast-bot-leg-spheres* 3) ;; spheres per leg bone (2 bones per leg). 4 = the old layout (8 per leg, 36 prims total), which produced the junk text; 3 = 6 per leg, 28 prims total
(define *blast-bot-leg-limbs* 4)  ;; BISECT: how many legs get collision spheres (0..4). Set 0 to test the crash without any leg prims.
(define *blast-bot-reach-hack* #t)     ;; get-trans override that hands enemies the nearest point of the bot's footprint

(define *blast-bot-attack-debug* #f)
;; when the bot is destroyed Jak is thrown out of it; #t = he is killed too (normal death / checkpoint reload),
;; #f = he just walks away from the wreck
(define *blast-bot-death-kills-jak* #t)
(define *blast-bot-death-explosion* #t)

;; elbow joint index + hand distance for each limb, from *bombbot-ik-limb-setup*
(define *blast-bot-elbows* (new 'static 'boxed-array :type int32 19 13 15 17))
(define *blast-bot-hand-dist* (new 'static 'boxed-array :type float 14880.768 -14880.768 14880.768 -14880.768))

(define *blast-bot-hatred* 5.0)

(defun blast-bot-foot-phase ((i int))
  ;; Where in the 0.8s gait cycle foot i steps. Feet 0/2 and 3/1 are diagonal pairs,
  ;; the front foot (0, 3) goes first and the back foot follows *blast-bot-leg-delay* later.
  (let ((d (/ *blast-bot-leg-delay* 0.8)))
    (case i
      ((0) 0.0)
      ((2) d)
      ((3) 0.5)
      (else (+ 0.5 d))
      )
    )
  )

(defun blast-bot-foot-local ((out vector) (i int))
  ;; Rest position of foot i, relative to the body.
  (set-vector! out
               (if (< i 2) 11878.4 -11878.4)
               0.0
               (if (or (= i 0) (= i 3)) 10240.0 -10240.0)
               1.0)
  out
  )

(defun blast-bot-init-legs ((this blast-bot-player))
  ;; Call once, right after initialize-skeleton."
  (dotimes (i 4)
    (set! (-> this joint-ik i)
          (new 'process 'joint-mod-ik this (-> *blast-bot-elbows* i) (-> *blast-bot-hand-dist* i)))
    (set! (-> this joint-ik i elbow-pole-vector-axis) (the-as uint 2))
    (set! (-> this joint-ik i elbow-rotation-axis) (the-as uint 0))
    (logior! (-> this joint-ik i flags) (joint-mod-ik-flags elbow-rot-neg))
    (enable-set! (-> this joint-ik i) #t)
    )
  (logior! (-> this joint-ik 1 flags) (joint-mod-ik-flags elbow-trans-neg))
  (logior! (-> this joint-ik 3 flags) (joint-mod-ik-flags elbow-trans-neg))
  (dotimes (i 4)
    (let ((local (new 'stack-no-clear 'vector))
          (world (new 'stack-no-clear 'vector))
          )
      (blast-bot-foot-local local i)
      (vector-orient-by-quat! world local (-> this root quat))
      (vector+! world world (-> this root trans))
      (vector-copy! (-> this foot-pos i) world)
      (vector-copy! (-> this foot-next i) world)
      )
    (vector-reset! (-> this foot-speed i))
    (set! (-> this foot-moving i) #f)
    (set! (-> this foot-cool i) 0)
    )
  (vector-copy! (-> this last-trans) (-> this root trans))
  (vector-reset! (-> this linear-speed))
  (set! (-> this last-yaw) (quaternion-y-angle (-> this root quat)))
  (set! (-> this yaw-velocity) 0.0)
  (set! (-> this tilt-x) 0.0)
  (set! (-> this tilt-z) 0.0)
  (set! (-> this input-yaw) 0.0)
  (set! (-> this input-active) #f)
  (set! (-> this head-yaw) (quaternion-y-angle (-> this root quat)))
  (set! (-> this jump-mode) 0)
  (set! (-> this jump-fuel) 1.0)
  (set! (-> this jump-vy) 0.0)
  (set! (-> this jump-x-released) #f)
  (set! (-> this thrusting) #f)
  (set! (-> this crouch-depth) 0.0)
  (set! (-> this ground-y) (-> this root trans y))
  (set! (-> this ramp) 1.0)
  (set! (-> this gait-phase) 0.0)
  (set! (-> this hover-blend) 0.0)
  (set! (-> this hover-on) #f)
  (set! (-> this hover-lift) 0.0)
  (set! (-> this dash-until) 0)
  (set! (-> this dash-ready) 0)
  (set! (-> this leg-id-time) 0)
  (set! (-> this shield-on) #f)
  (set! (-> this shield-open-until) 0)
  (set! (-> this shield-handle) (the-as handle #f))
  (set! (-> this shield-live) #f)
  (set! (-> this shield-broken-until) 0)
  (set! (-> this hover-vx) 0.0)
  (set! (-> this hover-vz) 0.0)
  (set! (-> this cam-zoom) 1.0)
  (set! (-> this cam-zoom-set) 1.0)
  (set! (-> this ride-retry) (+ (current-time) (seconds 1)))
  (vector-copy! (-> this ext-pos) (-> this root trans))
  (none)
  )

;; ---- targets, stomps, camera shake ----

(defun blast-bot-ally? ((p process-focusable))
  ;; #t for the bot's own minions (Plasmite RPG spydroids, Gyro Burster sentinels, roboguards). The turret never locks
  ;; on to them, and stomps / the dash never hurt them.
  (or (type? p spydroid-ally)
      (type? p sentinel-ally)
      (type? p roboguard-ally)
      )
  )

(defun blast-bot-valid-target? ((this blast-bot-player) (p process-focusable))
  ;; Things the bot may stomp / lock on to.
  (and p
       (!= this p)
       (not (blast-bot-ally? p))
       (not (focus-test? p inactive))
       (not (focus-test? p disable))
       (not (focus-test? p dead))
       (not (blast-target-dead? p))
       (or (logtest? (process-mask enemy guard metalhead kg-robot) (-> p mask))
         (logtest? (process-mask vehicle) (-> p mask)))
       (not (logtest? (process-mask crate civilian) (-> p mask)))
       (not (logtest? (-> p focus-status) (focus-status disable dead ignore grabbed)))
       )
  )

(defun blast-bot-foot-attack ((this blast-bot-player) (pos vector) (radius float))
  ;; Foot collider: hurts every valid enemy within radius of pos.
  (let ((box (new 'stack-no-clear 'vector))
        (hits (new 'stack-no-clear 'array 'collide-shape 64))
        )
    (vector-copy! box pos)
    (set! (-> box w) radius)
    (countdown (i (fill-actor-list-for-box *actor-hash* box hits 64))
      (let ((cs (as-type (-> hits i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (and p
                       (blast-bot-valid-target? this p)
                       (< (vector-vector-distance (-> p root trans) pos) radius))
              (send-event p 'attack #f
                          (blast-bot-credit-jak!
                            (static-attack-info ((id (new-attack-id)) (damage 2.0) (mode 'explode)))))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-foot-landed ((this blast-bot-player) (i int))
  ;; A foot just planted: footstep camera shake (only while walking) + stomp.
  (when (< 0.2 (-> this speed))
    (if (not *blast-bot-spy-active*) (activate! *camera-smush-control* (* 256.0 (-> this speed)) 37 45 1.0 0.95 (-> this clock)))
    )
  (when (>= (current-time) (-> this foot-cool i))
    (set! (-> this foot-cool i) (+ (current-time) (seconds 0.3)))
    (blast-bot-foot-attack this (-> this foot-pos i) 16384.0)
    )
  (none)
  )

(defun blast-bot-update-legs ((this blast-bot-player))
  ;; Call every frame from :post BEFORE ja-post.
  (let ((q (new 'stack-no-clear 'collide-query))
        (fps (/ 1.0 (seconds-per-frame)))
        (swing 0.4)
        (tx 0.0)
        (tz 0.0)
        )
    ;; how fast is the body moving / turning (horizontal only)
    (vector-! (-> this linear-speed) (-> this root trans) (-> this last-trans))
    (vector-copy! (-> this last-trans) (-> this root trans))
    (set! (-> this linear-speed y) 0.0)
    (let ((yaw (quaternion-y-angle (-> this root quat))))
      (set! (-> this yaw-velocity) (deg- yaw (-> this last-yaw)))
      (set! (-> this last-yaw) yaw)
      )
    ;; gait clock: one cycle = 0.8s, faster while the speed ramp builds
    (+! (-> this gait-phase)
        (* (seconds-per-frame) 1.25 (+ 1.0 (* 0.5 (- (-> this ramp) 1.0)))))
    (when (>= (-> this gait-phase) 1.0)
      (set! (-> this gait-phase) (- (-> this gait-phase) 1.0))
      )
    ;; collect nearby ground triangles once, then probe per foot
    (let ((ext (new 'stack-no-clear 'vector)))
      (set-vector! ext 40960.0 24576.0 40960.0 1.0)
      (vector-! (-> q bbox min) (-> this root trans) ext)
      (vector+! (-> q bbox max) (-> this root trans) ext)
      )
    (set! (-> q collide-with) (collide-spec backgnd pusher hit-by-others-list))
    (set! (-> q ignore-process0) #f)
    (set! (-> q ignore-process1) #f)
    (set! (-> q ignore-pat)
          (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (fill-using-bounding-box *collide-cache* q)
    (dotimes (i 4)
      (let* ((phase (+ (-> this gait-phase) (blast-bot-foot-phase i)))
             (f0 (- phase (the float (the int phase))))
             ;; while crouching / recovering from a jump every foot stays planted
             (f (if (or (= (-> this jump-mode) 1) (= (-> this jump-mode) 3)) 0.9 f0))
             (cur (new 'stack-no-clear 'vector))
             (local (new 'stack-no-clear 'vector))
             (rel (new 'stack-no-clear 'vector))
             (rest (new 'stack-no-clear 'vector))
             (diff (new 'stack-no-clear 'vector))
             (hov (new 'stack-no-clear 'vector))
             )
        ;; rest position of this foot under the body right now
        (blast-bot-foot-local local i)
        (vector-orient-by-quat! rel local (-> this root quat))
        (vector+! rest rel (-> this root trans))
        (cond
          ((= (-> this jump-mode) 2)
           ;; the bot is airborne: legs hang below the body (blended in from where they were planted)
           (let ((b (fmin 1.0 (/ (the float (- (current-time) (-> this jump-timer))) 45.0))))
             (set! (-> this foot-moving i) #f)
             (vector-copy! cur rest)
             (set! (-> cur y) (- (-> this root trans y) 6144.0))
             (vector-! diff cur (-> this foot-pos i))
             (vector+*! cur (-> this foot-pos i) diff b)
             )
           )
          ((>= swing f)
           ;; foot is in the air: aim ahead of the body, snap that spot to the ground
           (let ((spin (new 'stack-no-clear 'vector))
                 (want (new 'stack-no-clear 'vector))
                 (tgt (new 'stack-no-clear 'vector))
                 (frac (/ f swing))
                 )
             (set-vector! spin 0.0 (sin (* (-> this yaw-velocity) fps)) 0.0 1.0)
             (vector-cross! want spin rel)
             (vector+*! want want (-> this linear-speed) fps)
             (vector-! diff want (-> this foot-speed i))
             (vector+*! (-> this foot-speed i) (-> this foot-speed i) diff (* 4.0 (seconds-per-frame)))
             (when (< 36864.0 (vector-length (-> this foot-speed i)))
               (vector-normalize! (-> this foot-speed i) 36864.0)
               )
             ;; step ahead, but never more than 2m (stops the legs overreaching on sharp turns)
             (vector-float*! diff (-> this foot-speed i) (+ 0.2 (- swing f)))
             (when (< 8192.0 (vector-length diff))
               (vector-normalize! diff 8192.0)
               )
             (vector+! tgt rest diff)
             ;; never land closer than ~2.2m to the body centre (stops legs collapsing inward when spinning)
             (vector-! diff tgt (-> this root trans))
             (set! (-> diff y) 0.0)
             (let ((len (vector-length diff)))
               (when (< len 9000.0)
                 (if (< 1.0 len)
                     (vector-float*! diff diff (/ 9000.0 len))
                     (vector-copy! diff rel)
                     )
                 (set! (-> tgt x) (+ (-> this root trans x) (-> diff x)))
                 (set! (-> tgt z) (+ (-> this root trans z) (-> diff z)))
                 )
               )
             (vector+*! (-> q start-pos) tgt *y-vector* 16384.0)
             (vector-float*! (-> q move-dist) *y-vector* -40960.0)
             (set! (-> q radius) 40.96)
             (set! (-> q collide-with) (collide-spec backgnd pusher hit-by-others-list))
             (set! (-> q action-mask) (collide-action solid))
             (let ((hit (if (< 0 (-> *collide-cache* num-tris))
                            (probe-using-line-sphere *collide-cache* q)
                            -1.0
                            )
                        )
                   )
               (if (>= hit 0.0)
                   (vector+*! tgt (-> q start-pos) (-> q move-dist) hit)
                   (set! (-> tgt y) (-> this foot-pos i y))
                   )
               )
             ;; never ask the IK for a foot far above/below the body
             (set! (-> tgt y) (fmax (+ -24576.0 (-> this root trans y))
                                    (fmin (+ 12288.0 (-> this root trans y)) (-> tgt y))))
             (set! (-> tgt w) 1.0)
             (vector-copy! (-> this foot-next i) tgt)
             (set! (-> this foot-moving i) #t)
             ;; slide from the old planted spot to the new one, with a lift in the middle
             (let ((speed-frac (fmin 1.0 (/ (vector-length (-> this foot-speed i)) 49152.0)))
                   (lift (sin (* 32768.0 frac)))
                   )
               (vector-! diff (-> this foot-next i) (-> this foot-pos i))
               (vector+*! cur (-> this foot-pos i) diff frac)
               (+! (-> cur y) (* lift (+ 1024.0 (* 3072.0 speed-frac))))
               ;; head tilts a little AWAY from whichever leg is lifted
               (set! tx (- tx (* lift (/ (-> local x) 15683.3))))
               (set! tz (- tz (* lift (/ (-> local z) 15683.3))))
               )
             )
           )
          (else
            ;; foot is planted
            (when (-> this foot-moving i)
              (vector-copy! (-> this foot-pos i) (-> this foot-next i))
              (set! (-> this foot-moving i) #f)
              (blast-bot-foot-landed this i)
              )
            ;; if the body got away from a planted foot (sharp turn / fast move), drag it
            ;; instead of letting the IK overstretch
            (vector-! diff (-> this foot-pos i) rest)
            (set! (-> diff y) 0.0)
            (when (< 14336.0 (vector-length diff))
              (vector-normalize! diff 14336.0)
              (set! (-> this foot-pos i x) (+ (-> rest x) (-> diff x)))
              (set! (-> this foot-pos i z) (+ (-> rest z) (-> diff z)))
              )
            ;; v5: planted feet also get the same safety limits swinging feet always had. Without these,
            ;; a sudden change of body height/heading left a planted foot too close (legs fold up
            ;; "like tinfoil") or too far above/below the body (legs implode) until it stepped again.
            (vector-! diff (-> this foot-pos i) (-> this root trans))
            (set! (-> diff y) 0.0)
            (let ((len (vector-length diff)))
              (when (< len 9000.0)
                (if (< 1.0 len)
                    (vector-float*! diff diff (/ 9000.0 len))
                    (vector-copy! diff rel)
                    )
                (set! (-> this foot-pos i x) (+ (-> this root trans x) (-> diff x)))
                (set! (-> this foot-pos i z) (+ (-> this root trans z) (-> diff z)))
                )
              )
            (set! (-> this foot-pos i y) (fmax (+ -24576.0 (-> this root trans y))
                                               (fmin (+ 12288.0 (-> this root trans y)) (-> this foot-pos i y))))
            (vector-copy! cur (-> this foot-pos i))
            )
          )
        ;; R2 hover: blend every foot toward a pose swept back behind the body. The front pair (0, 3)
        ;; hangs low, the back pair (1, 2) is held higher, so the legs never overlap.
        (when (< 0.001 (-> this hover-blend))
          (set-vector! hov
                       (if (< i 2) 10240.0 -10240.0)
                       (if (or (= i 0) (= i 3)) -14336.0 -8192.0)
                       (if (or (= i 0) (= i 3)) -10240.0 -20480.0)
                       1.0)
          (vector-orient-by-quat! hov hov (-> this root quat))
          (vector+! hov hov (-> this root trans))
          (vector-! diff hov cur)
          (vector+*! cur cur diff (-> this hover-blend))
          )
        (set! (-> cur w) 1.0)
        (enable-set! (-> this joint-ik i) #t)
        (set-ik-target! (-> this joint-ik i) cur)
        )
      )
    ;; smooth the head tilt (about 4 degrees per lifted leg)
    (let ((k (fmin 1.0 (* 12.0 (seconds-per-frame))))
          (crouch-frac (fmin 1.0 (/ (-> this crouch-depth) 10240.0)))
          (moving (fmin 1.0 (/ (-> this speed) 0.3)))
          )
      (+! (-> this tilt-x) (* k (- (* 0.07 tx moving) (-> this tilt-x))))
      ;; plus a nod forward while crouching for a jump
      (+! (-> this tilt-z) (* k (- (+ (* 0.07 tz moving) (* 0.10 crouch-frac)) (-> this tilt-z))))
      )
    ;; body height: follow the ground under the body (dip for a jump crouch, rise for hover).
    ;; While airborne the jump code owns it.
    (when (!= (-> this jump-mode) 2)
      (let ((target (+ (- (-> this ground-y) (-> this crouch-depth)) (-> this hover-lift))))
        (if (< (-> this root trans y) target)
            (seek! (-> this root trans y) target (* 61440.0 (seconds-per-frame)))  ;; climb fast: slopes, stairs
            (seek! (-> this root trans y) target (* 40960.0 (seconds-per-frame)))  ;; settle down gently
            )
        )
      )
    )
  (none)
  )

;; IMPORTANT: processes in the dead-pool heap get MOVED in memory when the heap compacts
;; (e.g. when other processes spawn/die, camera changes...). Anything pointing at our own
;; process heap must be fixed up, or it dangles and the game crashes. bombbot.gc does the
;; same for its joint-ik array in its own relocate method.
(defmethod relocate ((this blast-bot-player) (offset int))
  (dotimes (v1-0 4)
    (if (nonzero? (-> this joint-ik v1-0))
        (&+! (-> this joint-ik v1-0) offset)
        )
    )
  (if (nonzero? (-> this aggro-shape))
      (&+! (-> this aggro-shape) offset)
      )
  (let ((result (call-parent-method this offset)))
    ;; the body/head/swivel/gun joint callbacks keep a raw pointer to the bot in param1; after a move that pointer
    ;; would still be the OLD address (stale memory that now belongs to other processes). Re-point them.
    (when (nonzero? (-> this node-list))
      (set! (-> this node-list data 3 param1) this)
      (set! (-> this node-list data 4 param1) this)
      (set! (-> this node-list data 5 param1) this)
      (set! (-> this node-list data 6 param1) this)
      )
    result
    )
  )

;; ---- Blast Bot turret ----------------------------------------------------
;; joint 4 = head, 5 = gun swivel, 6 = gun. They don't animate on their own: the
;; original bombbot overrides them with these cspace callbacks every frame.
;;  - head: follows the STICK direction (leads the body, which turns more slowly),
;;          and tilts slightly away from the lifted leg
;;  - swivel: left/right only, follows the CAMERA direction (or a locked enemy)
;;  - gun: stays level, only pitches when locked on to an enemy

(defun blast-bot-tilt-quat! ((out quaternion) (tx float) (tz float))
  ;; Lean the up axis toward (tx, 1, tz). Small-angle axis/angle instead of quaternion-from-two-vectors!,
  ;; which takes an acos and can produce NaN (head/body flipping for a moment) when the vectors are nearly equal.
  (let ((mag (sqrtf (+ (* tx tx) (* tz tz)))))
    (if (< mag 0.0001)
        (quaternion-copy! out *unity-quaternion*)
        (let ((axis (new 'stack-no-clear 'vector)))
          (set-vector! axis tz 0.0 (- tx) 1.0)
          (vector-normalize! axis 1.0)
          (quaternion-vector-angle! out axis (* 10430.378 mag))
          )
        )
    )
  out
  )

(defun blast-bot-body-callback ((arg0 cspace) (arg1 transformq))
  ;; Joint 3: the body the legs are attached to. Leans with the same tilt as the head.
  (let ((this (the-as blast-bot-player (-> arg0 param1)))
        (tilt-q (new 'stack-no-clear 'quaternion))
        (base-q (new 'stack-no-clear 'quaternion))
        )
    (blast-bot-tilt-quat! tilt-q
                          (* (-> this tilt-x) *blast-bot-body-tilt-share*)
                          (* (-> this tilt-z) *blast-bot-body-tilt-share*))
    (quaternion-copy! base-q (-> arg1 quat))
    (quaternion*! (-> arg1 quat) tilt-q base-q)
    (quaternion-normalize! (-> arg1 quat))
    )
  (cspace<-parented-transformq-joint! arg0 arg1)
  0
  (none)
  )

(defun blast-bot-head-callback ((arg0 cspace) (arg1 transformq))
  (let ((this (the-as blast-bot-player (-> arg0 param1)))
        (yaw-q (new 'stack-no-clear 'quaternion))
        (tilt-q (new 'stack-no-clear 'quaternion))
        )
    ;; The head keeps facing its own WORLD heading (set only by the stick), so it doesn't
    ;; get dragged around while the legs' body is still turning to catch up.
    (quaternion-vector-angle! yaw-q *up-vector*
                              (deg- (-> this head-yaw) (quaternion-y-angle (-> this root quat))))
    (blast-bot-tilt-quat! tilt-q
                          (* (-> this tilt-x) (- 1.0 *blast-bot-body-tilt-share*))
                          (* (-> this tilt-z) (- 1.0 *blast-bot-body-tilt-share*)))
    (quaternion*! (-> this top-quat) tilt-q yaw-q)
    (quaternion-normalize! (-> this top-quat))
    (quaternion-copy! (-> arg1 quat) (-> this top-quat))
    )
  (cspace<-parented-transformq-joint! arg0 arg1)
  0
  (none)
  )

(defun blast-bot-gun-swivel-callback ((arg0 cspace) (arg1 transformq))
  (cspace<-parented-transformq-joint! arg0 arg1)
  (let ((this (the-as blast-bot-player (-> arg0 param1)))
        (pos (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        (ang (new 'stack-no-clear 'vector))
        (rot (new 'stack-no-clear 'quaternion))
        )
    (matrix->trans (-> arg0 bone transform) pos)
    (vector-! dir (-> this target-pos) pos)
    (rot-zxy-from-vector! ang dir)
    (set! (-> this angle-turret)
          (deg-seek (-> this angle-turret) (-> ang y) (* 36408.89 (seconds-per-frame))))
    (quaternion-vector-angle! rot *up-vector* (-> this angle-turret))
    (quaternion->matrix (-> arg0 bone transform) rot)
    (vector-copy! (-> arg0 bone transform trans) pos)
    )
  0
  (none)
  )

(defun blast-bot-gun-callback ((arg0 cspace) (arg1 transformq))
  (cspace<-parented-transformq-joint! arg0 arg1)
  (let ((this (the-as blast-bot-player (-> arg0 param1)))
        (pos (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        (cur (new 'stack-no-clear 'vector))
        (want (new 'stack-no-clear 'vector))
        )
    (matrix->trans (-> arg0 bone transform) pos)
    (vector-! dir (-> this target-pos) pos)
    (rot-zxy-from-vector! cur (-> arg0 bone transform fvec))
    (rot-zxy-from-vector! want dir)
    (let ((pitch (if (-> this locked)
                     (fmax -4551.1113 (fmin 4551.1113 (deg- (-> want x) (-> cur x))))
                     0.0
                     )
                 )
          )
      (set! (-> this angle-gun)
            (deg-seek (-> this angle-gun) pitch (* (-> this gun-rotation-speed) (seconds-per-frame))))
      )
    (quaternion-vector-angle! (-> arg1 quat) *x-vector* (+ (-> this angle-gun) (-> this extra-angle-gun)))
    )
  (cspace<-parented-transformq-joint! arg0 arg1)
  0
  (none)
  )

(defun blast-bot-los? ((this blast-bot-player) (dest vector))
  ;; #t when nothing solid is between the gun muzzle and dest.
  (let ((q (new 'stack-no-clear 'collide-query))
        (start (new 'stack-no-clear 'vector))
        (dir (new 'stack-no-clear 'vector))
        )
    (matrix->trans (-> this node-list data 6 bone transform) start)
    (vector-! dir dest start)
    (vector-copy! (-> q start-pos) start)
    (vector-copy! (-> q move-dist) dir)
    (set! (-> q radius) 40.96)
    (set! (-> q collide-with) (collide-spec backgnd))
    (set! (-> q ignore-process0) this)
    (set! (-> q ignore-process1) #f)
    (set! (-> q ignore-pat)
          (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> q action-mask) (collide-action solid))
    (let ((hit (fill-and-probe-using-line-sphere *collide-cache* q)))
      (or (< hit 0.0) (>= hit 0.97))
      )
    )
  )

(defun blast-bot-lock-ok? ((this blast-bot-player) (p process-focusable))
  ;; A lock target is only kept while it's valid AND on screen.
  (and p
       (blast-bot-valid-target? this p)
       (-> p draw)
       (logtest? (-> p draw status) (draw-control-status on-screen))
       ;; v5: the turret only tracks things it can actually see
       (blast-bot-los? this (get-trans p 3))
       )
  )

(defun blast-bot-find-lock ((this blast-bot-player))
  ;; Nearest valid on-screen enemy within 50m, or #f.
  (let ((best (the-as process-focusable #f))
        (best-dist 0.0)
        (box (new 'stack-no-clear 'vector))
        (hits (new 'stack-no-clear 'array 'collide-shape 64))
        )
    (vector-copy! box (-> this root trans))
    (set! (-> box w) 204800.0)
    (countdown (i (fill-actor-list-for-box *actor-hash* box hits 64))
      (let ((cs (as-type (-> hits i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (blast-bot-lock-ok? this p)
              (let ((d (vector-vector-xz-distance (-> this root trans) (-> p root trans))))
                (when (or (not best) (< d best-dist))
                  (set! best p)
                  (set! best-dist d)
                  )
                )
              )
            )
          )
        )
      )
    best
    )
  )

(defun blast-bot-init-aim ((this blast-bot-player))
  ;; Call once after initialize-skeleton.
  (quaternion-copy! (-> this top-quat) *unity-quaternion*)
  (set! (-> this angle-turret) 0.0)
  (set! (-> this angle-gun) 0.0)
  (set! (-> this extra-angle-gun) 0.0)
  (set! (-> this gun-rotation-speed) 7281.778)
  (set! (-> this lock-handle) (the-as handle #f))
  (set! (-> this locked) #f)
  (let ((fwd (new 'stack-no-clear 'vector)))
    (vector-z-quaternion! fwd (-> this root quat))
    (vector+*! (-> this target-pos) (-> this root trans) fwd 204800.0)
    )
  (let ((n3 (-> this node-list data 3))
        (n4 (-> this node-list data 4))
        (n5 (-> this node-list data 5))
        (n6 (-> this node-list data 6))
        )
    (set! (-> n3 param0) blast-bot-body-callback)
    (set! (-> n3 param1) this)
    (set! (-> n4 param0) blast-bot-head-callback)
    (set! (-> n4 param1) this)
    (set! (-> n5 param0) blast-bot-gun-swivel-callback)
    (set! (-> n5 param1) this)
    (set! (-> n6 param0) blast-bot-gun-callback)
    (set! (-> n6 param1) this)
    )
  (none)
  )

(defun blast-bot-update-aim ((this blast-bot-player))
  ;; Call every frame from :post. Locks on to the nearest visible enemy, otherwise follows the camera's left/right.
  ;; While the spy droid is out (*blast-bot-spy-active*) the camera is on the droid, so with NO enemy to lock on to the turret
  ;; turns slowly through 360 degrees on its own instead. The lock-on (and the Blaster's auto-mode) work as usual.
  (let ((p (as-type (handle->process (-> this lock-handle)) process-focusable)))
    ;; drop a bad lock right away, and re-pick the nearest enemy every 20 frames
    (when (or (not (blast-bot-lock-ok? this p))
              (= 0 (mod (-> this debug-frame-count) 20)))
      (set! p (blast-bot-find-lock this))
      (set! (-> this lock-handle) (if p (process->handle p) (the-as handle #f)))
      )
    (cond
      (p
        (set! (-> this locked) #t)
        (vector-copy! (-> this target-pos) (get-trans p 3))
        )
      (else
        ;; no enemy: swing left/right with the camera (gun stays level), or spin while the spy droid is out
        (let ((flat (new 'stack-no-clear 'vector))
              (pos (new 'stack-no-clear 'vector))
              )
          (set! (-> this locked) #f)
          (matrix->trans (-> this node-list data 5 bone transform) pos)
          (cond
            (*blast-bot-spy-active*
              (set! *blast-bot-spy-turret-angle* (+ *blast-bot-spy-turret-angle* (* *blast-bot-spy-turret-speed* (seconds-per-frame))))
              (if (< 65536.0 *blast-bot-spy-turret-angle*)
                  (set! *blast-bot-spy-turret-angle* (- *blast-bot-spy-turret-angle* 65536.0))
                  )
              (set-vector! flat (sin *blast-bot-spy-turret-angle*) 0.0 (cos *blast-bot-spy-turret-angle*) 1.0)
              )
            (else
              (vector-copy! flat (-> (camera-matrix) fvec))
              )
            )
          (set! (-> flat y) 0.0)
          (vector-normalize! flat 204800.0)
          (vector+! (-> this target-pos) pos flat)
          )
        )
      )
    )
  (none)
  )

;; ---- Jumping ---------------------------------------------------------------
;; X: crouch (body dips, legs bend, stick only aims the head) -> launch -> airborne ->
;; landing slam -> short recovery. Controls are locked until the jump is over, tank style.
;; Hold X again while airborne (after letting go once) to burn fuel and slow the fall.
;; Fuel recharges while standing.

(defun blast-bot-move-xz ((this blast-bot-player) (dx float) (dz float))
  ;; Move the bot horizontally by (dx, dz). Steep surfaces (walls, and pusher actors such as platforms, elevators and
  ;; doors) stop it and it slides along them.
  ;; Returns the fraction of the intended distance that was actually moved."
  (let* ((q (new 'stack-no-clear 'collide-query))
         (move (new 'stack-no-clear 'vector))
         (n (new 'stack-no-clear 'vector))
         (ext (new 'stack-no-clear 'vector))
         (start (new 'stack-no-clear 'vector))
         (before-x (-> this root trans x))
         (before-z (-> this root trans z))
         (intended (sqrtf (+ (* dx dx) (* dz dz))))
         )
    (set-vector! move dx 0.0 dz 1.0)
    (when (< 1.0 intended)
      ;; collect nearby static collision once
      (set-vector! ext 40960.0 32768.0 40960.0 1.0)
      (set-vector! start (-> this root trans x) (+ (-> this root trans y) *blast-bot-wall-height*) (-> this root trans z) 1.0)
      (vector-! (-> q bbox min) start ext)
      (vector+! (-> q bbox max) start ext)
      (set! (-> q collide-with) (collide-spec backgnd pusher hit-by-others-list))
      (set! (-> q ignore-process0) this)
      (set! (-> q ignore-process1) #f)
      (set! (-> q ignore-pat)
            (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
      (fill-using-bounding-box *collide-cache* q)
      ;; two passes: move up to a wall, then slide along it with what is left
      (dotimes (iter 2)
        (when (< 1.0 (vector-length move))
          (set-vector! start (-> this root trans x) (+ (-> this root trans y) *blast-bot-wall-height*) (-> this root trans z) 1.0)
          (vector-copy! (-> q start-pos) start)
          (vector-copy! (-> q move-dist) move)
          (set! (-> q radius) *blast-bot-wall-radius*)
          (set! (-> q collide-with) (collide-spec backgnd pusher hit-by-others-list))
          (set! (-> q action-mask) (collide-action solid))
          (let ((hit (if (< 0 (-> *collide-cache* num-tris))
                         (probe-using-line-sphere *collide-cache* q)
                         -1.0
                         )
                     )
                )
            (cond
              ((and (>= hit 0.0) (< (fabs (-> q best-other-tri normal y)) 0.7))
               ;; a wall: walk up to it...
               (let ((frac0 (fmax 0.0 (- hit 0.03))))
                 (+! (-> this root trans x) (* (-> move x) frac0))
                 (+! (-> this root trans z) (* (-> move z) frac0))
                 )
               ;; ...and keep only the part of the leftover movement that runs along the wall
               (vector-copy! n (-> q best-other-tri normal))
               (set! (-> n y) 0.0)
               (if (< 0.01 (vector-length n))
                   (vector-normalize! n 1.0)
                   (set-vector! n 0.0 0.0 0.0 1.0)
                   )
               (vector-float*! move move (- 1.0 hit))
               (let ((d (vector-dot move n)))
                 (when (< d 0.0)
                   (vector+*! move move n (- d))
                   )
                 )
               (set! (-> move y) 0.0)
               )
              (else
                ;; nothing in the way (or only a walkable slope)
                (+! (-> this root trans x) (-> move x))
                (+! (-> this root trans z) (-> move z))
                (vector-reset! move)
                )
              )
            )
          )
        )
      )
    (let ((ddx (- (-> this root trans x) before-x))
          (ddz (- (-> this root trans z) before-z))
          )
      (if (< 1.0 intended)
          (/ (sqrtf (+ (* ddx ddx) (* ddz ddz))) intended)
          1.0
          )
      )
    )
  )

(defun blast-bot-ground-y ((this blast-bot-player) (up float))
  ;; Height of the ground under the bot (probing down from 'up' units above it), or -1e9 if none found.
  (let ((q (new 'stack-no-clear 'collide-query)))
    (vector+*! (-> q start-pos) (-> this root trans) *y-vector* up)
    (vector-float*! (-> q move-dist) *y-vector* -163840.0)
    (set! (-> q radius) 40.96)
    (set! (-> q collide-with) (collide-spec backgnd pusher hit-by-others-list))
    (set! (-> q ignore-process0) #f)
    (set! (-> q ignore-process1) #f)
    (set! (-> q ignore-pat)
          (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> q action-mask) (collide-action solid))
    (let ((hit (fill-and-probe-using-line-sphere *collide-cache* q)))
      (if (>= hit 0.0)
          (+ (-> q start-pos y) (* hit (-> q move-dist y)))
          -1000000000.0
          )
      )
    )
  )

(defun blast-bot-land ((this blast-bot-player) (gy float))
  ;; Touch down at height gy: slam, shake, re-plant the feet.
  (set! (-> this root trans y) gy)
  (set! (-> this ground-y) gy)
  (set! (-> this jump-fuel) 1.0)
  (set! (-> this jump-vy) 0.0)
  (set! (-> this thrusting) #f)
  (set! (-> this jump-mode) 3)
  (set! (-> this jump-timer) (current-time))
  (set! (-> this crouch-depth) 6144.0)
  (dotimes (i 4)
    (let ((local (new 'stack-no-clear 'vector))
          (world (new 'stack-no-clear 'vector))
          )
      (blast-bot-foot-local local i)
      (vector-orient-by-quat! world local (-> this root quat))
      (vector+! world world (-> this root trans))
      (set! (-> world y) gy)
      (vector-copy! (-> this foot-pos i) world)
      (vector-copy! (-> this foot-next i) world)
      )
    (vector-reset! (-> this foot-speed i))
    (set! (-> this foot-moving i) #f)
    )
  (vector-copy! (-> this last-trans) (-> this root trans))
  (vector-reset! (-> this linear-speed))
  (if (not *blast-bot-spy-active*) (activate! *camera-smush-control* 1024.0 37 120 1.0 0.99 (-> this clock)))
  (blast-bot-foot-attack this (-> this root trans) 36864.0)
  (none)
  )

(defun blast-bot-jump-update ((this blast-bot-player))
  ;; Call every frame from :trans, before the walking code.
  (let ((dt (seconds-per-frame))
        (g 163840.0)
        )
    ;; where is the ground right under the body? (probes from 5m above, so slopes and stairs are caught)
    (when (and *blast-bot-ground-follow* (!= (-> this jump-mode) 2))
      (let ((gy (blast-bot-ground-y this 12288.0)))
        (when (< -900000000.0 gy)
          (set! (-> this ground-y) gy)
          )
        )
      )
    (case (-> this jump-mode)
      ((0)
       (set! (-> this jump-fuel) (fmin 1.0 (+ (-> this jump-fuel) (* 0.4 dt))))
       (cond
         ((< (-> this ground-y) (- (- (-> this root trans y) (-> this hover-lift)) 20480.0))
          ;; walked off a ledge (more than 5m drop): fall, thruster works like after a jump
          (set! (-> this jump-mode) 2)
          (set! (-> this jump-timer) (current-time))
          (set! (-> this jump-vy) 0.0)
          (set! (-> this jump-vx) (/ (-> this linear-speed x) dt))
          (set! (-> this jump-vz) (/ (-> this linear-speed z) dt))
          (set! (-> this jump-x-released) (not (cpad-hold? 0 x)))
          (set! (-> this thrusting) #f)
          )
         ((and (cpad-pressed? 0 x) (not *blast-bot-spy-active*))
          (set! (-> this jump-mode) 1)
          (set! (-> this jump-timer) (current-time))
          )
         )
       )
      ((1)
       ;; crouch: dip the body; the stick only turns the head to pick the jump direction
       (seek! (-> this crouch-depth) 10240.0 (* 20480.0 dt))
       (when (>= (- (current-time) (-> this jump-timer)) (seconds 0.6))
         (let ((speed (-> *cpad-list* cpads 0 stick0-speed)))
           (set! (-> this jump-vx) 0.0)
           (set! (-> this jump-vz) 0.0)
           (when (< 0.05 speed)
             (set! (-> this jump-vx) (* 30000.0 speed (sin (-> this head-yaw))))
             (set! (-> this jump-vz) (* 30000.0 speed (cos (-> this head-yaw))))
             )
           )
         (set! (-> this ground-y) (* 0.25 (+ (-> this foot-pos 0 y) (-> this foot-pos 1 y) (-> this foot-pos 2 y) (-> this foot-pos 3 y))))
         (set! (-> this jump-vy) 141000.0)
         (set! (-> this crouch-depth) 0.0)
         (set! (-> this jump-mode) 2)
         (set! (-> this jump-timer) (current-time))
         (set! (-> this jump-x-released) #f)
         (set! (-> this thrusting) #f)
         (if (not *blast-bot-spy-active*) (activate! *camera-smush-control* 512.0 37 60 1.0 0.99 (-> this clock)))
         )
       )
      ((2)
       (let ((hold (cpad-hold? 0 x)))
         (if (not hold)
             (set! (-> this jump-x-released) #t)
             )
         (set! (-> this thrusting) (and hold (-> this jump-x-released) (< 0.0 (-> this jump-fuel))))
         (cond
           ((-> this thrusting)
            (seek! (-> this jump-fuel) 0.0 (* 0.5 dt))
            (if (< (-> this jump-vy) -8192.0)
                ;; falling too fast: brake hard down to a ~2m/s descent
                (set! (-> this jump-vy) (fmin -8192.0 (+ (-> this jump-vy) (* 1.5 g dt))))
                ;; otherwise the thrusters mostly cancel gravity
                (set! (-> this jump-vy) (- (-> this jump-vy) (* 0.3 g dt)))
                )
            )
           (else
             (set! (-> this jump-vy) (- (-> this jump-vy) (* g dt)))
             )
           )
         )
       ;; steer in the air: ease the sideways velocity toward the stick direction
       (when (-> this input-active)
         (let ((speed (-> *cpad-list* cpads 0 stick0-speed)))
           (seek! (-> this jump-vx) (* 49152.0 speed (sin (-> this input-yaw))) (* 98304.0 dt))
           (seek! (-> this jump-vz) (* 49152.0 speed (cos (-> this input-yaw))) (* 98304.0 dt))
           )
         )
       (let ((frac (blast-bot-move-xz this (* (-> this jump-vx) dt) (* (-> this jump-vz) dt))))
         ;; bumped into a wall: lose the sideways speed that went into it
         (when (< frac 0.9)
           (set! (-> this jump-vx) (* (-> this jump-vx) frac))
           (set! (-> this jump-vz) (* (-> this jump-vz) frac))
           )
         )
       (+! (-> this root trans y) (* (-> this jump-vy) dt))
       (when (>= 0.0 (-> this jump-vy))
         (let* ((gy0 (blast-bot-ground-y this 8192.0))
                (gy (if (< gy0 -900000000.0) (-> this ground-y) gy0))
                )
           (when (or (<= (-> this root trans y) gy)
                     (>= (- (current-time) (-> this jump-timer)) (seconds 10)))
             (blast-bot-land this gy)
             )
           )
         )
       )
      ((3)
       (seek! (-> this crouch-depth) 0.0 (* 14336.0 dt))
       (set! (-> this jump-fuel) (fmin 1.0 (+ (-> this jump-fuel) (* 0.4 dt))))
       (when (>= (- (current-time) (-> this jump-timer)) (seconds 0.45))
         (set! (-> this crouch-depth) 0.0)
         (set! (-> this jump-mode) 0)
         )
       )
      )
    )
  (none)
  )

;; ---- HUD (compact) ----
;; One hud process (blast-bot-hud) draws everything with plain white rectangles from the common texture page, so it works
;; in every level. Coordinates are hud pixels (512 wide, 416 high); a hud rectangle is the white texture (4x4 pixels)
;; stretched by scale-x / scale-y, positioned by its top-left corner (see ahud-rect! in blastbot-allyhud.gc).
;;
;;   top left      : one square box per minion kind with its count (blastbot-allyhud.gc, sprites 15-29, strings 0-2)
;;   bottom left   : jump (thruster) bar, only while jumping / recharging
;;                   health bar, with the selected weapon bar next to it (gun colour, 1/3, 2/3 or all filled for the 1st / 2nd / 3rd weapon of the colour)
;;                   shield bar right under the health (only while the shield is up, damaged or recharging), with the heat bar next to it
;; Every bar is *bbh-bar-w* wide; the block keeps *bbh-margin-x* / *bbh-margin-y* away from the screen edges.
;; Sprites: 0-2 jump, 3-5 health, 6-8 shield, 9-11 weapon, 12-14 heat (border, background, fill), 15-29 minion boxes.

(define *blast-bot-hud-health* 1.0)   ;; 0..1, written by the bot every frame
(define *blast-bot-hud-fuel* 1.0)     ;; 0..1
(define *blast-bot-hud-fuel-show* #f) ;; the jump bar is only shown while jumping / recharging
(define *blast-bot-hud-flash* 0.0)    ;; 0..1, health bar flashes white after a hit
(define *blast-bot-hud-shield* 1.0)       ;; 0..1 shield left (while broken: recharge progress), written by the bot every frame
(define *blast-bot-hud-shield-show* #f)   ;; only shown while the shield is up, damaged or recharging
(define *blast-bot-hud-heat* 0.0)         ;; 0..1, written by blast-bot-heat-update (blastbot_guns.gc)
(define *blast-bot-hud-overheat* #f)
(define *blast-bot-hud-gun-color* 0)      ;; 0 red, 1 yellow, 2 blue; written by blast-bot-gun-select
(define *blast-bot-hud-gun-level* 1)      ;; 1..3
(define *blast-bot-weapon-bar* #t)        ;; the selected-weapon bar above the heat bar
(define *blast-bot-weapon-text* #t)       ;; the weapon name line in the top-left console
;; set to #f to run the bot without the hud process (health still works) if the hud ever crashes the game
(define *blast-bot-hud-on* #t)
(define *blast-bot-hud-drawn* #f) ;; debug: one-shot flag for the first-draw log line

;; layout knobs (hud pixels). Everything bottom left is one block of two columns:
;;     [ jump ]
;;     [ health ]   [ weapon ]     <- same size, same row
;;     [ shield ]   [ heat   ]     <- same size, same row
;; It stays left of the minimap (bottom right).
(define *bbh-margin-x* 20)   ;; gap to the left screen edge
(define *bbh-margin-y* 22)   ;; gap to the bottom screen edge
(define *bbh-bar-w* 104)     ;; width of every bar
(define *bbh-col-gap* 280)    ;; gap between the two columns
(define *bbh-hp-h* 18)       ;; health + weapon bar height
(define *bbh-sh-h* 12)       ;; shield + heat bar height
(define *bbh-jump-h* 8)
(define *bbh-gap* 6)         ;; health <-> shield (and weapon <-> heat)
(define *bbh-jump-gap* 8)    ;; jump bar <-> health

(deftype blast-bot-hud (hud)
  ()
  )

(defmacro bbh-bar! (this i x y w h fill show cr cg cb br bg bb)
  ;; one bar = three sprites i, i+1, i+2: 2 pixel border, background, fill (growing to the right). Hidden when SHOW is #f.
  `(let ((bbh-w (if ,show ,w 0))
         (bbh-h (if ,show ,h 0))
         (bbh-f (if ,show ,fill 0))
         )
     (ahud-rect! (-> ,this sprites ,i) (+ ,x -2) (+ ,y -2) (if ,show (+ ,w 4) 0) (if ,show (+ ,h 4) 0) 0 0 0)
     (ahud-rect! (-> ,this sprites (+ ,i 1)) ,x ,y bbh-w bbh-h ,br ,bg ,bb)
     (ahud-rect! (-> ,this sprites (+ ,i 2)) ,x ,y bbh-f bbh-h ,cr ,cg ,cb)
     0
     )
  )

(defmethod draw ((this blast-bot-hud))
  (when (not *blast-bot-hud-drawn*)
    (set! *blast-bot-hud-drawn* #t)
    (format 0 "Blast Bot HUD: first draw~%")
    )
  (let* ((bw *bbh-bar-w*)
         (fbw (the float bw))
         (lx *bbh-margin-x*)
         (rx (+ (+ lx bw) *bbh-col-gap*))
         (bottom (- 416 *bbh-margin-y*))
         (sh-y (- bottom *bbh-sh-h*))
         (hp-y (- (- sh-y *bbh-gap*) *bbh-hp-h*))
         (jp-y (- (- hp-y *bbh-jump-gap*) *bbh-jump-h*))
         (ht-y sh-y)
         (wp-y hp-y)
         )
    ;; sprites 0-2: jump (thruster fuel), above the health bar
    (let* ((fuel (fmax 0.0 (fmin 1.0 *blast-bot-hud-fuel*)))
           (low (< fuel 0.25))
           )
      (bbh-bar! this 0 lx jp-y bw *bbh-jump-h* (the int (* fbw fuel)) *blast-bot-hud-fuel-show*
                (if low 255 0) (if low 120 200) (if low 0 255) 15 30 45)
      )
    ;; sprites 3-5: health. Green -> yellow -> red as it drops, washed out towards white by the hit flash.
    (let* ((hp (fmax 0.0 (fmin 1.0 *blast-bot-hud-health*)))
           (flash (the int (* 200.0 *blast-bot-hud-flash*)))
           (r (if (< hp 0.5) 255 (the int (* 510.0 (- 1.0 hp)))))
           (g (if (< hp 0.5) (the int (* 510.0 hp)) 220))
           )
      (bbh-bar! this 3 lx hp-y bw *bbh-hp-h* (the int (* fbw hp)) #t
                (min 255 (+ r flash)) (min 255 (+ g flash)) (min 255 flash) 70 20 20)
      )
    ;; sprites 6-8: shield, right under the health. Fill goes white (full) -> red (empty).
    (let* ((sh (fmax 0.0 (fmin 1.0 *blast-bot-hud-shield*)))
           (gb (the int (* 255.0 sh)))
           )
      (bbh-bar! this 6 lx sh-y bw *bbh-sh-h* (the int (* fbw sh))
                (and *blast-bot-hud-shield-bar* *blast-bot-hud-shield-show*)
                255 gb gb 45 15 15)
      )
    ;; sprites 9-11: selected weapon, right of the health bar, same size and row
    (let* ((lv (the float (max 1 (min 3 *blast-bot-hud-gun-level*))))
           (c *blast-bot-hud-gun-color*)
           (cr (case c ((0) 255) ((1) 255) (else 40)))
           (cg (case c ((0) 40) ((1) 220) (else 120)))
           (cb (case c ((0) 40) ((1) 0) (else 255)))
           )
      (bbh-bar! this 9 rx wp-y bw *bbh-hp-h* (the int (* fbw (/ lv 3.0))) *blast-bot-weapon-bar*
                cr cg cb 40 40 40)
      )
    ;; sprites 12-14: heat, right of the shield bar, same size and row. Gray = empty; the fill goes white -> yellow -> orange -> red. While overheated it blinks red.
    (let* ((h (fmax 0.0 (fmin 1.0 *blast-bot-hud-heat*)))
           ;; white until 25%, yellow at 55%, orange at 80%, red from 95%
           (cb (the int (* 255.0 (- 1.0 (fmax 0.0 (fmin 1.0 (/ (- h 0.25) 0.3)))))))
           (cg (cond
                 ((< h 0.55) 255)
                 ((< h 0.8) (the int (- 255.0 (* 115.0 (/ (- h 0.55) 0.25)))))
                 (else (the int (* 140.0 (fmax 0.0 (- 1.0 (/ (- h 0.8) 0.15))))))
                 ))
           (hot *blast-bot-hud-overheat*)
           (blink (and hot (logtest? (the int (current-time)) 32)))
           )
      (bbh-bar! this 12 rx ht-y bw *bbh-sh-h* (the int (* fbw h)) #t
                (if blink 120 255) (if hot 0 cg) (if hot 0 cb) 90 90 90)
      )
    )
  ;; sprites 15-29 + strings 0-2: the minion boxes, top left (blastbot-allyhud.gc)
  (ahud-draw-boxes this 15)
  ((method-of-type hud draw) this)
  0
  (none)
  )

(defmethod update-values! ((this blast-bot-hud))
  (set! (-> this values 0 target) (the int (* 100.0 *blast-bot-hud-health*)))
  (logclear! (-> this flags) (hud-flags disable))
  ((method-of-type hud update-values!) this)
  0
  (none)
  )

(defmethod init-callback ((this blast-bot-hud))
  ;; bombbot-hud sets this too; the hud code uses it, so it must not stay empty
  (format 0 "Blast Bot HUD: init-callback begin~%")
  (set! (-> this level) (level-get-target-inside *level*))
  (set! (-> this gui-id)
        (add-process *gui-control* this (gui-channel hud-upper-center-2) (gui-action hidden) (-> this name) 81920.0 0)
        )
  (logior! (-> this flags) (hud-flags show))
  (dotimes (i 30)
    (set! (-> this sprites i tid) (the-as texture-id (get-texture common-white common)))
    (set! (-> this sprites i flags) (hud-sprite-flags))
    (set! (-> this sprites i scale-x) 0.0)
    (set! (-> this sprites i scale-y) 0.0)
    )
  ;; strings 0-2 = the minion counts (pos x 0 = hidden)
  (dotimes (i 3)
    (alloc-string-if-needed this i)
    (set! (-> this strings i scale) *ahud-text-scale*)
    (set! (-> this strings i color) (font-color white))
    (set! (-> this strings i flags) (font-flags shadow kerning large))
    (set! (-> this strings i pos x) 0)
    )
  (format 0 "Blast Bot HUD: init-callback done~%")
  0
  (none)
  )

(defmacro blast-bot-hud-send (type-sym msg)
  ;; sends MSG to every stock hud process of the given type (same walk as hide-hud in hud.gc)
  `(let ((v1-3 (-> *hud-engine* alive-list next0)))
     *hud-engine*
     (let ((s5-0 (-> v1-3 next0)))
       (while (!= v1-3 (-> *hud-engine* alive-list-end))
         (if (= ,type-sym (-> (the-as connection v1-3) param2))
             (send-event (the-as process-tree (-> (the-as connection v1-3) param1)) ,msg)
             )
         (set! v1-3 s5-0)
         *hud-engine*
         (set! s5-0 (-> s5-0 next0))
         )
       )
     )
  )

(define *blast-bot-hide-stock-huds* #t) ;; #t: Jak's own gun hud and health hud stay off while the bot is active

(defun blast-bot-stock-huds ((on symbol))
  ;; on = #t gives Jak's huds back, #f keeps them disabled + hidden
  (if on
      (begin
        (blast-bot-hud-send 'hud-gun 'enable)
        (blast-bot-hud-send 'hud-health 'enable)
        )
      (begin
        (blast-bot-hud-send 'hud-gun 'disable)
        (blast-bot-hud-send 'hud-gun 'hide-quick)
        (blast-bot-hud-send 'hud-health 'disable)
        (blast-bot-hud-send 'hud-health 'hide-quick)
        )
      )
  0
  )

(define *blast-bot-last-addr* 0)

(defun blast-bot-update-hud ((this blast-bot-player))
  ;; DIAG: the dead-pool heap moves processes when it compacts; log every time the bot's address changes
  (let ((addr (the-as int this)))
    (when (!= addr *blast-bot-last-addr*)
      (format 0 "Blast Bot: process address #x~X (was #x~X)~%" addr *blast-bot-last-addr*)
      (set! *blast-bot-last-addr* addr)
      )
    )
  ;; Call every frame: feeds the hud its numbers and (re)spawns the hud process when it is gone
  ;; (e.g. after a level change took the old one with it).
  (set! *blast-bot-hud-health* (/ (-> this health) (-> this max-health)))
  (set! *blast-bot-hud-fuel* (-> this jump-fuel))
  (set! *blast-bot-hud-fuel-show* (or (!= (-> this jump-mode) 0) (< (-> this jump-fuel) 0.999)))
  (set! *blast-bot-hud-flash* (-> this hit-flash))
  ;; shield bar: strength left while the shield exists, recharge progress while it is broken
  (cond
    ((nonzero? (-> this shield-broken-until))
     (let ((total (* *blast-bot-shield-recharge* (the float (seconds 1))))
           (left (the float (- (-> this shield-broken-until) (current-time))))
           )
       (set! *blast-bot-hud-shield* (fmax 0.0 (fmin 1.0 (- 1.0 (/ left total)))))
       (set! *blast-bot-hud-shield-show* #t)
       )
     )
    (else
      (let ((sh (as-type (handle->process (-> this shield-handle)) shield-sphere)))
        (cond
          (sh
            ;; 'heat-ratio is the shield's own heat (0 = untouched, 1 = about to break), so strength left is 1 - heat
            (let ((heat (if *blast-bot-hud-shield-bar* (the-as float (send-event sh 'heat-ratio)) 0.0)))
              (set! *blast-bot-hud-shield* (fmax 0.0 (fmin 1.0 (- 1.0 heat))))
              )
            (set! *blast-bot-hud-shield-show* (or (-> this shield-on) (< *blast-bot-hud-shield* 0.999)))
            )
          (else
            (set! *blast-bot-hud-shield* 1.0)
            (set! *blast-bot-hud-shield-show* #f)
            )
          )
        )
      )
    )
  (when (not *blast-bot-hud-on*)
    ;; fallback while the hud process is off: text meters in the top-left console
    (let ((n (the int (+ 0.999 (* 20.0 (fmax 0.0 (fmin 1.0 *blast-bot-hud-health*)))))))
      (format *stdcon* "HEALTH [")
      (dotimes (i 20)
        (if (< i n)
            (format *stdcon* "#")
            (format *stdcon* "-")
            )
        )
      (format *stdcon* "]~%")
      )
    (when *blast-bot-hud-fuel-show*
      (let ((n (the int (* 20.0 (fmax 0.0 (fmin 1.0 *blast-bot-hud-fuel*))))))
        (format *stdcon* "FUEL   [")
        (dotimes (i 20)
          (if (< i n)
              (format *stdcon* "#")
              (format *stdcon* "-")
              )
          )
        (format *stdcon* "]~%")
        )
      )
    )
  (when (and *blast-bot-hud-on*
             (not (handle->process (-> this hud-handle)))
             (>= (current-time) (-> this hud-retry))
             )
    (set! (-> this hud-retry) (+ (current-time) (seconds 1)))
    (format 0 "Blast Bot HUD: spawning~%")
    (set! (-> this hud-handle)
          (ppointer->handle (process-spawn blast-bot-hud :init hud-init-by-other :name "blast-bot-hud" :to this))
          )
    (format 0 "Blast Bot HUD: spawn returned ~A~%" (handle->process (-> this hud-handle)))
    )
  ;; Jak's own gun hud (shows on R1) and health hud (L3) have no business on screen while he sits in the bot
  (if *blast-bot-hide-stock-huds*
      (blast-bot-stock-huds #f)
      )
  ;; count the living minions for the boxes in the top-left corner (blastbot-allyhud.gc)
  (blast-ally-hud-update this)
  (none)
  )

(defun blast-bot-dash-attack ((this blast-bot-player))
  ;; While charging: hurt every valid enemy in front of the bot (once per charge, the attack id is shared).
  (let ((fwd (new 'stack-no-clear 'vector))
        (center (new 'stack-no-clear 'vector))
        (hits (new 'stack-no-clear 'array 'collide-shape 64))
        )
    (set-vector! fwd (sin (-> this dash-yaw)) 0.0 (cos (-> this dash-yaw)) 1.0)
    (vector+*! center (-> this root trans) fwd 16384.0)
    (+! (-> center y) 8192.0)
    (set! (-> center w) 28672.0)
    (countdown (i (fill-actor-list-for-box *actor-hash* center hits 64))
      (let ((cs (as-type (-> hits i) collide-shape)))
        (when cs
          (let ((p (as-type (-> cs process) process-focusable)))
            (when (and p
                       (blast-bot-valid-target? this p)
                       (< (vector-vector-distance (-> p root trans) center) 28672.0))
              (send-event p 'attack #f
                          (blast-bot-credit-jak!
                            (static-attack-info ((id (-> this dash-id)) (damage 6.0) (mode 'explode)))))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-touch ((this blast-bot-player))
  ;; Generates 'touched events for the leg/body prims (same call bombbot.gc makes in enemy-common-post).
  (let ((params (new 'stack-no-clear 'overlaps-others-params)))
    (set! (-> params options) (overlaps-others-options))
    (set! (-> params collide-with-filter) (the-as collide-spec #xffffffff))
    (set! (-> params tlist) *touching-list*)
    (find-overlapping-shapes (-> this root) params)
    ;; the shield never scans for overlaps itself, so do it for it while it is up: this is what makes people
    ;; bump into it ('touch events reach shield-touch-handler)
    (when (-> this shield-on)
      (let ((sh (as-type (handle->process (-> this shield-handle)) shield-sphere)))
        (when sh
          (find-overlapping-shapes (-> sh root) params)
          )
        )
      )
    )
  (none)
  )

;; ---- Laser pointer: the same beam bombbot.gc draws (draw-beam, world-space particle, depth tested) ----
;; Copied from bombbot.gc (same ids) so they exist even when the bombbot's own code is not loaded. Blue while it
;; points at nothing, turns red while the beam ends on an actor.
;; one frame lifetime (bombbot.gc has 0.05s, which leaves ~3 frames of beam behind a moving gun)
(defpart 2059
  :init-specs ((:texture (lasersmoke-00 level-default-sprite))
    (:birth-func 'birth-func-laser-pointer)
    (:num 1.0)
    (:scale-x (meters 0.15) (meters 0.1))
    (:scale-y (meters 40))
    (:r 0.0)
    (:g 0.0)
    (:b 255.0)
    (:a 64.0 32.0)
    (:fade-a -4.266667)
    (:timer (seconds 0.017))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3 sp-cpuinfo-flag-14 left-multiply-quat))
    (:userdata :data (new 'static 'boxed-array :type int32
                       10
                       1
                       0
                       #x401a00
                       #x401b00
                       #x401c00
                       #x401d00
                       #x401e00
                       #x401f00
                       #x402000
                       #x402100
                       #x402200
                       #x402300
                       #x402400
                       #x402500
                       #x402600
                       #x402700
                       #x402800
                       #x402900
                       #x402a00
                       #x402b00
                       #x402c00
                       #x402d00
                       #x402e00
                       #x402f00
                       #x403000
                       #x403100
                       #x403200
                       #x403300
                       #x403400
                       #x403500
                       #x403600
                       #x403700
                       #x403800
                       #x403900
                       )
               )
    (:func 'sparticle-texture-animate)
    )
  )

(defpart 2060
  :init-specs ((:texture (glow level-default-sprite))
    (:num 1.0)
    (:scale-x (meters 0.2) (meters 0.05))
    (:rot-x (degrees 1.125))
    (:scale-y :copy scale-x)
    (:r 128.0)
    (:g 128.0 128.0)
    (:b 255.0)
    (:a 100.0 28.0)
    (:rotvel-z (degrees 0.3))
    (:timer (seconds 0.017))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-14 glow))
    (:userdata 1.0)
    )
  )

(defpart 2061
  :init-specs ((:texture (glow-hotdot level-default-sprite))
    (:num 1.0)
    (:scale-x (meters 1.2) (meters 0.1))
    (:rot-x (degrees 1.125))
    (:scale-y :copy scale-x)
    (:r 0.0 32.0)
    (:g :copy r)
    (:b 32.0 32.0)
    (:a 32.0 32.0)
