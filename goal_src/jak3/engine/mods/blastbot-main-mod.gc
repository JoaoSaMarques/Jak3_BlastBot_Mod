(defun blast-bot-draw-laser ((this blast-bot-player))
  ;; Laser pointer: from the muzzle along the barrel until it hits the level or an actor.
  (when *blast-bot-laser-on*
    (let ((q (new 'stack-no-clear 'collide-query))
          (start (new 'stack-no-clear 'vector))
          (beam (new 'stack-no-clear 'vector))
          (hit-pos (new 'stack-no-clear 'vector))
          (red 0.0)
          )
      (let ((m (matrix-copy! (new 'stack-no-clear 'matrix) (-> this node-list data 6 bone transform))))
        (matrix->trans m start)
        (vector+*! start start (-> m fvec) 8192.0)
        (vector-normalize-copy! beam (-> m fvec) 819200.0)
        )
      (vector-copy! (-> q start-pos) start)
      (vector-copy! (-> q move-dist) beam)
      (set! (-> q radius) 40.96)
      ;; same filter as bombbot-method-204: level + enemies (the old version only saw backgnd, so the dot
      ;; went through enemies and landed on the floor behind them)
      (set! (-> q collide-with) (collide-spec backgnd enemy bot civilian hit-by-others-list))
      (set! (-> q ignore-process0) this)
      (set! (-> q ignore-process1) #f)
      (set! (-> q ignore-pat)
            (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
      (set! (-> q action-mask) (collide-action solid))
      (let ((hit (fill-and-probe-using-line-sphere *collide-cache* q)))
        (when (>= hit 0.0)
          (vector+float*! hit-pos (-> q start-pos) (-> q move-dist) hit)
          (vector-float*! beam beam hit)
          (let ((prim (as-type (-> q best-other-tri collide-ptr) collide-shape-prim))
                (back (vector-normalize! (vector-! (new 'stack-no-clear 'vector) (-> q start-pos) hit-pos) 1638.4))
                )
            (vector+! hit-pos hit-pos back)
            ;; red when the beam ends on an actor, or on the thing the turret is locked on to
            (when (and (-> this locked) (< (vector-vector-distance hit-pos (-> this target-pos)) 20480.0))
              (set! red 1.0)
              )
            (cond
              ((or prim (< 0.5 red))
                (set! red 1.0)
                (launch-particles (-> *part-id-table* 2061) hit-pos)
                (launch-particles (-> *part-id-table* 2060) hit-pos)
                )
              (else
                (launch-particles (-> *part-id-table* 2062) hit-pos)
                )
              )
            )
          )
        )
      (vector+! (-> this laser-end) start beam)
      ;; colour (r/b) and width, set on the shared particle spec right before drawing, like bombbot does
      (set! (-> *part-id-table* 2059 init-specs 5 initial-valuef) (* 255.0 red))
      (set! (-> *part-id-table* 2059 init-specs 7 initial-valuef) (* 255.0 (- 1.0 red)))
      (set! (-> *part-id-table* 2059 init-specs 3 initial-valuef) *blast-bot-laser-width*)
      (set! (-> *part-id-table* 2059 init-specs 3 random-rangef) *blast-bot-laser-width-rand*)
      (draw-beam (-> *part-id-table* 2059) start beam #t)
      )
    )
  (none)
  )

;; The shield uses the stock shield-sphere process (shield-sphere.gc, already in GAME).

(defun blast-bot-spawn-shield-real ((this blast-bot-player))
  ;; Does the actual spawn. Only call when skel-shield-sphere is loaded.
  (format 0 "Blast Bot: spawning shield~%")
  (let ((params (new 'stack-no-clear 'shield-sphere-spawn-params)))
    (set! (-> params owner) (process->handle this))
    (set! (-> params sphere-size) *blast-bot-shield-size*)
    (set! (-> params track-joint) 3)
    (set! (-> params enable-time) (seconds 0.1))
    (set! (-> params disable-time) (seconds 0.1))
    (set! (-> params shield-strength) 8)
    (set! (-> params shield-type) (shield-type shield-type-0))
    (vector-copy! (-> params offset-vec) (new 'static 'vector :z -4096.0 :w 1.0))
    (let ((shield (the-as process #f)))
      (let* ((s2 (get-process *default-dead-pool* shield-sphere #x4000 1))
             (v1 (when s2
                   (let ((t9 (method-of-type process activate)))
                     (t9 s2 this "process" (the-as pointer #x70004000))
                     )
                   (run-now-in-process s2 shield-sphere-init-by-other params)
                   (-> s2 ppointer)
                   )
                 )
             )
        (if v1
            (set! shield (-> v1 0))
            )
        )
      (when shield
        (set! (-> this shield-handle) (process->handle shield))
        (set! (-> this shield-live) #t)
        ;; The stock shield-sphere only collides with `jak player-list` (it is made to stop the PLAYER's shots).
        ;; The bot is the target here, so the hit sphere has to be seen as `jak` by enemy shots and has to
        ;; collide with everything the bot's own body collides with.
        (set! (-> (the-as shield-sphere shield) root backup-collide-as)
              (collide-spec jak obstacle impenetrable-obj shield))
        (set! (-> (the-as shield-sphere shield) root backup-collide-with)
              (the-as collide-spec #xffffffff))
        ;; projectiles only send 'attack to things whose penetrated-by matches their attack type; the stock shield
        ;; accepts none (mech shots are handled elsewhere), so accept everything here.
        (set! (-> (the-as shield-sphere shield) root penetrated-by) (the-as penetrate -1))
        (send-event shield 'disabled)
        (format 0 "Blast Bot: shield spawned~%")
        )
      )
    )
  (none)
  )

(defun blast-bot-spawn-shield ((this blast-bot-player))
  ;; Spawns the mech's own shield sphere (target-mech.gc) on the bot's body joint, switched off.
  ;; Hold Circle to switch it on. Needs the skel-shield-sphere art to be loaded."
  (when *blast-bot-shield-spawn*
  (if (not (art-group-get-by-name *level* "skel-shield-sphere" (the-as (pointer level) #f)))
      (format 0 "Blast Bot: skel-shield-sphere art is not loaded, shield disabled~%")
      (blast-bot-spawn-shield-real this)
      )
    )
  (none)
  )

(defmethod shield-event-handler ((this shield-sphere) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('shield-detach)
     (go (method-of-object this die))
     #t
     )
    (('active)
     #t
     )
    (('heat-ratio)
     (-> this heat-info current-heat-value)
     )
    (('notice)
     (case (-> arg3 param 0)
       (('die)
        (go (method-of-object this die))
        #t
        )
       (else
         #f
         )
       )
     )
    (('enabled)
     (go (method-of-object this shield-enabled))
     )
    (('disabled)
     (go (method-of-object this shield-disabled))
     )
    (('touch)
     (shield-touch-handler this (the-as process-focusable arg0) arg3)
     )
    (('attack)
     (shield-attack-handler this (the-as process-focusable arg0) arg3)
     )
    (('impact-impulse)
     (let ((v1-12 (the-as object (-> arg3 param 0))))
       (when (< 40960.0 (* (-> (the-as rigid-body-impact v1-12) impulse) (get-inv-mass this)))
         (logior! (-> this root penetrated-by) (penetrate vehicle))
         (go (method-of-object this explode))
         #t
         )
       )
     )
    )
  )

;; the stock version sends the hit as the shield sphere; enemies then refocus onto the shield (a target they can't
;; hurt) and stop fighting the bot. Name the owner (the bot) as the attacker instead.
(#when BLAST_BOT_SHIELD_OWNER_ATTACK
(defmethod send-shield-attack ((this shield-sphere) (arg0 process-focusable) (arg1 touching-shapes-entry) (arg2 int))
  (let ((t0-0 0))
    (send-event
      arg0
      'attack
      arg1
      (static-attack-info :mask (vehicle-impulse-factor) ((id (the-as uint arg2))
                                                          (damage (the float t0-0))
                                                          (vehicle-damage-factor 1.0)
                                                          (vehicle-impulse-factor 1.0)
                                                          (shove-back (meters 4))
                                                          (shove-up (meters 3))
                                                          (mode 'generic)
                                                          (attacker (-> this owner))
                                                          )
                          )
      )
    )
  )
  )

(defun blast-bot-update-shield-break ((this blast-bot-player))
  ;; Shield recharge: when the shield breaks completely (its process explodes / dies) it stays gone for
  ;; *blast-bot-shield-recharge* seconds, then a fresh one is spawned. Normal regeneration is untouched.
  (cond
    ((zero? (-> this shield-broken-until))
     (when (-> this shield-live)
       (let ((sh (as-type (handle->process (-> this shield-handle)) shield-sphere)))
         (when (or (not sh)
                   (and (-> sh next-state) (= (-> sh next-state name) 'explode))
                   )
           (format 0 "Blast Bot: shield broke, recharging~%")
           (if sh
               (send-event sh 'shield-detach)
               )
           (set! (-> this shield-handle) (the-as handle #f))
           (set! (-> this shield-live) #f)
           (set! (-> this shield-on) #f)
           (set! (-> this shield-broken-until)
                 (+ (current-time) (the int (* *blast-bot-shield-recharge* (the float (seconds 1)))))
                 )
           )
         )
       )
     )
    ((>= (current-time) (-> this shield-broken-until))
     (set! (-> this shield-broken-until) 0)
     (format 0 "Blast Bot: shield recharged~%")
     (blast-bot-spawn-shield this)
     )
    )
  (none)
  )

(defun blast-bot-draw-shield-status ((this blast-bot-player))
  ;; Text meter while the shield is broken. Only used when the hud process is off (*blast-bot-hud-on* #f);
  ;; otherwise the shield bar next to the fuel bar shows this.
  (when (and (not *blast-bot-hud-on*) (nonzero? (-> this shield-broken-until)))
    (let* ((total (* *blast-bot-shield-recharge* (the float (seconds 1))))
           (left (the float (- (-> this shield-broken-until) (current-time))))
           (n (the int (* 20.0 (- 1.0 (/ left total)))))
           )
      (format *stdcon* "SHIELD [")
      (dotimes (i 20)
        (if (< i n)
            (format *stdcon* "#")
            (format *stdcon* "-")
            )
        )
      (format *stdcon* "] RECHARGING~%")
      )
    )
  (none)
  )

(defun blast-bot-absorb-push ((this blast-bot-player))
  ;; Platforms carry riders through the engine (detect-riders! / pull-riders! in collide-shape-rider.gc), which moves our
  ;; root behind our back with move-by-vector!. Our feet, ground height and speed estimate live in world space, so shift
  ;; them by the same amount or the legs drag and the ground probe lags. Anything that changed root trans since
  ;; ext-pos (written at the end of our own movement) was done by someone else.
  (let ((delta (new 'stack-no-clear 'vector)))
    (vector-! delta (-> this root trans) (-> this ext-pos))
    (when (and (< 1.0 (vector-length delta)) (< (vector-length delta) 81920.0))
      (if *blast-bot-debug-ride*
          (format *stdcon* "RIDE carried by engine: dx ~f dy ~f dz ~f (m)~%" (/ (-> delta x) 4096.0) (/ (-> delta y) 4096.0) (/ (-> delta z) 4096.0))
          )
      (+! (-> this ground-y) (-> delta y))
      (vector+! (-> this last-trans) (-> this last-trans) delta)
      (dotimes (i 4)
        (vector+! (-> this foot-pos i) (-> this foot-pos i) delta)
        (vector+! (-> this foot-next i) (-> this foot-next i) delta)
        )
      )
    (vector-copy! (-> this ext-pos) (-> this root trans))
    )
  (none)
  )

(defun blast-bot-ride-update ((this blast-bot-player))
  ;; Elevators / platforms learn that someone stands on them from a 'ridden event with a rider of type target
  ;; (elevator.gc), so look for a platform under the feet and send it 'ridden ourselves with Jak as the rider.
  ;; The actual carrying is done by the engine (the ride sphere + can-ride in the collision setup).
  (set! *blast-bot-ride-seen* (the-as string #f))
  (when (and *target* (!= (-> this jump-mode) 2))
    (let ((q (new 'stack-no-clear 'collide-query)))
      (vector+*! (-> q start-pos) (-> this root trans) *y-vector* 8192.0)
      (vector-float*! (-> q move-dist) *y-vector* -61440.0)
      (set! (-> q radius) 40.96)
      (set! (-> q collide-with) (collide-spec pusher hit-by-others-list))
      (set! (-> q ignore-process0) this)
      (set! (-> q ignore-process1) #f)
      (set! (-> q ignore-pat)
            (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
      (set! (-> q action-mask) (collide-action solid))
      (let ((hit (fill-and-probe-using-line-sphere *collide-cache* q)))
        (when (>= hit 0.0)
          ;; only a platform right under the feet counts, not one far below a ledge
          (let ((hit-y (+ (-> q start-pos y) (* hit (-> q move-dist y))))
                (prim (as-type (-> q best-other-tri collide-ptr) collide-shape-prim))
                )
            (when (and prim (< (fabs (- hit-y (-> this ground-y))) 6144.0))
              (let ((proc (-> prim cshape process))
                    (f (new 'stack-no-clear 'focus))
                    )
                (when proc
                  (set! *blast-bot-ride-seen* (-> proc name))
                  (set! (-> f handle) (process->handle *target*))
                  (send-event proc 'ridden f)
                  )
                )
              )
            )
          )
        )
      )
    )
  (if *blast-bot-debug-ride*
      (format *stdcon* "RIDE plat ~A | ground ~f root ~f (m) | mode ~D~%"
              *blast-bot-ride-seen*
              (/ (-> this ground-y) 4096.0)
              (/ (-> this root trans y) 4096.0)
              (-> this jump-mode)
              )
      )
  ;; end of our own movement for this update
  (vector-copy! (-> this ext-pos) (-> this root trans))
  (none)
  )

(define *blast-bot-last-jak-state* #f)
;; despawn (L1 + Triangle): 0 = idle, 1..3 = releasing Jak / removing the bot. The regrab below stays off while > 0.
(define *blast-bot-despawn-step* 0)
(define *blast-bot-despawn-time* 0)
;; Jak stuck in target-grab (cutscene never sent 'end-mode): after this long with no cutscene stream playing,
;; the bot ends the grab itself so the regrab below can put him back. (set! *blast-bot-grab-timeout* 0) to disable.
(define *blast-bot-grab-since* 0)
(define *blast-bot-grab-timeout* (seconds 2.0))

(defun blast-bot-jak-busy? ((st object))
  ;; states we must NOT fight: cutscene grabs, death/respawn, and the bot's own ride state
  (or (= st 'target-grab-ride) (= st 'target-grab) (= st 'target-clone-anim)
      (= st 'target-hit) (= st 'target-death) (= st 'target-continue))
  )

(defun blast-bot-regrab ((this blast-bot-player))
  ;; Cutscenes (and elevators with the grab flag) send Jak a 'grab, which kicks him out of target-grab-ride, and when
  ;; they end he is released far away from the bot. Any state that is not in blast-bot-jak-busy? gets him put back
  ;; into the bot (blacklist instead of a list of allowed states, so unexpected post-cutscene states work too).
  (when *target*
    (let ((st (if (-> *target* next-state) (-> *target* next-state name) #f)))
      ;; log every change so we can see which state Jak lands in after a cutscene
      (when (!= st *blast-bot-last-jak-state*)
        (format 0 "Blast Bot: Jak state ~A -> ~A~%" *blast-bot-last-jak-state* st)
        (set! *blast-bot-last-jak-state* st)
        )
      ;; stuck in target-grab with no cutscene stream playing -> end the grab ourselves after the timeout
      (if (and (= st 'target-grab) (not (-> *art-control* active-stream)))
          (when (zero? *blast-bot-grab-since*)
            (set! *blast-bot-grab-since* (current-time))
            )
          (set! *blast-bot-grab-since* 0)
          )
      (when (and (nonzero? *blast-bot-grab-timeout*)
                 (nonzero? *blast-bot-grab-since*)
                 (> (- (current-time) *blast-bot-grab-since*) *blast-bot-grab-timeout*))
        (format 0 "Blast Bot: Jak stuck in target-grab, ending the grab~%")
        (set! *blast-bot-grab-since* 0)
        (send-event *target* 'end-mode 'grab)
        )
      (when (and st
                 (>= (current-time) (-> this ride-retry))
                 (not (blast-bot-jak-busy? st))
                 (zero? *blast-bot-despawn-step*)           ;; not while the bot is being removed
                 (not (-> *art-control* active-stream))) ;; no cutscene stream playing
        (format 0 "Blast Bot: Jak left the bot (~A), putting him back~%" st)
        (set! (-> this ride-retry) (+ (current-time) (seconds 0.25)))
        (move-to-point! (-> *target* control) (-> this root trans))
        (send-event *target* 'change-mode 'grab-ride #t)
        (if *camera*
            (send-event *camera* 'change-target this)
            )
        )
      )
    )
  (none)
  )

(defun blast-bot-deadly-touch? ((ent touching-shapes-entry) (proc process))
  ;; Same question as touching-shapes-entry::prims-touching-action? (is one of proc's touching prims deadly?), but it
  ;; takes proc's shape straight from the touch entry instead of assuming it is proc's root. The engine method prints
  ;; "Bogus cshape value!" and returns #f whenever the shape it is given is not one of the entry's two shapes (enemies
  ;; with an extra attack shape, etc.); this stays quiet and just checks whichever shape belongs to proc.
  (let ((c1 (-> ent cshape1))
        (c2 (-> ent cshape2))
        )
    (cond
      ((and c1 (= (the-as process (-> c1 process)) proc))
       (if ((method-of-type touching-shapes-entry prims-touching-action?) ent c1 (collide-action deadly) (collide-action))
           #t
           #f
           )
       )
      ((and c2 (= (the-as process (-> c2 process)) proc))
       (if ((method-of-type touching-shapes-entry prims-touching-action?) ent c2 (collide-action deadly) (collide-action))
           #t
           #f
           )
       )
      (else
        #f
        )
      )
    )
  )

(defun blast-bot-add-leg-sphere ((root collide-shape) (id int) (joint int) (y float))
  ;; One touch sphere on a leg bone (same layout as bombbot.gc: 4 spheres per bone, 8 per leg).
  (let ((p (new 'process 'collide-shape-prim-sphere root (the-as uint id))))
    (set! (-> p prim-core collide-as) (collide-spec jak))
    (set! (-> p prim-core collide-with) (the-as collide-spec #xffffffff))
    ;; touch spheres only need actors. With backgnd in here every sphere pulls level triangles into the collide cache
    ;; ("Exceeded collide cache max # of tris (blast-bot-player)") and overlap tests start missing things.
    (logclear! (-> p prim-core collide-with) (collide-spec backgnd))
    (set! (-> p prim-core action) (collide-action solid no-standon))
    (set! (-> p transform-index) joint)
    (set-vector! (-> p local-sphere) 0.0 y 0.0 2867.2)
    )
  0
  )

(defun blast-bot-attack-result ((this blast-bot-player) (proc process) (block event-message-block))
  ;; Decides what an incoming 'attack does to the bot. Returns
  ;;   0 = not for us (Jak's own hits / the bot's own shots), ignored
  ;;   1 = absorbed (shield up, still invulnerable from the last hit, or god mode)
  ;;   2 = hurt
  ;;   3 = destroyed (the caller switches to the die state)
  (let ((info (the-as attack-info (-> block param 1)))
        (amount 1.0)
        (id (the-as uint 0))
        (friendly #f)
        )
    (when (and (-> block param 1) (logtest? (-> info mask) (attack-mask damage)))
      (set! amount (-> info damage))
      )
    (when (and (-> block param 1) (logtest? (-> info mask) (attack-mask id)))
      (set! id (-> info id))
      )
    (when (or (= proc this) (and *target* (= proc *target*)))
      (set! friendly #t)
      )
    ;; hits credited to Jak (the bot's own attacks and splash)
    (when (and (-> block param 1) *target* (logtest? (-> info mask) (attack-mask attacker))
               (= (handle->process (-> info attacker)) *target*))
      (set! friendly #t)
      )
    ;; the bot's own shots: ignore-handle is the bot (blast-bot-fire-shot), and the owner is Jak when credit-jak is on.
    ;; Enemy guard shots have neither.
    ;; morphgun shots the bot fired (gun-red-shot parented to the bot, or naming the bot as attacker, see
    ;; blast-bot-morphgun-attacker): their direct hit / splash must not hurt the bot
    (when (and (-> block param 1) (logtest? (-> info mask) (attack-mask attacker))
               (= (handle->process (-> info attacker)) this))
      (set! friendly #t)
      )
    (let ((rs (as-type proc gun-red-shot)))
      (when (and rs (= (ppointer->process (-> rs parent)) this))
        (set! friendly #t)
        )
      )
    (let ((pj (as-type proc projectile)))
      (when (and pj (or (= (handle->process (-> pj ignore-handle)) this)
                        (= (handle->process (-> pj owner-handle)) this)))
        (set! friendly #t)
        )
      )
    (let ((gs (as-type proc guard-shot)))
      (when gs
        (when (= (handle->process (-> gs ignore-handle)) this)
          (set! friendly #t)
          )
        (when (and *target* (= (handle->process (-> gs owner-handle)) *target*))
          (set! friendly #t)
          )
        )
      )
    ;; the bot's own shield bumping into things sends 'attack back at its owner (0 damage): not an enemy hit
    (when (as-type proc shield-sphere)
      (set! friendly #t)
      )
    (if *blast-bot-attack-debug*
        (let ((en (as-type proc enemy)))
          (format 0 "Blast Bot: attack from ~A dmg ~f friendly ~A shield ~A state ~A dangerous ~A~%"
                  (if proc (-> proc type) #f) amount friendly (-> this shield-on)
                  (if (and en (-> en next-state)) (-> en next-state name) #f)
                  (and en (logtest? (-> en focus-status) (focus-status dangerous))))
          )
        )
    (cond
      (friendly 0)
      ((or *blast-bot-god-mode*
           (and (-> this shield-on) (handle->process (-> this shield-handle)))
           (< (current-time) (-> this hit-until))
           (and (nonzero? id) (= id (-> this last-hit-id)))
           )
       1
       )
      (else
        (set! (-> this last-hit-id) id)
        (set! (-> this hit-until)
              (+ (current-time) (the int (* *blast-bot-invuln-time* (the float (seconds 1)))))
              )
        (set! (-> this hit-flash) 1.0)
        (set! (-> this health) (fmax 0.0 (- (-> this health) (* amount *blast-bot-damage-scale*))))
        (if (not *blast-bot-spy-active*) (activate! *camera-smush-control* 768.0 37 60 1.0 0.99 (-> this clock)))
        (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 200 (seconds 0.2))
        (format 0 "Blast Bot: hit for ~f, health ~f / ~f~%" amount (-> this health) (-> this max-health))
        (if (<= (-> this health) 0.0)
            3
            2
            )
        )
      )
    )
  )

(defun blast-bot-floor-probe ((this blast-bot-player) (print? symbol))
  ;; What is the surface under the bot's feet? Returns its pat event number, or -1 when there is no floor within about
  ;; 1.5 m of the feet (so a bot hovering high above lava is not burned). With print? it also prints the pat (mode /
  ;; material / event) and the actor the hit triangle belongs to (if any).
  ;; Lava floors are not water regions: the engine flags them through the pat event and applies it in react-to-pat!,
  ;; a hook the bot's own collision never goes through, so the bot has to read the event itself.
  (let ((q (new 'stack-no-clear 'collide-query))
        (ev -1)
        )
    (vector-copy! (-> q start-pos) (-> this root trans))
    (+! (-> q start-pos y) 16384.0)
    (set-vector! (-> q move-dist) 0.0 -163840.0 0.0 1.0)
    (set! (-> q radius) 40.96)
    (set! (-> q collide-with) (collide-spec backgnd obstacle pusher hit-by-others-list))   ;; pusher = platforms / elevators: without it the probe fell through them to the lava floor just below
    (set! (-> q ignore-process0) this)
    (set! (-> q ignore-process1) #f)
    (set! (-> q ignore-pat) (new 'static 'pat-surface))
    (set! (-> q action-mask) (collide-action solid))
    (let ((hit (fill-and-probe-using-line-sphere *collide-cache* q)))
      (cond
        ((>= hit 0.0)
         (let* ((pat (-> q best-other-tri pat))
                (prim (as-type (-> q best-other-tri collide-ptr) collide-shape-prim))
                (floor-y (+ (-> q start-pos y) (* hit (-> q move-dist y))))
                )
           (if print?
               (format 0 "Blast Bot floor: y ~M mode ~D material ~D event ~D actor ~A~%"
                       floor-y
                       (the-as int (-> pat mode))
                       (the-as int (-> pat material))
                       (the-as int (-> pat event))
                       (if prim (-> prim cshape process type) #f)
                       )
               )
           (if (< (- (-> this root trans y) floor-y) 6144.0)
               (set! ev (the-as int (-> pat event)))
               )
           )
         )
        (else
          (if print?
              (format 0 "Blast Bot floor: nothing below~%")
              )
          )
        )
      )
    ev
    )
  )

(define *blast-bot-hazard-debug* #f) ;; prints what the lava check sees about once a second; set to #f when it works

(defun blast-bot-hazard-check ((this blast-bot-player))
  ;; Lava (water.gc): Jak's own lava damage comes from his water-control, which only runs for `target` and only while
  ;; his own collision is in the lava. He rides the bot far above it, so ask the water system about the bot's feet.
  ;; Two ways of asking, either one triggers the damage (and the debug print shows which one sees the lava):
  ;;   A: through the bot's own collision prims (what water-control does)
  ;;   B: through two small spheres sitting on the bot's root (the feet), independent of the prim layout
  ;;   C: the pat event of the floor under the feet (how the arena and volcano lava are actually flagged)
  (let ((wa (new 'stack-no-clear 'water-info))
        (wb (new 'stack-no-clear 'water-info))
        (sp (new 'static 'inline-array water-sphere 2 (new 'static 'water-sphere) (new 'static 'water-sphere)))
        )
    (water-info-init! (-> this root) wa (collide-action solid semi-solid))
    (dotimes (i 2)
      (set! (-> sp i sphere quad) (-> this root trans quad))
      (set! (-> sp i sphere r) 4096.0)
      (set! (-> sp i flags) (water-flag))
      )
    (find-water-with-spheres sp 2 wb)
    (let ((lava-a (and (logtest? (-> wa flags) (water-flag lava))
                       (< (-> this root trans y) (+ -204.8 (-> wa base-height)))
                       )
                  )
          (lava-b (and (logtest? (-> wb flags) (water-flag lava))
                       (< (-> this root trans y) (+ -204.8 (-> wb base-height)))
                       )
                  )
          ;; C: the floor itself. Measured: metalhead valley = pat event 19,arena lava = pat event 18, volcano lava = pat event 6
          (lava-c (let ((ev (blast-bot-floor-probe this (and *blast-bot-hazard-debug* (zero? (logand (current-time) 63))))))
                    (or (= ev 19) (= ev 18) (= ev 6)) 
                    )
                  )
          )
      (when (and *blast-bot-hazard-debug* (zero? (logand (current-time) 63)))
        (format 0 "Blast Bot hazard: root y ~M | A flags #x~x base ~M lava ~A~%"
                (-> this root trans y)
                (the-as int (-> wa flags)) (-> wa base-height) lava-a
                )
        (format 0 "Blast Bot hazard: B flags #x~x base ~M lava ~A~%"
                (the-as int (-> wb flags)) (-> wb base-height) lava-b
                )
        )
      (when (or lava-a lava-b lava-c)
        (let ((b (new 'stack-no-clear 'event-message-block)))
          ;; no attack id: every tick must count (the invulnerability window paces them), and no sender,
          ;; because blast-bot-attack-result treats a sender of `this` as friendly fire
          (set! (-> b param 1)
                (the-as uint (static-attack-info ((damage *blast-bot-lava-damage*) (mode 'melt)))))
          (blast-bot-attack-result this (the-as process #f) b)
          )
        )
      )
    )
  0
  )

;; Jak is killed where he sits (still in grab-ride), no ejection: 'instant-death skips the death animation, and
;; target-hit sends him to target-death (mission fail / checkpoint reload). NOTE: target-attacked / target-hit only
;; do that when (-> *game-info* mode) is 'play; in 'debug mode the hit just drains his health.
;; name of the state Jak is in (or about to enter), #f if unknown
(defun blast-bot-jak-state ()
  (if (and *target* (-> *target* next-state))
      (-> *target* next-state name)
      #f
      )
  )

;; #t while Jak is alive and has NOT started dying
(defun blast-bot-jak-alive? ()
  (and *target*
       (not (focus-test? *target* dead))
       (let ((st (blast-bot-jak-state)))
         (not (or (= st 'target-hit) (= st 'target-death)))
         )
       )
  )

(defun blast-bot-kill-jak ()
  (when *target*
    (logclear! (-> *target* focus-status) (focus-status hit))
    (logclear! (-> *target* target-flags) (target-flags disable-attacks))
    (send-event *target* 'attack-invinc #f
                (static-attack-info ((id (new-attack-id)) (damage 1000.0) (mode 'instant-death))))
    )
  (none)
  )

(defstate active (blast-bot-player)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touched)
       ;; A leg/body sphere overlapped something. Like Jak's punch, hit whatever it is and let the other side decide
       ;; (crates, walls, pickups and enemies each have their own 'attack handler). The old version only attacked
       ;; things whose process-mask was enemy/guard/crate, so any destructible with a different mask was skipped.
       ;; Pickups answer 'attack by sending 'get-pickup back, which the handler below forwards to Jak.
       ;; One attack id per 0.4s.
        (when (and proc
                  (!= proc self)
                  (!= proc *target*)
                  (!= proc (handle->process (-> self shield-handle)))
                  (not (logtest? (process-mask civilian) (-> proc mask)))
                  ;; let an attacker finish its swing/lunge: its hit lands first, the legs get it afterwards
                  (not (let ((en (as-type proc enemy)))
                         (and en (logtest? (-> en focus-status) (focus-status dangerous)))))
                  )
         (when (>= (current-time) (-> self leg-id-time))
           (set! (-> self leg-id-time) (+ (current-time) (seconds 0.4)))
           (set! (-> self leg-id) (new-attack-id))
           )
         (send-event proc 'attack (-> block param 0)
                     (blast-bot-credit-jak!
                       (static-attack-info :mask (penetrate-using)
                                           ((id (-> self leg-id))
                                            (damage 2.0)
                                            (mode 'explode)
                                            (penetrate-using (penetrate generic-attack punch spin flop mech-punch explode))
                                            ))))
         )
       #t
       )
      (('touch)
       (let ((pd (as-type proc process-drawable)))
         (if (and *blast-bot-touch-attack*
                  pd
                  (> (-> block num-params) 0)
                  (nonzero? (-> block param 0))
                  (logtest? (process-mask enemy) (-> pd mask))
                  (type? (-> pd root) collide-shape)
                  )
              (when (and (let ((en (as-type proc enemy)))
                          (and en (logtest? (-> en focus-status) (focus-status dangerous))))
                        (blast-bot-deadly-touch? (the-as touching-shapes-entry (-> block param 0)) proc))
               (let* ((b (new 'stack-no-clear 'event-message-block))
                      (e (as-type proc enemy))
                      (swing-id (if e (-> e attack-id) (the-as uint 0)))
                      )
                 ;; one swing = one hit: hand over the attacker's own attack id, same as shots do
                 (set! (-> b param 1)
                       (the-as uint (static-attack-info ((id swing-id) (damage 1.0)))))
                 (!= (blast-bot-attack-result self proc b) 0)
                 )
               )
             #f
             )
         )
       )
      (('attack 'attack-invinc)
       ;; enemy shots / explosions / touch attacks: health instead of a one-hit-nothing. Own hits are ignored.
       ;; at 0 health the bot's own :trans switches to the die state (going there from inside this handler would
       ;; run the enter code on the shooter's process instead of ours)
       (let ((r (blast-bot-attack-result self proc block)))
         (!= r 0)
         )
       )
      (('get-pickup)
       ;; orbs/cells are collected by touching them; Jak is the one who actually owns the inventory
       (if *target*
           (send-event *target* 'get-pickup (-> block param 0) (-> block param 1))
           #f
           )
       )
      (else
        #f
        )
      )
    )
  :enter (behavior ()
    (format 0 "Blast Bot: active enter~%")
    (when *camera*
      (send-event *camera* 'change-target self)
      (format 0 "Blast Bot: camera target request returned~%")
      )
    (let ((angle (* 182.04445 25.0)))
      (set-setting! 'string-min-height 'abs (+ -4096.0 (* 61440.0 (sin angle))) 0)
      (set-setting! 'string-max-height 'abs (+ 4096.0 (* 61440.0 (sin angle))) 0)
      (set-setting! 'string-min-length 'abs (+ -4096.0 (* 61440.0 (cos angle))) 0)
      (set-setting! 'string-max-length 'abs (+ 4096.0 (* 61440.0 (cos angle))) 0)
      )
    (set-setting! 'immediate-string-min-max #f 0.0 0)
    (when *target*
      (format 0 "Blast Bot: requesting grab-ride~%")
      (send-event *target* 'change-mode 'grab-ride #t)
      (format 0 "Blast Bot: grab-ride request returned~%")
      )
    )
  :trans (behavior ()
    (when (<= (-> self health) 0.0)
      (go-virtual die)
      )
    (blast-bot-absorb-push self)
    (blast-bot-jump-update self)
    (blast-bot-hazard-check self)
    ;; L2: launch the spy droid / summon the bot to it (blastbot-spybot.gc). Handled here, in the bot's own state, so it does
    ;; not depend on how your mod code calls blast-bot-pad-check.
    (when (cpad-pressed? 0 l2)
      (format 0 "Spy bot: L2 pressed~%")
      (spybot-toggle)
      )
    (let ((speed (-> *cpad-list* cpads 0 stick0-speed))
          (dt (seconds-per-frame))
          (dashing (< (current-time) (-> self dash-until)))
          )
      (set! (-> self input-active) #f)
      (seek! (-> self hit-flash) 0.0 (* dt 3.0))
      (when (and (< 0.05 speed) (not *blast-bot-spy-active*))
        (let ((move (new 'stack-no-clear 'vector)))
          (vector-copy! move (-> *math-camera* inv-camera-rot fvec))
          (set! (-> move y) 0.0)
          (vector-normalize! move 1.0)
          (vector-rotate-around-y! move move (-> *cpad-list* cpads 0 stick0-dir))
          (set! (-> self input-yaw) (vector-y-angle move))
          (set! (-> self input-active) #t)
          ;; only the ground mode walks; while crouching / airborne / recovering the stick just aims the head
          (when (and (= (-> self jump-mode) 0) (not dashing) (not (-> self hover-on)))
            (let* ((amount (* 49152.0 speed (-> self ramp) dt))
                   (frac (blast-bot-move-xz self (* (-> move x) amount) (* (-> move z) amount)))
                   )
              ;; board rule: slam into a wall and the speed is gone
              (if (< frac 0.5)
                  (set! (-> self ramp) 1.0)
                  )
              )
            )
          )
        )
      ;; R2 hover glide: the velocity follows the stick (accel) and bleeds off slowly when it is released (decel),
      ;; so the bot keeps drifting instead of stopping dead. Walking (hover off) is unchanged.
      (cond
        ((and (-> self hover-on) (= (-> self jump-mode) 0) (not dashing) (not *blast-bot-spy-active*))
         (let* ((top (* 49152.0 (if (-> self input-active) speed 0.0) (-> self ramp)))
                (tx (if (-> self input-active) (* (sin (-> self input-yaw)) top) 0.0))
                (tz (if (-> self input-active) (* (cos (-> self input-yaw)) top) 0.0))
                (dx (- tx (-> self hover-vx)))
                (dz (- tz (-> self hover-vz)))
                (len (sqrtf (+ (* dx dx) (* dz dz))))
                (step (* dt (if (-> self input-active) *blast-bot-hover-accel* *blast-bot-hover-decel*)))
                )
           (if (or (<= len step) (= len 0.0))
               (begin
                 (set! (-> self hover-vx) tx)
                 (set! (-> self hover-vz) tz)
                 )
               (begin
                 (+! (-> self hover-vx) (* (/ dx len) step))
                 (+! (-> self hover-vz) (* (/ dz len) step))
                 )
               )
           )
         (when (or (< 1.0 (fabs (-> self hover-vx))) (< 1.0 (fabs (-> self hover-vz))))
           (let ((frac (blast-bot-move-xz self (* (-> self hover-vx) dt) (* (-> self hover-vz) dt))))
             ;; wall: the speed is gone (board rule)
             (when (< frac 0.5)
               (set! (-> self hover-vx) 0.0)
               (set! (-> self hover-vz) 0.0)
               (set! (-> self ramp) 1.0)
               )
             )
           )
         )
        (else
          (set! (-> self hover-vx) 0.0)
          (set! (-> self hover-vz) 0.0)
          )
        )
      ;; camera: the follow camera has a limited speed, so pull it back the faster the bot glides
      (let* ((spd (/ (sqrtf (+ (* (-> self hover-vx) (-> self hover-vx)) (* (-> self hover-vz) (-> self hover-vz)))) 49152.0))
             (want (if *blast-bot-spy-active* *blast-bot-spy-cam-zoom* (+ 1.0 (* *blast-bot-cam-pullback* (fmin 1.0 (fmax 0.0 (/ (- spd 1.0) 3.0)))))))
             )
        (seek! (-> self cam-zoom) want (* dt 1.5))
        (when (< 0.02 (fabs (- (-> self cam-zoom) (-> self cam-zoom-set))))
          (set! (-> self cam-zoom-set) (-> self cam-zoom))
          (let ((angle (* 182.04445 25.0))
                (z (-> self cam-zoom))
                )
            (set-setting! 'string-min-height 'abs (+ -4096.0 (* 61440.0 (sin angle) z)) 0)
            (set-setting! 'string-max-height 'abs (+ 4096.0 (* 61440.0 (sin angle) z)) 0)
            (set-setting! 'string-min-length 'abs (+ -4096.0 (* 61440.0 (cos angle) z)) 0)
            (set-setting! 'string-max-length 'abs (+ 4096.0 (* 61440.0 (cos angle) z)) 0)
            )
          )
        )
      ;; speed ramp: builds while the stick is held on the ground, bleeds off when it is released
      ;; speed ramp is Hover-only: builds while R2-hover is active and the stick is held, otherwise bleeds off
      (if (and (-> self input-active) (-> self hover-on) (!= (-> self jump-mode) 1))
          (seek! (-> self ramp) *blast-bot-ramp-max*
                 (* dt (/ (- *blast-bot-ramp-max* 1.0) *blast-bot-ramp-time*)))
          (seek! (-> self ramp) 1.0 (* dt (if (-> self hover-on) 0.25 2.0)))
          )
      ;; Square: charge forward in the stick direction (or where the head already points)
      (when (and (cpad-pressed? 0 square) (not *blast-bot-spy-active*)
                 (= (-> self jump-mode) 0)
                 (not dashing)
                 (>= (current-time) (-> self dash-ready))
                 )
        (set! (-> self dash-yaw) (if (-> self input-active) (-> self input-yaw) (-> self head-yaw)))
        (set! (-> self head-yaw) (-> self dash-yaw))
        (set! (-> self dash-until) (+ (current-time) (seconds 0.35)))
        (set! (-> self dash-ready) (+ (current-time) (seconds 1.0)))
        (set! (-> self dash-id) (new-attack-id))
        (set! dashing #t)
        (if (not *blast-bot-spy-active*) (activate! *camera-smush-control* 768.0 37 60 1.0 0.99 (-> self clock)))
        )
      (when dashing
        (let* ((amount (* *blast-bot-dash-speed* dt))
               (frac (blast-bot-move-xz self
                                        (* (sin (-> self dash-yaw)) amount)
                                        (* (cos (-> self dash-yaw)) amount)))
               )
          (blast-bot-dash-attack self)
          (when (< frac 0.5)
            ;; hit a wall: the charge ends with a bang
            (set! (-> self dash-until) 0)
            (set! (-> self ramp) 1.0)
            (if (not *blast-bot-spy-active*) (activate! *camera-smush-control* 1024.0 37 90 1.0 0.99 (-> self clock)))
            )
          )
        )
      ;; D-pad: morphgun type
      (blast-bot-gun-select)
      (when *blast-bot-use-morphgun*
        (blast-bot-heat-update dt)
        (if (not *blast-bot-hud-on*)
            (blast-bot-heat-text)      ;; console meter only when the hud is off
            )
        (blast-bot-yellow-update self)
        )
      (blast-bot-scan-update self)
      ;; R2 (held): hover. Legs sweep back and the body floats up.
      ;; R2 (press): toggle hover on/off. Only switchable from the ground or while airborne.
      (when (and (cpad-pressed? 0 r2) (not *blast-bot-spy-active*) (or (= (-> self jump-mode) 0) (= (-> self jump-mode) 2)))
        (set! (-> self hover-on) (not (-> self hover-on)))
        )
      (seek! (-> self hover-blend)
             (if (and (-> self hover-on) (or (= (-> self jump-mode) 0) (= (-> self jump-mode) 2))) 1.0 0.0)
             (* 4.0 dt))
      (set! (-> self hover-lift) (* (-> self hover-blend) *blast-bot-hover-height*))
      ;; Circle (held): the mech's shield. Movement is not touched.
      (blast-bot-update-shield-break self)
      (let ((want (and (cpad-hold? 0 circle) (not *blast-bot-spy-active*) (zero? (-> self shield-broken-until)))))
        (when (!= want (-> self shield-on))
          (set! (-> self shield-on) want)
          (format 0 "Blast Bot: shield ~A (handle ok: ~A)~%" (if want 'on 'off) (if (handle->process (-> self shield-handle)) #t #f))
          (if want
              (send-event (handle->process (-> self shield-handle)) 'enabled)
              (send-event (handle->process (-> self shield-handle)) 'disabled)
              )
          )
        )
      (blast-bot-ride-update self)
      (blast-bot-regrab self)
      ;; keep Jak (parked in grab-ride) from blocking doors / level borders
      (when (and *target* *blast-bot-clear-grabbed* (= (blast-bot-jak-state) 'target-grab-ride))
        (logclear! (-> *target* focus-status) (focus-status grabbed ignore))
        )
      ;; the head swings to the stick direction and stays there; the body then turns to follow the HEAD
      (when (-> self input-active)
        (set! (-> self head-yaw)
              (deg-seek (-> self head-yaw) (-> self input-yaw) (* 131072.0 (seconds-per-frame)))))
      (quaternion-vector-angle! (-> self root quat) *up-vector*
                                (deg-seek (quaternion-y-angle (-> self root quat))
                                          (-> self head-yaw)
                                          (* *blast-bot-body-turn-rate* (seconds-per-frame))))
      (set! (-> self speed) (cond
                              (dashing 1.0)
                              ((= (-> self jump-mode) 0)
                               (fmax speed (fmin 1.0 (/ (sqrtf (+ (* (-> self hover-vx) (-> self hover-vx))
                                                                   (* (-> self hover-vz) (-> self hover-vz))))
                                                         49152.0)))
                               )
                              (else 0.0)
                              ))
      )
    (if (not *blast-bot-spy-active*)
        (blast-bot-fire-input self)   ;; R1 for every weapon: see blastbot_guns.gc
        )
    ;; our own shots start inside the shield: its hit sphere is off for a moment after each shot so they fly out
    (let ((sh (as-type (handle->process (-> self shield-handle)) shield-sphere)))
      (when sh
        (cond
          ((< (current-time) (-> self shield-open-until))
           (set! (-> sh root root-prim prim-core collide-as) (collide-spec))
           )
          ((nonzero? (-> self shield-open-until))
           (set! (-> self shield-open-until) 0)
           (if (-> self shield-on)
               (set! (-> sh root root-prim prim-core collide-as) (-> sh root backup-collide-as))
               )
           )
          )
        )
      )
    )
  :code (behavior ()
    (format 0 "Blast Bot: animation loop started~%")
    (until #f
      (ja-no-eval :group! (-> self draw art-group data 3) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    (blast-bot-absorb-push self)
    (let ((a (-> self aggro-shape)))
      (when (nonzero? a)
        (vector-copy! (-> a trans) (-> self root trans))
        (update-transforms a)
        )
      )
    (blast-bot-update-aim self)
    (blast-bot-update-hud self)
    (blast-bot-draw-shield-status self)
    (if *blast-bot-legs-on*
        (blast-bot-update-legs self)
        (dotimes (i 4)
          (enable-set! (-> self joint-ik i) #f)
          )
        )
    (ja-post)
    (update-transforms (-> self root))
    (blast-bot-touch self)
    (blast-bot-draw-laser self)
    (vector-copy! (-> self ext-pos) (-> self root trans))
    (+! (-> self debug-frame-count) 1)
    )
  )

;; One step of the "kill Jak" sequence, called every frame from the die state (no suspend in here, the bot process only
;; has a tiny stack so the die :code has to stay small). target-grab-ride / target-grab never handle 'attack, so if
;; the first hit is swallowed, Jak is released ('change-mode 'grab -> target-grab, 'end-mode 'grab -> target-stance)
;; and hit again.
(defun blast-bot-kill-step ((i int))
  (case i
    ((0)
     (blast-bot-kill-jak)
     )
    ((2)
     (when (blast-bot-jak-alive?)
       (format 0 "Blast Bot: Jak ignored the hit (~A), releasing him~%" (blast-bot-jak-state))
       (send-event *target* 'change-mode 'grab #t)
       )
     )
    ((4)
     (when (blast-bot-jak-alive?)
       (format 0 "Blast Bot: after grab: ~A~%" (blast-bot-jak-state))
       (send-event *target* 'end-mode 'grab)
       )
     )
    ((6)
     (when (blast-bot-jak-alive?)
       (format 0 "Blast Bot: after end-mode: ~A~%" (blast-bot-jak-state))
       (blast-bot-kill-jak)
       )
     )
    )
  (none)
  )

(defstate die (blast-bot-player)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    #f
    )
  :enter (behavior ()
    (format 0 "Blast Bot: destroyed~%")
    (blast-bot-stock-huds #t)
    (set! *blast-bot-hud-health* 0.0)
    (format 0 "Blast Bot: die 1 - hud~%")
    (when *blast-bot-hud-on*
      (let ((hud (handle->process (-> self hud-handle))))
        (if hud
            (send-event hud 'hide-and-die)
            )
        )
      )
    (format 0 "Blast Bot: die 2 - shield~%")
    (let ((sh (handle->process (-> self shield-handle))))
      (if sh
          (send-event sh 'shield-detach)
          )
      )
    (set! (-> self shield-on) #f)
    (format 0 "Blast Bot: die 3 - collision~%")
    ;; nothing can hit the wreck, and it is not drawn any more (no :post in this state)
    (let ((prim (-> self root root-prim)))
      (set! (-> prim prim-core collide-as) (collide-spec))
      (set! (-> prim prim-core collide-with) (collide-spec))
      )
    (let ((a (-> self aggro-shape)))
      (if (nonzero? a)
          (set! (-> a root-prim prim-core collide-as) (collide-spec))
          )
      )
    (logior! (-> self draw status) (draw-control-status no-draw))
    (format 0 "Blast Bot: die 4 - camera / explosion~%")
    (if (not *blast-bot-spy-active*) (activate! *camera-smush-control* 1024.0 37 210 1.0 0.995 (-> self clock)))
    ;; big visual-only explosion (the group comes from the krimson guard / bombbot code; skipped when it is not loaded)
    (when (and *blast-bot-death-explosion* group-kg-huge-explosion (nonzero? group-kg-huge-explosion))
      (let ((gp (new 'stack-no-clear 'explosion-init-params)))
        (vector-copy! (-> gp spawn-point) (-> self root trans))
        (+! (-> gp spawn-point y) 12288.0)
        (quaternion-identity! (-> gp spawn-quat))
        (set! (-> gp radius) 61440.0)
        (set! (-> gp scale) 1.0)
        (set! (-> gp group) group-kg-huge-explosion)
        (set! (-> gp collide-with) (collide-spec))
        (set! (-> gp damage) 0.0)
        (set! (-> gp damage-scale) 1.0)
        (set! (-> gp vehicle-damage-factor) 1.0)
        (set! (-> gp vehicle-impulse-factor) 1.0)
        (set! (-> gp ignore-proc) (process->handle #f))
        (explosion-spawn gp self)
        )
      )
    )
  :code (behavior ()
    (let ((t0 (current-time)))
      (format 0 "Blast Bot: die 5 - killing Jak in place~%")
      (when *blast-bot-death-kills-jak*
        (dotimes (i 8)
          (blast-bot-kill-step i)
          (suspend)
          )
        (format 0 "Blast Bot: Jak state ~A~%" (blast-bot-jak-state))
        )
      (format 0 "Blast Bot: die 7 - waiting for children~%")
      ;; the explosion is our child process: wait for it (max 5 s) before the bot goes away
      (until (or (not (-> self child)) (>= (current-time) (+ t0 (seconds 5))))
        (suspend)
        )
      )
    (when (and *camera* *target*)
      (send-event *camera* 'change-target *target*)
      )
    (format 0 "Blast Bot: die 8 - gone~%")
    (deactivate self)
    )
  )

(define *blast-bot-reach-radius* 16384.0)  ;; 4 m: how far from its center the bot's body counts as "reachable"
(define *blast-bot-reach-pos* (new 'static 'vector))

;; Enemies ask the bot where it is. Instead of the center, hand an enemy the point of the bot's footprint nearest to
;; it, so melee range, attack range and pathing work from the edge of the body instead of 4+ m inside it.
(defmethod get-trans ((this blast-bot-player) (arg0 int))
  (let ((base (call-parent-method this arg0)))
    (with-pp
      (if (and *blast-bot-reach-hack*
               pp
               (not (= pp this))
               (logtest? (-> pp mask) (process-mask enemy))
               (type? pp process-drawable)
               )
          (let* ((e (-> (the-as process-drawable pp) root trans))
                 (dx (- (-> e x) (-> base x)))
                 (dz (- (-> e z) (-> base z)))
                 (dist (fmax 1.0 (sqrtf (+ (* dx dx) (* dz dz)))))
                 (s (/ *blast-bot-reach-radius* dist))
                 (out *blast-bot-reach-pos*)
                 )
            (set! (-> out quad) (-> base quad))
            (+! (-> out x) (* dx s))
            (+! (-> out z) (* dz s))
            ;; aim points (modes 2+, roboguards use 5) at body height, never lower than what the base gave
            (if (>= arg0 2)
                (set! (-> out y) (fmax (-> out y) (+ (-> this root trans y) 12288.0)))
                )
            out
            )
          base
          )
      )
    )
  )

(defbehavior blast-bot-player-init-by-other blast-bot-player ()
  ;; same as bombbot.gc: give the unused stack back to the process heap BEFORE any (new 'process ...) allocation
  (stack-size-set! (-> self main-thread) 512)
  (format 0 "Blast Bot: init begin~%")
  (format 0 "Blast Bot: leg limbs with spheres: ~D~%" *blast-bot-leg-limbs*)
  ;; same constructor + setup as bombbot.gc. The plain collide-shape + (collide-list-enum player) combo printed
  ;; "Unsupported collide-list-enum" and left the shape half-initialised. Enemies find the bot via the aggro shape below.
  (let ((root (new 'process 'collide-shape self (collide-list-enum player))))
    ;; 1 group + children: walls sphere, body touch sphere, (2 * *blast-bot-leg-spheres*) spheres per leg, ride sphere
    (let ((group (new 'process 'collide-shape-prim-group root (the-as uint (+ 3 (* (* 2 *blast-bot-leg-spheres*) *blast-bot-leg-limbs*))) 0)))
      (set! (-> root total-prims) (the-as uint (+ 4 (* (* 2 *blast-bot-leg-spheres*) *blast-bot-leg-limbs*))))
      (set! (-> group prim-core collide-as) (collide-spec jak))
      (set! (-> group prim-core collide-with) (the-as collide-spec #xffffffff))
      (set! (-> group prim-core action) (collide-action solid no-standon can-ride))
      (set-vector! (-> group local-sphere) 0.0 12288.0 0.0 40960.0)
      (set! (-> root root-prim) group)
      (set! (-> root nav-radius) 32768.0)
      (set! (-> root backup-collide-as) (-> group prim-core collide-as))
      (set! (-> root backup-collide-with) (-> group prim-core collide-with))
      )
    (let ((sphere (new 'process 'collide-shape-prim-sphere root (the-as uint 0))))
      (set! (-> sphere prim-core collide-as) (collide-spec obstacle))
      (set! (-> sphere prim-core collide-with) (collide-spec backgnd))
      (set! (-> sphere prim-core action) (collide-action solid))
      (set! (-> sphere transform-index) 3)
      (set-vector! (-> sphere local-sphere) 0.0 8192.0 0.0 16384.0)
      )
    (let ((body (new 'process 'collide-shape-prim-sphere root (the-as uint 0))))
      (set! (-> body prim-core collide-as) (collide-spec jak))
      (set! (-> body prim-core collide-with) (the-as collide-spec #xffffffff))
      (logclear! (-> body prim-core collide-with) (collide-spec backgnd))
      (set! (-> body prim-core action) (collide-action solid no-standon))
      (set! (-> body transform-index) 3)
      (set-vector! (-> body local-sphere) 0.0 1638.4 0.0 8192.0)
      )
    ;; legs: elbow joint + the joint below it, signs match *blast-bot-hand-dist*
    (dotimes (limb *blast-bot-leg-limbs*)
      (let ((elbow (-> *blast-bot-elbows* limb))
            (sign (if (or (= limb 0) (= limb 2)) 1.0 -1.0))
            )
        ;; the spheres cover the same 3 m span along the bone whatever their number
        (let ((step (if (> *blast-bot-leg-spheres* 1)
                        (/ 12288.0 (the float (+ *blast-bot-leg-spheres* -1)))
                        0.0
                        )
                    )
              )
          (dotimes (k *blast-bot-leg-spheres*)
            (blast-bot-add-leg-sphere root (+ limb 1) elbow (* sign step (the float k)))
            (blast-bot-add-leg-sphere root (+ limb 1) (+ elbow -1) (* sign step (the float k)))
            )
          )
        )
      )
    ;; ride sphere: the platform's detect-riders! needs the rider's root prim AND one child sphere with can-ride whose
    ;; surface is within ~3cm of the platform mesh. Centered on the root (transform-index -2 = trans + local), bottom at the feet.
    ;; collide-with is empty so it never produces touch events.
    (let ((ride (new 'process 'collide-shape-prim-sphere root (the-as uint 0))))
      (set! (-> ride prim-core collide-as) (collide-spec jak))
      (set! (-> ride prim-core collide-with) (collide-spec))
      (set! (-> ride prim-core action) (collide-action can-ride))
      (set! (-> ride transform-index) -2)
      (set-vector! (-> ride local-sphere) 0.0 2048.0 0.0 2048.0)
      )
    ;; make sure the engine actually delivers 'touched to the bot and 'touch to whatever it overlaps
    ;; (target, enemies and projectiles all set event-self explicitly; collectables wait for 'touch)
    (set! (-> root event-self) 'touched)
    (set! (-> root event-other) 'touch)
    (set! (-> self root) root)
    ;; process-focusable.water is zeroed memory, which GOAL treats as truthy. Saberfish reads (-> water flags)
    ;; off its target when it notices it, so make the field a real #f.
    (set! (-> self water) (the-as water-control #f))
    )
  (format 0 "Blast Bot: collision root ready~%")
  ;; second collider: registered in *collide-player-list* so enemies find the bot. Not the root, no can-ride, collides
  ;; with nothing; its process is the bot, so enemy shots / attacks go straight to the bot's own handlers.
  (when *blast-bot-aggro-on*
  (let ((aggro (new 'process 'collide-shape-moving self (collide-list-enum hit-by-others))))
    (let ((prim (new 'process 'collide-shape-prim-sphere aggro (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-spec jak))
      (set! (-> prim prim-core collide-with) (collide-spec))
      (set! (-> prim prim-core action) (collide-action solid dont-push-away))
      (set-vector! (-> prim local-sphere) 0.0 12288.0 0.0 24576.0)
      (set! (-> aggro root-prim) prim)
      )
    (set! (-> aggro total-prims) (the-as uint 1))
    ;; this shape is never the root, so nothing else sets up its dynamics: without them any engine code that moves it
    ;; (integrate-and-collide!) reads a null pointer
    (set! (-> aggro dynam) (copy *standard-dynamics* 'process))
    (set! (-> aggro nav-radius) 16384.0)
    (set! (-> aggro penetrated-by) (the-as penetrate -1))
    (set! (-> aggro backup-collide-as) (-> aggro root-prim prim-core collide-as))
    (set! (-> aggro backup-collide-with) (-> aggro root-prim prim-core collide-with))
    (set! (-> self aggro-shape) aggro)
    ;; enemies' find-best-focus only scans *collide-player-list* (hit-by-others only if their focus mask asks for it),
    ;; so register the aggro shape there too. Keep the hit-by-others registration: enemy shots still use it.
    (add-connection *collide-player-list* self #f aggro #f #f)
    )
  )
  (format 0 "Blast Bot: aggro shape ready~%")
  (when *target*
    (vector-copy! (-> self root trans) (target-pos 0))
    (quaternion-copy! (-> self root quat) (-> *target* root quat))
    )
  (vector-identity! (-> self root scale))
  (when (nonzero? (-> self aggro-shape))
    (vector-copy! (-> self aggro-shape trans) (-> self root trans))
    (update-transforms (-> self aggro-shape))
    )
  (initialize-skeleton self skel-blast-bot (the-as pair 0))
  (format 0 "Blast Bot: skeleton ready~%")
  (format 0 "Blast Bot: ~A~%" self) ;; DIAG: shows :heap used/total
  (blast-bot-init-legs self)
  (blast-bot-init-aim self)
  (blast-bot-spawn-shield self)
  (set! (-> self max-health) *blast-bot-max-health*)
  (set! (-> self health) (-> self max-health))
  (set! (-> self hit-flash) 0.0)
  (set! (-> self hud-handle) (the-as handle #f))
  (set! *blast-bot-hud-health* 1.0)
  (format 0 "Blast Bot: transitioning to active~%")
  (go-virtual active)
  )

(defun blast-bot-kill-others ((keep process))
  ;; Removes every blast-bot-player except `keep`. Walks the entity pool: process-by-ename looks at ENTITY names and
  ;; the bot has no entity, so it never finds it.
  (let ((p (-> *entity-pool* child)))
    (while p
      (let ((next (-> p 0 brother))
            (proc (the-as process (-> p 0)))
            )
        (when (and (!= proc keep) (type? proc blast-bot-player))
          (format 0 "Blast Bot: removing a previous bot~%")
          (deactivate proc)
          )
        (set! p next)
        )
      )
    )
  (none)
  )

(defun blast-bot-find ()
  ;; The first blast-bot-player in the entity pool, or #f.
  (let ((p (-> *entity-pool* child))
        (found (the-as process #f))
        )
    (while (and p (not found))
      (if (type? (-> p 0) blast-bot-player)
          (set! found (the-as process (-> p 0)))
          )
      (set! p (-> p 0 brother))
      )
    found
    )
  )

(defun spawn-my-bombbot ()
  ;; Spawns a new bot, then removes every previous one. Jak is released from the old bot first so the new bot can take him over.
  (when *target*
    (format 0 "Blast Bot: spawn requested~%")
    (format 0 "Blast Bot: 16k pool slot free: ~A~%" (if (-> *16k-dead-pool* child) #t #f))
    (if (blast-bot-find)
        (send-event *target* 'change-mode 'grab #t)
        )
    (let ((new (process-spawn blast-bot-player
                              ;; *16k-dead-pool* is a plain dead-pool (fixed slots, never compacts), so the bot is never
                              ;; moved in memory. It has a single slot (debug builds), so fall back to the compacting
                              ;; default pool when the slot is taken.
                              :from (if (-> *16k-dead-pool* child) *16k-dead-pool* *default-dead-pool*)
                              :to *entity-pool*
                              :stack-size #x4000
                              :name "blast-bot-player")))
      (if new
          (blast-bot-kill-others (ppointer->process new))
          )
      )
    )
  (none)
  )

(defun despawn-my-bombbot ()
  ;; L1 + Triangle: puts Jak back to normal and removes the bot. The release takes a few frames (grab, then end-grab,
  ;; same two events the die state uses), so this only starts it; blast-bot-despawn-update (call it every frame)
  ;; finishes the job and then deactivates the bot.
  (when (and *target* (zero? *blast-bot-despawn-step*))
    (let ((bot (the-as blast-bot-player (blast-bot-find))))
      (when bot
        (format 0 "Blast Bot: despawn requested (Jak ~A)~%" (blast-bot-jak-state))
        (set! *blast-bot-despawn-time* (current-time))
        ;; drop the shield first, like the die state does
        (let ((sh (handle->process (-> bot shield-handle))))
          (if sh
              (send-event sh 'shield-detach)
              )
          )
        (set! (-> bot shield-on) #f)
        (cond
          ((= (blast-bot-jak-state) 'target-grab-ride)
           (send-event *target* 'change-mode 'grab #t)
           (set! *blast-bot-despawn-step* 1)
           )
          (else
            ;; Jak is not riding (cutscene / already free): nothing to release, just remove the bot
            (set! *blast-bot-despawn-step* 3)
            )
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-despawn-update ()
  ;; Call every frame. Steps: 1 = Jak was sent into target-grab, 2 = end-grab sent (wait for him to leave target-grab),
  ;; 3 = remove the bot and give the camera back to Jak.
  (when (nonzero? *blast-bot-despawn-step*)
    (let ((bot (blast-bot-find)))
      (cond
        ((not bot)
         (set! *blast-bot-despawn-step* 0)
         )
        ((= *blast-bot-despawn-step* 1)
         (when (>= (current-time) (+ *blast-bot-despawn-time* (seconds 0.1)))
           (if *target*
               (send-event *target* 'end-mode 'grab)
               )
           (set! *blast-bot-despawn-time* (current-time))
           (set! *blast-bot-despawn-step* 2)
           )
         )
        ((= *blast-bot-despawn-step* 2)
         (when (or (not *target*)
                   (!= (blast-bot-jak-state) 'target-grab)
                   (>= (current-time) (+ *blast-bot-despawn-time* (seconds 1.0)))
                   )
           (set! *blast-bot-despawn-step* 3)
           )
         )
        (else
          (format 0 "Blast Bot: despawning (Jak ~A)~%" (blast-bot-jak-state))
          (blast-bot-stock-huds #t)
          (deactivate bot)
          (when (and *camera* *target*)
            (send-event *camera* 'change-target *target*)
            )
          (set! *blast-bot-despawn-step* 0)
          )
        )
      )
    )
  (none)
  )

(defun blast-bot-pad-check ()
  ;; L1 + R3: call every frame from your mod code (or call spawn-my-bombbot from your own binding).
  (when (and (cpad-hold? 0 l1) (cpad-pressed? 0 r3))
    (spawn-my-bombbot)
    )
  (none)
  )