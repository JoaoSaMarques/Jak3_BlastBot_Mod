;;;;;;;;;;;;;;;;;;;;;;;;;;
;; What is this file for.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#| This file is a place where you can define custom functions and GOAL code
 to call inside of mod-custom-code.gc for example I have defined a function that increases
 the powercell count by one when it is called
 |#


;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Useful GOAL modding documentation
;;;;;;;;;;;;;;;;;;;;;;;;;;

#| 
Checks the condition and if it is true it does first argument if false it does optional second argument
(if (condition) (do if true) (do if false))

Gives a random FLOAT or INT between the provided ranges when called
(rand-vu-float-range 0.0 2.0)
(rand-vu-int-range 0 10)

if the result of rand-vu-int-range is 1, then DANCE! if it is not 1, then Don't dance
(if (= (rand-vu-int-range 0 10) 1) (DANCE!) (Don't dance))


|#

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Define Custom Variables to use in mods
;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *target-board-hold-tricks* 0) ;; used to detect if player is doing a jetboard hover (see board-states.gc)

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Define Custom Functions to call in mods
;;;;;;;;;;;;;;;;;;;;;;;;;;

;; add your own unique custom functions here!

;; Macros can be used more-or-less just like functions
(defmacro current-cell-count ()
  `(-> *game-info* fuel)
  )

(defmacro set-current-cell-count (count)
  `(set! (-> *game-info* fuel) ,count)
  )
  
(defun increase-power-cell-by-one ()
  (set-current-cell-count (+ (current-cell-count) 1))
  ;; with the two macros defined above, this is equivalent to
  ;; (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
  (none)
  )

(deftype blast-bot-player (process-focusable)
  ((speed            float)
  (next-shot        time-frame)
   (debug-frame-count int32)
   )
  (:state-methods
    active
    )
  )

(defskelgroup skel-blast-bot bombbot bombbot-lod0-jg bombbot-idle-ja
              ((bombbot-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 12)
              :shadow bombbot-shadow-mg
              :texture-level 10
              )

(defun blast-bot-fire-shot ((this blast-bot-player))
  (let* ((muzzle-matrix (matrix-copy! (new 'stack-no-clear 'matrix)
                                     (-> this node-list data 6 bone transform)))
         (start (matrix->trans muzzle-matrix (new 'stack-no-clear 'vector)))
         (direction (vector-normalize-copy! (new 'stack-no-clear 'vector)
                                            (-> muzzle-matrix fvec)
                                            614400.0))
         (end (vector+! (new 'stack-no-clear 'vector) start direction)))
    (vector+*! start start (-> muzzle-matrix fvec) 8192.0)
    (vector+! end start direction)
    (spawn-guard-projectile this start end 819200.0 (the-as vector #f))
    )
  (none)
  )

(defstate active (blast-bot-player)
  :virtual #t
  :enter (behavior ()
    (format 0 "Blast Bot: active enter~%")
    (when *camera*
      (send-event *camera* 'change-target self)
      (format 0 "Blast Bot: camera target request returned~%")
      )
    (let ((angle (* 182.04445 25.0)))
      (set-setting! 'string-min-height 'abs (+ -4096.0 (* 61440.0 (sin angle))) 0)
      (set-setting! 'string-max-height 'abs (+ 4096.0 (* 61440.0 (sin angle))) 0)
      (set-setting! 'string-min-length 'abs (+ -4096.0 (* 61440.0 (cos angle))) 0)
      (set-setting! 'string-max-length 'abs (+ 4096.0 (* 61440.0 (cos angle))) 0)
      )
    (set-setting! 'immediate-string-min-max #f 0.0 0)
    (when *target*
      (format 0 "Blast Bot: requesting grab-ride~%")
      (send-event *target* 'change-mode 'grab-ride #t)
      (format 0 "Blast Bot: grab-ride request returned~%")
      )
    )
  :trans (behavior ()
    (let ((speed (-> *cpad-list* cpads 0 stick0-speed)))
      (when (< 0.05 speed)
        (-> *math-camera* inv-camera-rot)
        (let ((move (new 'stack-no-clear 'vector)))
          (vector-copy! move (-> *math-camera* inv-camera-rot fvec))
          (set! (-> move y) 0.0)
          (vector-normalize! move 1.0)
          (vector-rotate-around-y! move move (-> *cpad-list* cpads 0 stick0-dir))
          (vector+*! (-> self root trans)
                     (-> self root trans)
                     move
                     (* 49152.0 speed (seconds-per-frame)))
          (quaternion-look-at! (-> self root quat) move *up-vector*)
          )
        )
      (set! (-> self speed) speed)
      )
    (when (and (cpad-pressed? 0 r1)
               (>= (+ (current-time) (seconds -0.02)) (-> self next-shot)))
      (set! (-> self next-shot) (+ (current-time) (seconds 0.2)))
      (blast-bot-fire-shot self)
      )
    )
  :code (behavior ()
    (format 0 "Blast Bot: animation loop started~%")
    (until #f
      (ja-no-eval :group! (-> self draw art-group data 3) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    (let ((was-uninited (logtest? (-> self draw status) (draw-control-status uninited))))
      (ja-post)
      (when was-uninited
        (format 0 "Blast Bot: first draw post flags #x~X~%" (-> self draw status))
        )
      )
    (update-transforms (-> self root))
    (+! (-> self debug-frame-count) 1)
    (when (= (-> self debug-frame-count) 60)
          (let ((camera (camera-pos)))
      (format 0 "Blast Bot: renderer status #x~X on-screen ~A layer ~d current-level ~A~%"
        (-> self draw status)
        (if (logtest? (-> self draw status) (draw-control-status on-screen)) "yes" "no")
        (-> self draw level-index)
        (-> *level* draw-level (-> self draw level-index) display?))
      (format 0 "Blast Bot: texture-page ~d mesh ~A max LOD ~d~%"
        (-> self draw default-texture-page)
        (if (-> self draw mgeo) "present" "missing")
        (-> self draw max-lod))
      (format 0 "Blast Bot: root (~f, ~f, ~f) camera (~f, ~f, ~f)~%"
        (-> self root trans x)
        (-> self root trans y)
        (-> self root trans z)
        (-> camera x)
        (-> camera y)
        (-> camera z))
      )
      )
    )
  )

(defbehavior blast-bot-player-init-by-other blast-bot-player ()
  (format 0 "Blast Bot: init begin~%")
  (let ((root (new 'process 'collide-shape self (collide-list-enum usually-hit-by-player))))
    (let ((sphere (new 'process 'collide-shape-prim-sphere root (the-as uint 0))))
      (set! (-> sphere prim-core collide-as) (collide-spec obstacle))
      (set! (-> sphere prim-core collide-with) (collide-spec backgnd))
      (set! (-> sphere prim-core action) (collide-action solid))
      (set! (-> sphere transform-index) 3)
      (set-vector! (-> sphere local-sphere) 0.0 8192.0 0.0 32768.0)
      (set! (-> root total-prims) (the-as uint 1))
      (set! (-> root root-prim) sphere)
      (set! (-> root nav-radius) 32768.0)
      (set! (-> root backup-collide-as) (-> sphere prim-core collide-as))
      (set! (-> root backup-collide-with) (-> sphere prim-core collide-with))
      )
    (set! (-> self root) root)
    )
  (format 0 "Blast Bot: collision root ready~%")
  (when *target*
    (vector-copy! (-> self root trans) (target-pos 0))
    (quaternion-copy! (-> self root quat) (-> *target* root quat))
    )
  (vector-identity! (-> self root scale))
  (initialize-skeleton self skel-blast-bot (the-as pair 0))
  (format 0 "Blast Bot: skeleton ready~%")
    (if (-> self draw)
        (begin
    (format 0 "Blast Bot: draw-control present, level ~A, flags #x~X~%"
      (-> self level name)
      (-> self draw status))
    (format 0 "Blast Bot: art-group ~A, LOD0 mesh ~A, max LOD ~d~%"
      (if (-> self draw art-group) (-> self draw art-group name) "missing")
      (if (-> self draw lod-set lod 0 geo) "present" "missing")
      (-> self draw max-lod))
        )
        (format 0 "Blast Bot: draw-control missing~%")
        )
  (format 0 "Blast Bot: transitioning to active~%")
  (go-virtual active)
  )

(defun spawn-my-bombbot ()
  (when (and *target* (not (process-by-ename "blast-bot-player")))
    (format 0 "Blast Bot: spawn requested~%")
    (process-spawn blast-bot-player
                   :from *default-dead-pool*
                   :to *entity-pool*
                   :name "blast-bot-player")
    )
  (none)
  )

(defmacro board-hovering? ()
  `(and (logtest? (focus-status board) (-> *target* focus-status)) (> *target-board-hold-tricks* 1))
  )

