    ;;-*-Lisp-*-
    (in-package goal)

    ;; name: mod-custom-code.gc
    ;; name in dgo: mod-custom-code
    ;; dgos: TODO


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; What is this file for.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    #| This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb |#


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; Begin function defintions.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    ;; Always-bot: the blast bot comes back every time Jak spawns (new game, loading a file, death) and waits until Jak is free
    ;; (no cutscene / death) plus a short delay. L1 + Triangle removes it and it stays away until you summon it again (L1 + R3).
    (define *blast-bot-always* #t)             ;; #f = back to manual (L1 + R3 only)
    (define *blast-bot-spawn-delay* 1.5)       ;; seconds after Jak appears before the bot is spawned
    (define *blast-bot-seen-target* 0)         ;; pid of the Jak (target process) seen last
    (define *blast-bot-spawn-pending* #f)
    (define *blast-bot-spawn-stamp* 0)
    (define *blast-bot-spawn-tries* 0)         ;; auto-spawn attempts for the current Jak
    (define *blast-bot-spawn-check* 0)         ;; time of the last auto-spawn, 0 = nothing to verify
    (define *blast-bot-wait-log* 0)
    (define *blast-bot-mech-resume* #f)

    (define *blast-bot-auto-default-pool* #t)  ;; #t = the 16k slot is permanently busy here, so auto-spawn uses the default pool like L1 + R3 does
    (define *blast-bot-holder-logs* 0)

    (define-extern blast-bot-log-16k-holders (function process-tree int))

    (defun blast-bot-log-16k-holders ((tree process-tree))
      ;; diagnostic: walks the whole process tree and prints every process that came from the fixed 16k pool
      (let ((p (-> tree child)))
        (while p
          (let ((next (-> p 0 brother))
                (proc (the-as process (-> p 0)))
                )
            (when (and (type? proc process) (= (-> proc pool) *16k-dead-pool*))
              (format 0 "Blast Bot: 16k slot holder: ~A~%" proc)
              )
            (blast-bot-log-16k-holders (-> p 0))
            (set! p next)
            )
          )
        )
      0
      )

    (defun blast-bot-spawn-pending! ()
      (set! *blast-bot-spawn-pending* #t)
      (set! *blast-bot-spawn-stamp* (the-as int (current-time)))
      (set! *blast-bot-spawn-check* 0)
      0
      )

    ;; ---- Mission failed while the bot is carrying Jak -------------------------------------------------------------------------------
    ;; task-control.gc: the manager's fail state spawns a resetter, and the resetter loops (every frame) sending Jak 'attack-invinc
    ;; until Jak accepts it or is dead, before it shows "Mission Failed" and restarts at the checkpoint. A Jak parked in the bot's
    ;; grab-ride never accepts it, so the fail speech played and nothing else happened (the statues never reset either).
    ;; So while a task manager is in its fail state, or a resetter exists, the bot lets Jak go (the same release as L1 + Triangle)
    ;; and the auto-spawn waits; once the failure sequence is over the bot comes back on its own.
    (define *blast-bot-fail-count* 0)                       ;; task managers currently in their fail state
    (define *blast-bot-fail-watch-next* (the-as time-frame 0))
    (define *blast-bot-release-on-fail* #t)                 ;; #f = the bot stays on Jak when a mission fails (old behaviour)
    (define-extern blast-bot-fail-walk (function process-tree int))

    (defun blast-bot-has-type? ((p process) (name symbol))
      (let ((found #f)
            (ty (-> p type))
            )
        (while (and (not found) ty)
          (if (= (-> ty symbol) name)
              (set! found #t)
              )
          (set! ty (if (= ty (-> ty parent)) (the-as type #f) (-> ty parent)))
          )
        found
        )
      )

    ;; counts the task managers in their fail state and every live resetter (the process the fail state spawns for the
    ;; "Mission Failed" screen and the checkpoint restart)
    (defun blast-bot-fail-walk ((tree process-tree))
      (let ((count 0)
            (p (-> tree child))
            )
        (while p
          (let ((next (-> p 0 brother))
                (proc (the-as process (-> p 0)))
                )
            (when (or (and (blast-bot-has-type? proc 'task-manager) (-> proc next-state) (= (-> proc next-state name) 'fail))
                      (blast-bot-has-type? proc 'resetter)
                      )
              (set! count (+ count 1))
              )
            (set! count (+ count (blast-bot-fail-walk (-> p 0))))
            (set! p next)
            )
          )
        count
        )
      )

    (defun blast-bot-fail-watch ()
      (when (>= (current-time) *blast-bot-fail-watch-next*)
        (set! *blast-bot-fail-watch-next* (+ (current-time) (seconds 0.25)))
        (let ((n (blast-bot-fail-walk *active-pool*)))
          (set! *blast-bot-fail-count* n)
          (when (and *blast-bot-release-on-fail* (> n 0) (blast-bot-find) (zero? *blast-bot-despawn-step*))
            (despawn-my-bombbot)
            )
          )
        )
      0
      )

    (defun blast-bot-spawn-watch ()
      (when (and (or *blast-bot-always* *blast-bot-mech-resume*) *target* (not *blast-bot-dismissed*) (zero? *blast-bot-fail-count*))
        ;; every spawn is a new target process, so a new handle means Jak just (re)spawned
        ;; compare the 32-bit process id: a handle is 64-bit and a global symbol only keeps 32 bits, so it never matched
        (let ((h (the-as int (-> *target* pid))))
          (when (!= h *blast-bot-seen-target*)
            (set! *blast-bot-seen-target* h)
            (set! *blast-bot-spawn-tries* 0)
            (format 0 "Blast Bot: new Jak seen, auto-spawn armed~%")
            (blast-bot-spawn-pending!)
            )
          )
        (when (and *blast-bot-spawn-pending*
                   (time-elapsed? *blast-bot-spawn-stamp* (the int (* *blast-bot-spawn-delay* 300.0)))
                   )
          (let ((st (blast-bot-jak-state)))
            (cond
              ;; not free yet (dead, cutscene grab, death/respawn state, cutscene stream): say why, every 2 seconds
              ((or (focus-test? *target* dead)
                   (not st)                      ;; Jak has no state yet (still being set up)
                   (= st 'target-title)          ;; title screen / menu: it has its own Jak, never spawn there
                   (blast-bot-jak-busy? st)
                   (-> *art-control* active-stream)
                   ;; the fixed 16k pool slot is busy (loading / menu): spawning now would put the bot in the default pool,
                   ;; which compacts during loads and moves the bot in memory (that crashed the game)
                   (and (not *blast-bot-auto-default-pool*) (not (-> *16k-dead-pool* child)))
                   )
               ;; the delay only starts counting once Jak is actually free
               (set! *blast-bot-spawn-stamp* (the-as int (current-time)))
               (when (time-elapsed? *blast-bot-wait-log* (seconds 2.0))
                 (set! *blast-bot-wait-log* (the-as int (current-time)))
                 (format 0 "Blast Bot: auto-spawn waiting (Jak ~A, grabbed ~A, stream ~A, 16k slot free ~A)~%"
                         st
                         (if (focus-test? *target* grabbed) #t #f)
                         (if (-> *art-control* active-stream) #t #f)
                         (if (-> *16k-dead-pool* child) #t #f)
                         )
                 (when (and (not (-> *16k-dead-pool* child)) (< *blast-bot-holder-logs* 2))
                   (set! *blast-bot-holder-logs* (+ *blast-bot-holder-logs* 1))
                   (blast-bot-log-16k-holders *active-pool*)
                   )
                 )
               )
              (else
                (set! *blast-bot-spawn-pending* #f)
                (set! *blast-bot-spawn-tries* (+ *blast-bot-spawn-tries* 1))
                (format 0 "Blast Bot: auto-spawn try ~D (old bot present: ~A, Jak ~A)~%"
                        *blast-bot-spawn-tries* (if (blast-bot-find) #t #f) st)
                ;; no blast-bot-find guard: an old bot can outlive a load/death (it lives in the entity pool) and would
                ;; block the spawn. spawn-my-bombbot removes every previous bot itself.
                (spawn-my-bombbot)
                (set! *blast-bot-spawn-check* (the-as int (current-time)))
                )
              )
            )
          )
        ;; 1.5 s after an auto-spawn: is the bot still alive? if not (killed by the level load, failed init), try again
        (when (and (nonzero? *blast-bot-spawn-check*)
                   (time-elapsed? *blast-bot-spawn-check* (seconds 1.5))
                   )
          (set! *blast-bot-spawn-check* 0)
          (cond
            ((blast-bot-find)
             (format 0 "Blast Bot: auto-spawn ok~%")
             (set! *blast-bot-mech-resume* #f)
             )
            ((< *blast-bot-spawn-tries* 5)
             (format 0 "Blast Bot: bot is gone after auto-spawn, retrying~%")
             (blast-bot-spawn-pending!)
             )
            (else
              (format 0 "Blast Bot: auto-spawn gave up~%")
              (set! *blast-bot-mech-resume* #f)
              )
            )
          )
        )
      0
      )

    (defun blast-bot-mech-watch ()
      (when (and *target* (focus-test? *target* mech))
        (set! *blast-bot-spawn-pending* #f)
        (when (and (zero? *blast-bot-despawn-step*) (blast-bot-find))
          (set! *blast-bot-mech-resume* #t)
          (when (!= (blast-bot-jak-state) 'target-grab-ride)
            (despawn-my-bombbot)
            )
          )
        )
      (when (and *target*
                 (not (focus-test? *target* mech))
                 *blast-bot-mech-resume*
                 (zero? *blast-bot-despawn-step*)
                 )
        (if (blast-bot-find)
            (set! *blast-bot-mech-resume* #f)
            (when (not *blast-bot-spawn-pending*)
              (blast-bot-spawn-pending!)
              )
            )
        )
      0
      )

    ;; ---- Debug commands (type them in the REPL) ----------------------------------------------------------------------------
    ;; (find-process "lid")   every live process whose name contains the text: name, type, position
    ;; (find-lid)             the same for "lid", plus the vol-stone-lid-1 entity (position, level, whether it has a process)
    ;; (find-entity "name")   an entity by its exact name (the names the debug entity labels show): position, level, process
    ;; (goto-entity "name")   moves the blast bot (or Jak when there is no bot) 10 m above that entity
    (define-extern find-process-walk (function process-tree string int))

    (defun cmd-name-has? ((name string) (pat string))
      (let ((nl (length name))
            (pl (length pat))
            (found #f)
            )
        (dotimes (i (max 0 (+ (- nl pl) 1)))
          (when (not found)
            (let ((ok #t))
              (dotimes (j pl)
                (if (!= (-> name data (+ i j)) (-> pat data j))
                    (set! ok #f)
                    )
                )
              (if ok
                  (set! found #t)
                  )
              )
            )
          )
        found
        )
      )

    (defun find-process-walk ((tree process-tree) (pat string))
      (let ((count 0)
            (p (-> tree child))
            )
        (while p
          (let ((next (-> p 0 brother))
                (proc (the-as process (-> p 0)))
                )
            (when (and (type? proc process) (-> proc name) (cmd-name-has? (-> proc name) pat))
              (set! count (+ count 1))
              (let ((pd (as-type proc process-drawable)))
                (if (and pd (nonzero? (-> pd root)))
                    (format 0 "  ~A  [~A]  at ~M ~M ~M~%" (-> proc name) (-> proc type)
                            (-> pd root trans x) (-> pd root trans y) (-> pd root trans z))
                    (format 0 "  ~A  [~A]~%" (-> proc name) (-> proc type))
                    )
                )
              )
            (set! count (+ count (find-process-walk (-> p 0) pat)))
            (set! p next)
            )
          )
        count
        )
      )

    (defun find-process ((pat string))
      (format 0 "find-process \"~S\":~%" pat)
      (let ((n (find-process-walk *active-pool* pat)))
        (format 0 "  ~D match(es)~%" n)
        n
        )
      )

    (defun find-entity ((name string))
      (let ((e (entity-by-name name)))
        (cond
          (e
            (format 0 "entity ~S: at ~M ~M ~M, level ~A, process ~A~%" name
                    (-> e trans x) (-> e trans y) (-> e trans z)
                    (if (-> e extra level) (-> e extra level name) #f)
                    (if (-> e extra process) (-> (-> e extra process) type) #f)
                    )
            )
          (else
            (format 0 "entity ~S: not found (its level is probably not loaded)~%" name)
            )
          )
        e
        )
      )

    (defun find-lid ()
      (find-process "lid")
      (find-entity "vol-stone-lid-1")
      0
      )

    (defun goto-entity ((name string))
      (let ((e (entity-by-name name)))
        (cond
          (e
            (let ((bot (as-type (blast-bot-find) process-drawable)))
              (cond
                (bot
                  (vector-copy! (-> bot root trans) (-> e trans))
                  (+! (-> bot root trans y) 40960.0)
                  (format 0 "goto-entity: moved the blast bot to ~S~%" name)
                  )
                (*target*
                  (let ((pos (new 'stack-no-clear 'vector)))
                    (vector-copy! pos (-> e trans))
                    (+! (-> pos y) 40960.0)
                    (move-to-point! (-> *target* control) pos)
                    )
                  (format 0 "goto-entity: moved Jak to ~S~%" name)
                  )
                )
              )
            )
          (else
            (format 0 "goto-entity: ~S not found~%" name)
            )
          )
        0
        )
      )

    (defun runs-every-frame ()
      ;; (increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc

      ;; Sample code to turn jak pink whenever he's doing the jetboard hover glitch
      ;; (when *target* 
      ;;   (if (board-hovering?)
      ;;     (draw-pink *target*)
      ;;     (draw-normal *target*)
      ;;     )
      ;;   )

      (if *show-input-display* 
        (input-display-on)
        (input-display-off)
        )

      (when (and *target* (cpad-hold? 0 l1) (cpad-pressed? 0 r3))
        (spawn-my-bombbot)
        )

      ;; L1 + Triangle: remove the bot and put Jak back to normal (blast-bot-despawn-update finishes it over a few frames)
      (when (and *target* (cpad-hold? 0 l1) (cpad-pressed? 0 triangle))
        ;; dismissed on purpose: no auto-spawn (new Jak, mech exit, retries) until L1 + R3 summons the bot again
        (set! *blast-bot-dismissed* #t)
        (set! *blast-bot-spawn-pending* #f)
        (set! *blast-bot-spawn-check* 0)
        (set! *blast-bot-mech-resume* #f)
        (despawn-my-bombbot)
        )
      (blast-bot-despawn-update)
      (blast-bot-fail-watch)

      (blast-bot-mech-watch)
      (blast-bot-spawn-watch)

      (when *debug-segment*
        (orb-placer-maintenance)
        )
      
      (none)
      )

